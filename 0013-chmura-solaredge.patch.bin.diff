+void WebApiFusionClass::onSeCloudPage(AsyncWebServerRequest* request)
+{
+    if (!WebApi.checkCredentials(request)) return;
+    request->send(200, "text/html; charset=utf-8", SECLOUD_PAGE_HTML);
+}
+
+void WebApiFusionClass::onSeCloudGet(AsyncWebServerRequest* request)
+{
+    if (!WebApi.checkCredentials(request)) return;
+    AsyncJsonResponse* response = new AsyncJsonResponse();
+    SolarEdgeCloud.toJson(response->getRoot());
+    WebApi.sendJsonResponse(request, response, __FUNCTION__, __LINE__);
+}
+
+void WebApiFusionClass::onSeCloudPost(AsyncWebServerRequest* request)
+{
+    if (!WebApi.checkCredentials(request)) return;
+    AsyncJsonResponse* response = new AsyncJsonResponse();
+    JsonDocument root;
+    if (!WebApi.parseRequestData(request, response, root)) return;
+    SeCloudConfig c = SolarEdgeCloud.getConfig();
+    c.enabled = root["enabled"] | c.enabled;
+    if (root["site"].is<const char*>()) c.siteId = root["site"].as<String>();
+    if (root["user"].is<const char*>()) c.user = root["user"].as<String>();
+    const String pass = root["password"] | "";
+    const bool keep = pass.isEmpty();
+    if (!keep) c.password = pass;
+    c.interval = root["interval"] | c.interval;
+    reply(request, response, SolarEdgeCloud.setConfig(c, keep), "Settings saved!", "Failed to save settings!");
+}
+
+void WebApiFusionClass::onSeCloudRefresh(AsyncWebServerRequest* request)
+{
+    if (!WebApi.checkCredentials(request)) return;
+    SolarEdgeCloud.requestRefresh();
+    reply(request, new AsyncJsonResponse(), true, "Queued", "");
+}
