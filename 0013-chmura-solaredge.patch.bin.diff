+// ---------------------------------------------------------------- data
+static void buildFilter(JsonObject f, int depth)
+{
+    f["type"] = true;
+    f["name"] = true;
+    f["serial"] = true;
+    f["uuid"] = true;
+    f["properties"]["status"] = true;
+    f["properties"]["identifier"] = true;
+    if (depth > 0) buildFilter(f["children"].add<JsonObject>(), depth - 1);
+}
+
+struct WalkCtx {
+    String inverter, invName, string;
+    std::vector<SeCloudOptimizer>* out;
+    String firstInverter, firstInvName;
+};
+
+static void walk(JsonObjectConst n, WalkCtx& w)
+{
+    String type = n["type"] | "";
+    type.toUpperCase();
+    WalkCtx saved = w;
+    if (type == "INVERTER") {
+        w.inverter = n["serial"] | "";
+        w.invName = n["name"] | "";
+        if (w.firstInverter.isEmpty()) {
+            w.firstInverter = w.inverter;
+            w.firstInvName = w.invName;
+        }
+    } else if (type == "STRING") {
+        w.string = n["name"] | "";
+    } else if (type == "OPTIMIZER") {
+        SeCloudOptimizer o;
+        o.serial = n["serial"] | "";
+        if (o.serial.isEmpty()) o.serial = n["properties"]["identifier"] | "";
+        o.name = n["name"] | "";
+        if (o.name.isEmpty()) o.name = o.serial;
+        o.string = w.string;
+        o.inverter = w.inverter;
+        String s = n["properties"]["status"] | "";
+        s.toLowerCase();
+        o.status = s;
+        if (o.serial.length() && w.out->size() < 80) w.out->push_back(o);
+    }
+    for (JsonObjectConst c : n["children"].as<JsonArrayConst>()) walk(c, w);
+    const String fi = w.firstInverter, fn = w.firstInvName;
+    w = saved;
+    w.firstInverter = fi;
+    w.firstInvName = fn;
+}
+
+bool SolarEdgeCloudClass::fetchLayout()
+{
+    const String site = getConfig().siteId;
+    String body;
+    int st;
+    if (!api("GET", "/services/layout/logical/generic/v2/site/" + site + "?include-optimizers=true", "", body, st)) {
+        setError(String("Układ instalacji: HTTP ") + st + (st == 403 || st == 404 ? " – sprawdź ID instalacji" : ""));
+        return false;
+    }
+    JsonDocument filter;
+    buildFilter(filter.to<JsonObject>(), 9);
+    buildFilter(filter["siteStructure"].to<JsonObject>(), 9); // either wrapped or not
+    JsonDocument d;
+    if (deserializeJson(d, body, DeserializationOption::Filter(filter))) {
+        setError("Układ instalacji: niepoprawna odpowiedź");
+        return false;
+    }
+    body = String();
+    std::vector<SeCloudOptimizer> opts;
+    WalkCtx w;
+    w.out = &opts;
+    JsonObjectConst root = d["siteStructure"].is<JsonObjectConst>() ? d["siteStructure"].as<JsonObjectConst>() : d.as<JsonObjectConst>();
+    walk(root, w);
+
+    String info;
+    String installDate;
+    float peak = NAN;
+    if (api("GET", "/services/layout/information/site/" + site, "", info, st)) {
+        JsonDocument di;
+        if (!deserializeJson(di, info)) {
+            installDate = di["installationDate"] | "";
+            if (installDate.length() > 10) installDate = installDate.substring(0, 10);
+            if (!di["peakPower"].isNull()) peak = di["peakPower"].as<float>();
+        }
+    }
+
+    std::lock_guard<std::mutex> lock(_mutex);
+    // keep last values of optimizers that are still there
+    for (auto& o : opts) {
+        for (auto& p : _data.optimizers) {
+            if (p.serial == o.serial) {
+                o.p = p.p; o.u = p.u; o.i = p.i; o.uOpt = p.uOpt; o.temp = p.temp; o.todayWh = p.todayWh;
+                o.lastMeas = p.lastMeas; o.panel = p.panel; o.stale = p.stale;
+            }
+        }
+    }
+    _data.optimizers = std::move(opts);
+    _data.inverterSerial = w.firstInverter;
+    _data.inverterName = w.firstInvName;
+    if (installDate.length()) _data.installDate = installDate;
+    if (!isnan(peak)) _data.peakKw = peak;
+    _haveLayout = true;
+    _layoutMs = millis();
+    ESP_LOGI(TAG, "layout: %u optimizers", (unsigned)_data.optimizers.size());
+    return true;
+}
+
+bool SolarEdgeCloudClass::fetchLive()
+{
+    std::vector<String> serials;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        for (auto& o : _data.optimizers) serials.push_back(o.serial);
+    }
+    if (serials.empty()) return true;
+    JsonDocument req;
+    for (auto& s : serials) req.add(s);
+    String body, out;
+    serializeJson(req, body);
+    int st;
+    if (!api("POST", "/services/layout/information/optimizers", body, out, st)) {
+        setError(String("Dane optymalizatorów: HTTP ") + st);
+        return false;
+    }
+    JsonDocument filter;
+    JsonObject lf = filter["serialToLiveData"]["*"].to<JsonObject>();
+    for (const char* k : { "power_W", "current_A", "voltage_V", "optimizerVoltage_V", "lastMeasurement" }) lf[k] = true;
+    JsonObject bf = filter["basicInformationList"][0].to<JsonObject>();
+    bf["serial"] = true;
+    bf["description"] = true;
+    bf["modules"][0]["manufacturer"] = true;
+    bf["modules"][0]["model"] = true;
+    JsonDocument d;
+    if (deserializeJson(d, out, DeserializationOption::Filter(filter))) {
+        setError("Dane optymalizatorów: niepoprawna odpowiedź");
+        return false;
+    }
+    const uint32_t now = millis();
+    std::lock_guard<std::mutex> lock(_mutex);
+    float sum = 0;
+    bool any = false;
+    JsonObjectConst live = d["serialToLiveData"];
+    for (auto& o : _data.optimizers) {
+        JsonObjectConst l = live[o.serial];
+        if (!l.isNull()) {
+            auto num = [](JsonVariantConst v) { return v.isNull() ? NAN : v.as<float>(); };
+            o.p = num(l["power_W"]);
+            o.i = num(l["current_A"]);
+            o.u = num(l["voltage_V"]);
+            o.uOpt = num(l["optimizerVoltage_V"]);
+            o.lastMeas = l["lastMeasurement"].is<const char*>() ? l["lastMeasurement"].as<String>()
+                                                               : (l["lastMeasurement"].isNull() ? String() : String(l["lastMeasurement"].as<double>(), 0));
+            // stale = the portal shows the same measurement for more than an hour (night)
+            bool found = false;
+            for (auto& s : _seen) {
+                if (s.first == o.serial) {
+                    found = true;
+                    if (s.second.meas != o.lastMeas) s.second = { o.lastMeas, now };
+                    o.stale = now - s.second.sinceMs > 3600000UL;
+                }
+            }
+            if (!found) {
+                _seen.push_back({ o.serial, { o.lastMeas, now } });
+                o.stale = false;
+            }
+        }
+        for (JsonObjectConst b : d["basicInformationList"].as<JsonArrayConst>()) {
+            if (o.serial != (b["serial"] | "")) continue;
+            String desc = b["description"] | "";
+            if (desc.isEmpty()) {
+                desc = String(b["modules"][0]["manufacturer"] | "") + " " + String(b["modules"][0]["model"] | "");
+                desc.trim();
+            }
+            o.panel = desc;
+        }
+        if (!isnan(o.p)) {
+            any = true;
+            if (!o.stale) sum += o.p;
+        }
+    }
+    _data.powerW = any ? sum : NAN;
+    return true;
+}
+
+bool SolarEdgeCloudClass::fetchByInverter()
+{
+    String inv;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        inv = _data.inverterSerial;
+    }
+    struct tm t;
+    if (inv.isEmpty() || !getLocalTime(&t, 5)) return true;
+    const String today = isoDate(t);
+    String out;
+    int st;
+    const String path = "/services/layout/energy/site/" + getConfig().siteId + "/by-inverter?start-date=" + today + "&end-date=" + today
+        + "&inverter-serials=" + urlEnc(inv) + "&include-max-temperature=true";
+    if (!api("GET", path, "", out, st)) return false; // optional data
+    JsonDocument filter;
+    JsonObject of = filter["inverters"][0]["optimizers"][0].to<JsonObject>();
+    of["serial"] = true;
+    of["energy"]["value"] = true;
+    of["temperature"]["temperature"] = true;
+    of["temperature"]["temperatureUnit"] = true;
+    JsonDocument d;
+    if (deserializeJson(d, out, DeserializationOption::Filter(filter))) return false;
+    std::lock_guard<std::mutex> lock(_mutex);
+    for (JsonObjectConst ib : d["inverters"].as<JsonArrayConst>()) {
+        for (JsonObjectConst ob : ib["optimizers"].as<JsonArrayConst>()) {
+            const String s = ob["serial"] | "";
+            for (auto& o : _data.optimizers) {
+                if (o.serial != s) continue;
+                if (!ob["energy"]["value"].isNull()) o.todayWh = ob["energy"]["value"].as<float>();
+                if (!ob["temperature"]["temperature"].isNull()) {
+                    float tc = ob["temperature"]["temperature"].as<float>();
+                    String u = ob["temperature"]["temperatureUnit"] | "CELSIUS";
+                    if (u.startsWith("F")) tc = (tc - 32.0f) * 5.0f / 9.0f;
+                    o.temp = tc;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+float SolarEdgeCloudClass::dashboardWh(const String& start, const String& end, const char* unit)
+{
+    String out;
+    int st;
+    const String path = "/services/dashboard/energy/sites/" + getConfig().siteId + "?start-date=" + start + "&end-date=" + end
+        + "&chart-time-unit=" + unit + "&measurement-types=production";
+    if (!api("GET", path, "", out, st)) return NAN;
+    JsonDocument filter;
+    filter["summary"]["production"] = true;
+    JsonDocument d;
+    if (deserializeJson(d, out, DeserializationOption::Filter(filter))) return NAN;
+    JsonVariantConst p = d["summary"]["production"];
+    return p.isNull() ? NAN : p.as<float>();
+}
+
+bool SolarEdgeCloudClass::fetchProduction()
+{
+    struct tm t;
+    if (!getLocalTime(&t, 5) || t.tm_year < (2024 - 1900)) return false;
+    const String today = isoDate(t);
+    char b[11];
+    strftime(b, sizeof(b), "%Y-%m-01", &t);
+    const String month = b;
+    strftime(b, sizeof(b), "%Y-01-01", &t);
+    const String year = b;
+    String install;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        install = _data.installDate;
+    }
+    if (install.isEmpty()) install = "2010-01-01";
+
+    const float d = dashboardWh(today, today, "days");
+    const float m = dashboardWh(month, today, "days");
+    const float y = dashboardWh(year, today, "months");
+    const float tot = dashboardWh(install, today, "years");
+    if (isnan(d) && isnan(tot)) {
+        setError("Produkcja: brak danych z portalu");
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(_mutex);
+    _data.todayWh = d;
+    _data.monthWh = m;
+    _data.yearWh = y;
+    if (!isnan(tot)) _data.totalWh = tot;
+    return true;
+}
+
+bool SolarEdgeCloudClass::cycle()
+{
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        _state = "pobieranie";
+    }
+    if (!_haveLayout || millis() - _layoutMs > 2 * 3600000UL) {
+        if (!fetchLayout()) return false;
+    }
+    const bool live = fetchLive();
+    fetchByInverter();
+    const bool prod = fetchProduction();
+    if (!live && !prod) return false;
+    std::lock_guard<std::mutex> lock(_mutex);
+    _data.valid = true;
+    _data.lastOkMs = millis();
+    _data.lastOkEpoch = time(nullptr);
+    _state = "połączono";
+    _error = "";
+    return true;
+}
+
+// ---------------------------------------------------------------- task
+void SolarEdgeCloudClass::init()
+{
+    load();
+    _state = _cfg.enabled ? "oczekuje" : "wyłączone";
+    if (xTaskCreatePinnedToCore(taskEntry, "secloud", 12288, this, 1, nullptr, 0) != pdPASS) {
+        ESP_LOGE(TAG, "task not started");
+    }
+}
+
+void SolarEdgeCloudClass::taskEntry(void* arg)
+{
+    static_cast<SolarEdgeCloudClass*>(arg)->taskLoop();
+}
+
+void SolarEdgeCloudClass::taskLoop()
+{
+    vTaskDelay(pdMS_TO_TICKS(60000)); // let network and NTP come up
+    uint32_t last = 0, backoff = 0;
+    bool first = true;
+    for (;;) {
+        const SeCloudConfig c = getConfig();
+        if (_cfgChanged) {
+            _cfgChanged = false;
+            backoff = 0;
+        }
+        const bool due = first || _refresh || millis() - last >= c.interval * 60000UL + backoff;
+        struct tm t;
+        const bool online = getLocalTime(&t, 5) && t.tm_year >= (2024 - 1900);
+        if (c.enabled && c.siteId.length() && c.user.length() && online && due) {
+            _refresh = false;
+            first = false;
+            last = millis();
+            if (cycle()) {
+                backoff = 0;
+            } else {
+                // failed logins: wait longer, the portal blocks repeated attempts
+                backoff = min<uint32_t>(backoff ? backoff * 2 : 5 * 60000UL, 6 * 3600000UL);
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(2000));
+    }
+}
+
+// ---------------------------------------------------------------- output
+bool SolarEdgeCloudClass::fill(SolarEdgeData& d)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    if (!_cfg.enabled || !_data.valid) return false;
+    if (millis() - _data.lastOkMs > 3UL * _cfg.interval * 60000UL + 600000UL) return false; // too old
+    d.valid = true;
+    d.lastUpdateMs = _data.lastOkMs;
+    d.manufacturer = "SolarEdge";
+    d.model = "dane z chmury SolarEdge";
+    d.serial = _data.inverterSerial;
+    const float p = isnan(_data.powerW) ? 0.0f : _data.powerW;
+    d.acPower = p;
+    d.dcPower = p;
+    if (!isnan(_data.totalWh)) d.energyTotal = _data.totalWh;
+    d.status = p > 1.0f ? 4 : 2; // MPPT / sleeping
+    d.lastError = "";
+    return true;
+}
+
+void SolarEdgeCloudClass::toJson(JsonVariant root)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    root["enabled"] = _cfg.enabled;
+    root["site"] = _cfg.siteId;
+    root["user"] = _cfg.user;
+    root["has_password"] = _cfg.password.length() > 0;
+    root["interval"] = _cfg.interval;
+    root["state"] = _state;
+    root["error"] = _error;
+    root["requests"] = _requests;
+    root["logins"] = _logins;
+    root["valid"] = _data.valid;
+    root["last_ok"] = (uint32_t)_data.lastOkEpoch;
+    root["age_s"] = _data.valid ? (millis() - _data.lastOkMs) / 1000 : 0;
+    root["inverter"] = _data.inverterSerial;
+    root["inverter_name"] = _data.inverterName;
+    root["install_date"] = _data.installDate;
+    auto num = [](auto v, float f) {
+        if (isnan(f)) v.set(nullptr); else v.set(f);
+    };
+    num(root["peak_kw"], _data.peakKw);
+    num(root["power"], _data.powerW);
+    num(root["today_wh"], _data.todayWh);
+    num(root["month_wh"], _data.monthWh);
+    num(root["year_wh"], _data.yearWh);
+    num(root["total_wh"], _data.totalWh);
+    auto arr = root["optimizers"].to<JsonArray>();
+    for (auto& o : _data.optimizers) {
+        auto j = arr.add<JsonObject>();
+        j["serial"] = o.serial;
+        j["name"] = o.name;
+        j["string"] = o.string;
+        j["status"] = o.status;
+        j["panel"] = o.panel;
+        num(j["p"], o.p);
+        num(j["u"], o.u);
+        num(j["i"], o.i);
+        num(j["uo"], o.uOpt);
+        num(j["t"], o.temp);
+        num(j["wh"], o.todayWh);
+        j["last"] = o.lastMeas;
+        j["stale"] = o.stale;
+    }
+}
