+<style>
+:root{--bg:#f4f6f8;--card:#fff;--tx:#1d2733;--mu:#6b7785;--bd:#e3e7ec;--ok:#1f9d55;--warn:#b7791f;--err:#c53030;--off:#5a6b7d;--acc:#2b6cb0;--in:#fff}
