@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * SolarEdge cloud (monitoring portal "SolarEdge One"): per-optimizer data and
+ * site production, read the same way the web portal does it.
+ *
+ *  - login: OAuth 2 authorization code + PKCE on login.solaredge.com with the
+ *    portal user's e-mail and password (no two-factor login supported);
+ *    the refresh token is kept, so the password is only needed again when it
+ *    expires
+ *  - data: monitoring.solaredge.com/services/... (Bearer token)
+ *      layout/logical/generic/v2/site/<id>     inverters, strings, optimizers
+ *      layout/information/optimizers           live U, I, P per optimizer
+ *      layout/energy/site/<id>/by-inverter     today per optimizer, temperature
+ *      dashboard/energy/sites/<id>             production today/month/year/total
+ *
+ * Unofficial interface (same as the Home Assistant integration
+ * "solaredgeoptimizers"); the portal refreshes every 15 minutes.
+ * When the local Modbus connection to the inverter gives no data, the cloud
+ * values are used for the SolarEdge part of the dashboard (SolarEdge.getData()).
+ */
+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <mutex>
+#include <vector>
+
+struct SolarEdgeData;
+
+struct SeCloudConfig {
+    bool enabled = false;
+    String siteId;
+    String user;
+    String password;
+    uint16_t interval = 15; // minutes
+};
+
+struct SeCloudOptimizer {
+    String serial, name, string, inverter, status, panel;
+    float p = NAN, u = NAN, i = NAN, uOpt = NAN, temp = NAN, todayWh = NAN;
+    String lastMeas;
+    bool stale = false; // no new measurement for more than an hour
+};
+
+struct SeCloudData {
+    bool valid = false;
+    uint32_t lastOkMs = 0;
+    time_t lastOkEpoch = 0;
+    String inverterSerial, inverterName, installDate;
+    float peakKw = NAN;
+    float powerW = NAN;     // sum of optimizer power (last portal values)
+    float todayWh = NAN, monthWh = NAN, yearWh = NAN, totalWh = NAN;
+    std::vector<SeCloudOptimizer> optimizers;
+};
+
+class SolarEdgeCloudClass {
+public:
+    void init();
+    SeCloudConfig getConfig();
+    bool setConfig(const SeCloudConfig& c, bool keepPassword);
+    void requestRefresh() { _refresh = true; }
+    void toJson(JsonVariant root);
+
+    // fills SolarEdge data from the cloud if it is fresh enough; false if not
+    bool fill(SolarEdgeData& d);
+
+private:
+    static void taskEntry(void* arg);
+    void taskLoop();
+    bool cycle();
+    bool ensureToken();
+    bool login();
+    bool refreshToken();
+    bool api(const char* method, const String& path, const String& body, String& out, int& status);
+    bool fetchLayout();
+    bool fetchLive();
+    bool fetchByInverter();
+    bool fetchProduction();
+    float dashboardWh(const String& start, const String& end, const char* unit);
+    void setError(const String& e);
+    void load();
+    bool save();
+    void saveToken();
+
+    std::mutex _mutex;
+    SeCloudConfig _cfg;
+    SeCloudData _data;
+    String _state = "wyłączone";
+    String _error;
+    String _access, _refreshTok;
+    uint32_t _accessUntil = 0;
+    uint32_t _layoutMs = 0;
+    bool _haveLayout = false;
+    volatile bool _refresh = false;
+    volatile bool _cfgChanged = false;
+    uint32_t _requests = 0, _logins = 0;
+    struct Seen { String meas; uint32_t sinceMs; };
+    std::vector<std::pair<String, Seen>> _seen; // serial -> last measurement stamp
+};
+
+extern SolarEdgeCloudClass SolarEdgeCloud;
