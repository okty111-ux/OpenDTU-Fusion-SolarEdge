+// ---------------------------------------------------------------- OAuth
+bool SolarEdgeCloudClass::login()
+{
+    SeCloudConfig cfg = getConfig();
+    if (cfg.user.isEmpty() || cfg.password.isEmpty()) {
+        setError("Brak e-maila lub hasła do portalu SolarEdge");
+        return false;
+    }
+    _logins++;
+    // PKCE
+    uint8_t rnd[32];
+    esp_fill_random(rnd, sizeof(rnd));
+    const String verifier = b64url(rnd, sizeof(rnd));
+    uint8_t dig[32];
+    mbedtls_sha256_context sh;
+    mbedtls_sha256_init(&sh);
+    mbedtls_sha256_starts(&sh, 0);
+    mbedtls_sha256_update(&sh, reinterpret_cast<const uint8_t*>(verifier.c_str()), verifier.length());
+    mbedtls_sha256_finish(&sh, dig);
+    mbedtls_sha256_free(&sh);
+    const String challenge = b64url(dig, sizeof(dig));
+
+    const String params = String("lang=en&response_type=code&client_id=") + CLIENT_ID
+        + "&scope=" + urlEnc("email openid") + "&redirect_uri=" + urlEnc(CALLBACK)
+        + "&code_challenge_method=S256&code_challenge=" + challenge;
+    const String loginUrl = String(LOGIN_BASE) + "/login?" + params;
+
+    std::map<String, String> jar;
+    HttpCtx ctx;
+    ctx.jar = &jar;
+    // 1. login page (hidden fields + cookies)
+    String url = loginUrl;
+    int st = 0;
+    for (int hop = 0; hop < 5; hop++) {
+        st = httpDo(HTTP_METHOD_GET, url, "", nullptr, { { "Accept", "text/html" } }, ctx);
+        if (st >= 300 && st < 400 && ctx.location.length()) {
+            url = absUrl(ctx.location, LOGIN_BASE);
+            continue;
+        }
+        break;
+    }
+    if (st != 200) {
+        setError(String("Logowanie: strona logowania niedostępna (HTTP ") + st + ")");
+        return false;
+    }
+    auto inputs = formInputs(ctx.body);
+    bool hasEmail = false, hasUser = false;
+    String form;
+    for (auto& kv : inputs) {
+        if (kv.first == "email") { hasEmail = true; continue; }
+        if (kv.first == "username") { hasUser = true; continue; }
+        if (kv.first == "password") continue;
+        if (form.length()) form += "&";
+        form += urlEnc(kv.first) + "=" + urlEnc(kv.second);
+    }
+    auto add = [&](const char* k, const String& v) {
+        if (form.length()) form += "&";
+        form += String(k) + "=" + urlEnc(v);
+    };
+    if (hasEmail) add("email", cfg.user);
+    if (hasUser || !hasEmail) add("username", cfg.user);
+    add("password", cfg.password);
+
+    // 2. credentials -> redirect with ?code=
+    st = httpDo(HTTP_METHOD_POST, loginUrl, form, "application/x-www-form-urlencoded",
+        { { "Origin", LOGIN_BASE }, { "Referer", url }, { "Accept", "text/html" } }, ctx);
+    String code;
+    for (int hop = 0; hop < 6; hop++) {
+        if (ctx.location.indexOf("/mfe/auth/callback") >= 0) {
+            code = queryParam(ctx.location, "code");
+            break;
+        }
+        if ((st >= 300 && st < 400) || (st == 204 && ctx.location.length())) {
+            const String next = absUrl(ctx.location, LOGIN_BASE);
+            if (!next.startsWith(LOGIN_BASE)) break;
+            st = httpDo(HTTP_METHOD_GET, next, "", nullptr, { { "Accept", "text/html" } }, ctx);
+            continue;
+        }
+        break;
+    }
+    if (code.isEmpty()) {
+        const bool mfa = ctx.body.indexOf("mfa") >= 0 || ctx.body.indexOf("verification") >= 0 || ctx.body.indexOf("totp") >= 0;
+        setError(mfa ? String("Logowanie: portal wymaga kodu weryfikacyjnego (2FA) – wyłącz weryfikację dwuetapową")
+                     : String("Logowanie nieudane – sprawdź e-mail i hasło (HTTP ") + st + ")");
+        return false;
+    }
+
+    // 3. code -> tokens
+    const String tokBody = String("grant_type=authorization_code&code=") + urlEnc(code) + "&client_id=" + CLIENT_ID
+        + "&redirect_uri=" + urlEnc(CALLBACK) + "&code_verifier=" + verifier;
+    HttpCtx tctx;
+    st = httpDo(HTTP_METHOD_POST, String(LOGIN_BASE) + "/oauth2/token", tokBody, "application/x-www-form-urlencoded",
+        { { "Origin", MON_BASE }, { "Referer", String(MON_BASE) + "/" }, { "Accept", "*/*" } }, tctx);
+    JsonDocument d;
+    if (st != 200 || deserializeJson(d, tctx.body) || !d["access_token"].is<const char*>()) {
+        setError(String("Logowanie: brak tokenu (HTTP ") + st + ")");
+        return false;
+    }
+    _access = d["access_token"].as<String>();
+    if (d["refresh_token"].is<const char*>()) _refreshTok = d["refresh_token"].as<String>();
+    _accessUntil = millis() + ((uint32_t)(d["expires_in"] | 3600) - 120) * 1000UL;
+    saveToken();
+    ESP_LOGI(TAG, "logged in");
+    return true;
+}
+
+bool SolarEdgeCloudClass::refreshToken()
+{
+    if (_refreshTok.isEmpty()) return false;
+    const String body = String("grant_type=refresh_token&refresh_token=") + urlEnc(_refreshTok) + "&client_id=" + CLIENT_ID;
+    HttpCtx ctx;
+    const int st = httpDo(HTTP_METHOD_POST, String(LOGIN_BASE) + "/oauth2/token", body, "application/x-www-form-urlencoded",
+        { { "Origin", MON_BASE }, { "Referer", String(MON_BASE) + "/" }, { "Accept", "*/*" } }, ctx);
+    JsonDocument d;
+    if (st != 200 || deserializeJson(d, ctx.body) || !d["access_token"].is<const char*>()) {
+        _refreshTok = "";
+        return false;
+    }
+    _access = d["access_token"].as<String>();
+    if (d["refresh_token"].is<const char*>()) {
+        _refreshTok = d["refresh_token"].as<String>();
+        saveToken();
+    }
+    _accessUntil = millis() + ((uint32_t)(d["expires_in"] | 3600) - 120) * 1000UL;
+    return true;
+}
+
+bool SolarEdgeCloudClass::ensureToken()
+{
+    if (_access.length() && (int32_t)(_accessUntil - millis()) > 0) return true;
+    _access = "";
+    if (refreshToken()) return true;
+    return login();
+}
+
+// JSON request to monitoring.solaredge.com/services/...; one retry after 401
+bool SolarEdgeCloudClass::api(const char* method, const String& path, const String& body, String& out, int& status)
+{
+    for (int attempt = 0; attempt < 2; attempt++) {
+        if (!ensureToken()) return false;
+        HttpCtx ctx;
+        const bool post = !strcmp(method, "POST");
+        status = httpDo(post ? HTTP_METHOD_POST : HTTP_METHOD_GET, String(MON_BASE) + path, body, post ? "application/json" : nullptr,
+            { { "Accept", "application/json" }, { "Authorization", "Bearer " + _access }, { "Origin", MON_BASE },
+                { "Referer", String(MON_BASE) + "/" } },
+            ctx);
+        _requests++;
+        if (status == 401 && attempt == 0) {
+            _access = "";
+            continue;
+        }
+        if (status != 200) return false;
+        if (ctx.truncated) {
+            status = -10;
+            return false;
+        }
+        out = std::move(ctx.body);
+        return true;
+    }
+    return false;
+}
