+
+#define SEC_CFG_FILE "/secloud.json"
+#define SEC_TOK_FILE "/secloud_tok.json"
+static const char* LOGIN_BASE = "https://login.solaredge.com";
+static const char* MON_BASE = "https://monitoring.solaredge.com";
+static const char* CLIENT_ID = "ugfnsujd3384sshcjehaphlh3";
+static const char* CALLBACK = "https://monitoring.solaredge.com/mfe/auth/callback";
+static const char* UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Safari/537.36";
+static const size_t MAX_BODY = 256 * 1024;
+
+// ---------------------------------------------------------------- helpers
+static String urlEnc(const String& s)
+{
+    static const char* hex = "0123456789ABCDEF";
+    String o;
+    o.reserve(s.length() * 3);
+    for (size_t k = 0; k < s.length(); k++) {
+        const uint8_t c = s[k];
+        if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') {
+            o += (char)c;
+        } else {
+            o += '%';
+            o += hex[c >> 4];
+            o += hex[c & 15];
+        }
+    }
+    return o;
+}
+
+static String b64url(const uint8_t* d, size_t n)
+{
+    unsigned char out[96];
+    size_t olen = 0;
+    mbedtls_base64_encode(out, sizeof(out), &olen, d, n);
+    String s;
+    for (size_t k = 0; k < olen; k++) {
+        char c = out[k];
+        if (c == '+') c = '-';
+        else if (c == '/') c = '_';
+        else if (c == '=') continue;
+        s += c;
+    }
+    return s;
+}
+
+static String htmlDecode(String v)
+{
+    v.replace("&amp;", "&");
+    v.replace("&quot;", "\"");
+    v.replace("&#x2F;", "/");
+    v.replace("&#47;", "/");
+    v.replace("&#x3D;", "=");
+    v.replace("&#61;", "=");
+    v.replace("&lt;", "<");
+    v.replace("&gt;", ">");
+    return v;
+}
+
+static String attr(const String& tag, const char* name)
+{
+    const String key = String(name) + "=";
+    int p = 0;
+    while ((p = tag.indexOf(key, p)) >= 0) {
+        // must be a whole attribute name
+        if (p > 0 && !isspace((uint8_t)tag[p - 1])) {
+            p += key.length();
+            continue;
+        }
+        int v = p + key.length();
+        if (v >= (int)tag.length()) return String();
+        const char q = tag[v];
+        if (q == '"' || q == '\'') {
+            const int e = tag.indexOf(q, v + 1);
+            return e < 0 ? String() : htmlDecode(tag.substring(v + 1, e));
+        }
+        int e = v;
+        while (e < (int)tag.length() && !isspace((uint8_t)tag[e]) && tag[e] != '>') e++;
+        return htmlDecode(tag.substring(v, e));
+    }
+    return String();
+}
+
+// name/value of all <input> fields of the first <form>
+static std::vector<std::pair<String, String>> formInputs(const String& html)
+{
+    std::vector<std::pair<String, String>> out;
+    int f = html.indexOf("<form");
+    if (f < 0) f = 0;
+    int end = html.indexOf("</form>", f);
+    if (end < 0) end = html.length();
+    int p = f;
+    while ((p = html.indexOf("<input", p)) >= 0 && p < end) {
+        const int e = html.indexOf('>', p);
+        if (e < 0) break;
+        const String tag = html.substring(p, e + 1);
+        const String n = attr(tag, "name");
+        if (n.length()) out.emplace_back(n, attr(tag, "value"));
+        p = e + 1;
+    }
+    return out;
+}
+
+static String queryParam(const String& url, const char* name)
+{
+    const String key = String(name) + "=";
+    int p = url.indexOf("?" + key);
+    if (p < 0) p = url.indexOf("&" + key);
+    if (p < 0) return String();
+    p += key.length() + 1;
+    int e = url.indexOf('&', p);
+    if (e < 0) e = url.length();
+    String v = url.substring(p, e);
+    v.replace("%2F", "/");
+    v.replace("%2B", "+");
+    v.replace("%3D", "=");
+    return v;
+}
+
+static String absUrl(const String& loc, const char* base)
+{
+    if (loc.startsWith("http")) return loc;
+    if (loc.startsWith("/")) return String(base) + loc;
+    return String(base) + "/" + loc;
+}
+
+static String isoDate(const struct tm& t)
+{
+    char b[11];
+    strftime(b, sizeof(b), "%Y-%m-%d", &t);
+    return b;
+}
+
+// ---------------------------------------------------------------- HTTP
+struct HttpCtx {
+    String location;
+    String body;
+    bool truncated = false;
+    std::map<String, String>* jar = nullptr;
+};
+
+static esp_err_t onHttpEvent(esp_http_client_event_t* e)
+{
+    HttpCtx* c = static_cast<HttpCtx*>(e->user_data);
+    if (!c) return ESP_OK;
+    if (e->event_id == HTTP_EVENT_ON_HEADER && e->header_key && e->header_value) {
+        if (!strcasecmp(e->header_key, "Location")) {
+            c->location = e->header_value;
+        } else if (!strcasecmp(e->header_key, "Set-Cookie") && c->jar) {
+            String v = e->header_value;
+            const int sc = v.indexOf(';');
+            if (sc >= 0) v = v.substring(0, sc);
+            const int eq = v.indexOf('=');
+            if (eq > 0) (*c->jar)[v.substring(0, eq)] = v.substring(eq + 1);
+        }
+    } else if (e->event_id == HTTP_EVENT_ON_DATA && e->data_len > 0) {
+        if (c->body.length() + e->data_len <= MAX_BODY) {
+            c->body.concat(static_cast<const char*>(e->data), e->data_len);
+        } else {
+            c->truncated = true;
+        }
+    }
+    return ESP_OK;
+}
+
+static String cookieHeader(const std::map<String, String>& jar)
+{
+    String s;
+    for (auto& kv : jar) {
+        if (s.length()) s += "; ";
+        s += kv.first + "=" + kv.second;
+    }
+    return s;
+}
+
+// one request, no automatic redirects; returns HTTP status or < 0
+static int httpDo(esp_http_client_method_t method, const String& url, const String& body, const char* ctype,
+    const std::vector<std::pair<const char*, String>>& headers, HttpCtx& ctx)
+{
+    esp_http_client_config_t cfg = {};
+    cfg.url = url.c_str();
+    cfg.method = method;
+    cfg.crt_bundle_attach = esp_crt_bundle_attach;
+    cfg.timeout_ms = 20000;
+    cfg.buffer_size = 4096;
+    cfg.buffer_size_tx = 4096; // long OAuth URLs, bearer token
+    cfg.disable_auto_redirect = true;
+    cfg.user_agent = UA;
+    cfg.event_handler = onHttpEvent;
+    cfg.user_data = &ctx;
+    esp_http_client_handle_t c = esp_http_client_init(&cfg);
+    if (!c) return -1;
+    esp_http_client_set_header(c, "Accept-Encoding", "identity");
+    for (auto& h : headers) esp_http_client_set_header(c, h.first, h.second.c_str());
+    if (ctx.jar && !ctx.jar->empty()) esp_http_client_set_header(c, "Cookie", cookieHeader(*ctx.jar).c_str());
+    if (method == HTTP_METHOD_POST) {
+        if (ctype) esp_http_client_set_header(c, "Content-Type", ctype);
+        esp_http_client_set_post_field(c, body.c_str(), body.length());
+    }
+    ctx.location = "";
+    ctx.body = "";
+    ctx.truncated = false;
+    const esp_err_t err = esp_http_client_perform(c);
+    const int status = err == ESP_OK ? esp_http_client_get_status_code(c) : -2;
+    if (err != ESP_OK) ESP_LOGW(TAG, "%s: %s", url.substring(0, 60).c_str(), esp_err_to_name(err));
+    esp_http_client_cleanup(c);
+    return status;
+}
+
+// ---------------------------------------------------------------- config
+void SolarEdgeCloudClass::load()
+{
+    File f = LittleFS.open(SEC_CFG_FILE, "r");
+    if (f) {
+        JsonDocument d;
+        if (!deserializeJson(d, f)) {
+            _cfg.enabled = d["enabled"] | false;
+            _cfg.siteId = d["site"] | "";
+            _cfg.user = d["user"] | "";
+            _cfg.password = d["pass"] | "";
+            _cfg.interval = constrain((int)(d["interval"] | 15), 5, 120);
+        }
+        f.close();
+    }
+    f = LittleFS.open(SEC_TOK_FILE, "r");
+    if (f) {
+        JsonDocument d;
+        if (!deserializeJson(d, f) && _cfg.user == (d["user"] | "")) _refreshTok = d["refresh"] | "";
+        f.close();
+    }
+}
+
+bool SolarEdgeCloudClass::save()
+{
+    JsonDocument d;
+    d["enabled"] = _cfg.enabled;
+    d["site"] = _cfg.siteId;
+    d["user"] = _cfg.user;
+    d["pass"] = _cfg.password;
+    d["interval"] = _cfg.interval;
+    File f = LittleFS.open(SEC_CFG_FILE, "w");
+    if (!f) return false;
+    const bool ok = serializeJson(d, f) > 0;
+    f.close();
+    return ok;
+}
+
+void SolarEdgeCloudClass::saveToken()
+{
+    JsonDocument d;
+    String user;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        user = _cfg.user;
+    }
+    d["user"] = user;
+    d["refresh"] = _refreshTok;
+    File f = LittleFS.open(SEC_TOK_FILE, "w");
+    if (!f) return;
+    serializeJson(d, f);
+    f.close();
+}
+
+SeCloudConfig SolarEdgeCloudClass::getConfig()
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    return _cfg;
+}
+
+bool SolarEdgeCloudClass::setConfig(const SeCloudConfig& c, bool keepPassword)
+{
+    bool ok;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        const String oldPass = _cfg.password;
+        const bool userChanged = c.user != _cfg.user || c.siteId != _cfg.siteId;
+        _cfg = c;
+        if (keepPassword) _cfg.password = oldPass;
+        _cfg.interval = constrain((int)_cfg.interval, 5, 120);
+        _cfg.siteId.trim();
+        _cfg.user.trim();
+        if (userChanged || !keepPassword) {
+            _access = "";
+            _refreshTok = "";
+            _haveLayout = false;
+            _data = SeCloudData();
+        }
+        ok = save();
+        _state = _cfg.enabled ? "oczekuje" : "wyłączone";
+        _error = "";
+    }
+    if (!c.enabled) LittleFS.remove(SEC_TOK_FILE);
+    _cfgChanged = true;
+    _refresh = true;
+    return ok;
+}
