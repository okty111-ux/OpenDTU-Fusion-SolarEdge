+nav a{color:var(--mu);text-decoration:none;margin-left:14px;font-size:14px}
+nav a.act{color:var(--acc);font-weight:600}
+nav a:first-child{margin-left:0}
+main{max-width:980px;margin:0 auto;padding:16px}
+section{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px 16px;margin-bottom:16px;overflow-x:auto}
+section h3{margin:0 0 4px;font-size:16px}
+section .sub{color:var(--mu);font-size:13px;margin:0 0 12px}
+table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
+th,td{padding:7px 8px;border-bottom:1px solid var(--bd);text-align:right;white-space:nowrap}
+th:first-child,td:first-child{text-align:left}
+th{color:var(--mu);font-weight:500;font-size:13px}
+.mu{color:var(--mu)}
+.pill{display:inline-block;padding:1px 8px;border-radius:99px;font-size:12px;background:var(--bd);color:var(--tx)}
+.pill.ok{background:#1f9d5522;color:var(--ok)}.pill.warn{background:#b7791f22;color:var(--warn)}.pill.err{background:#c5303022;color:var(--err)}
+.form{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px 14px;align-items:end}
+label{display:block;font-size:13px;color:var(--mu);margin-bottom:4px}
+input[type=text],input[type=number],input[type=password],select{width:100%;padding:8px 10px;border:1px solid var(--bd);border-radius:8px;background:var(--in);color:var(--tx);font:inherit}
+input:focus,select:focus{outline:2px solid var(--acc);outline-offset:-1px}
+.chk{display:flex;gap:8px;align-items:center;font-size:14px;color:var(--tx);margin:0;padding:8px 0}
+.hint{font-size:12px;color:var(--mu);margin-top:3px}
+button,.btn{display:inline-block;padding:8px 14px;border:1px solid var(--acc);border-radius:8px;background:var(--acc);color:#fff;font:inherit;font-size:14px;cursor:pointer;text-decoration:none}
+button.sec,.btn.sec{background:transparent;color:var(--acc)}
+button.del{background:transparent;color:var(--err);border-color:var(--err);padding:4px 10px;font-size:13px}
+.actions{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap}
+.result{margin-top:12px;padding:10px 12px;border-radius:8px;border:1px solid var(--bd);font-size:14px}
+.result.ok{border-color:var(--ok);background:#1f9d5512}.result.err{border-color:var(--err);background:#c5303012}
+.box{padding:10px 12px;border-radius:8px;background:var(--bg);font-size:13px;color:var(--mu);margin-top:12px}
+#toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);padding:10px 16px;border-radius:8px;background:#1d2733;color:#fff;font-size:14px;display:none}
+footer{color:var(--mu);font-size:12px;text-align:center;padding:8px 0 24px}
+@media(max-width:640px){main{padding:10px}th,td{padding:6px 5px;font-size:13px}nav a{margin-left:10px}}
+.invblk{margin-bottom:14px}.invh{font-weight:600;margin:6px 0 10px}
