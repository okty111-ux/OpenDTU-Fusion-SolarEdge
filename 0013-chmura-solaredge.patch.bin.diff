+<script>
+const $=id=>document.getElementById(id);
+function toast(t,ok=true){const e=$('toast');e.textContent=t;e.style.background=ok?'#1f7a45':'#9b2c2c';e.style.display='block';clearTimeout(e._t);e._t=setTimeout(()=>e.style.display='none',3500);}
+async function get(u){const r=await fetch(u,{cache:'no-store'});if(!r.ok)throw new Error(r.status);return r.json();}
+async function post(u,obj){const r=await fetch(u,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'data='+encodeURIComponent(JSON.stringify(obj||{}))});const j=await r.json().catch(()=>({}));if(!r.ok||j.type==='warning'||j.type==='danger')throw new Error(j.message||r.status);return j;}
+const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
+const nf=(v,d=0)=>v==null?'–':Number(v).toLocaleString('pl-PL',{minimumFractionDigits:d,maximumFractionDigits:d});
+const kwh=wh=>wh==null?'–':(wh>=1e6?nf(wh/1e6,2)+' MWh':nf(wh/1000,2)+' kWh');
+let filled=false;
+function render(c){
+  const s=!c.enabled?['wyłączone','']:(c.state==='połączono'?['połączono','ok']:(c.state==='błąd'?['błąd','err']:[c.state,'']));
+  $('st').innerHTML=`<span class="pill ${s[1]}">${esc(s[0])}</span>`;
+  $('stT').textContent=c.last_ok>1600000000?'ostatnie dane: '+new Date(c.last_ok*1000).toLocaleString('pl-PL'):'';
+  const e=$('err');if(c.enabled&&c.error){e.style.display='';e.textContent=c.error;}else e.style.display='none';
+  $('kv').innerHTML=[['Moc teraz (suma optymalizatorów)',c.power==null?'–':nf(c.power)+' W'],['Dziś',kwh(c.today_wh)],['W tym miesiącu',kwh(c.month_wh)],['W tym roku',kwh(c.year_wh)],['Łącznie',kwh(c.total_wh)],
+    ['Falownik',c.inverter?(c.inverter_name?c.inverter_name+' · ':'')+c.inverter:'–'],['Moc szczytowa',c.peak_kw==null?'–':nf(c.peak_kw,2)+' kWp'],['Data uruchomienia',c.install_date||'–'],['Zapytania / logowania',c.requests+' / '+c.logins]]
+    .map(([a,b])=>`<div><span>${a}</span><b>${esc(b)}</b></div>`).join('');
+  const o=c.optimizers||[];$('optSec').style.display=o.length?'':'none';
+  let lastStr=null,rows='';
+  o.forEach(x=>{if(x.string!==lastStr){lastStr=x.string;rows+=`<tr class="grp"><td colspan="7">${esc(x.string?'String '+x.string:'String')}</td></tr>`;}
+    rows+=`<tr${x.stale?' class="stale"':''}><td><b>${esc(x.name)}</b><div class="mu">${esc(x.serial)}${x.panel?' · '+esc(x.panel):''}${x.status&&x.status!=='active'?' · '+esc(x.status):''}</div></td>`+
+    `<td class="r">${x.p==null?'–':nf(x.p,1)+' W'}</td><td class="r">${x.u==null?'–':nf(x.u,1)+' V'}</td><td class="r">${x.i==null?'–':nf(x.i,2)+' A'}</td><td class="r">${x.uo==null?'–':nf(x.uo,1)+' V'}</td><td class="r">${x.t==null?'–':nf(x.t,0)+' °C'}</td><td class="r">${x.wh==null?'–':nf(x.wh)+' Wh'}</td></tr>`;});
+  $('opt').tBodies[0].innerHTML=rows;
+  if(!filled){$('en').checked=c.enabled;$('site').value=c.site||'';$('user').value=c.user||'';$('iv').value=String(c.interval>=60?60:c.interval>=30?30:15);$('passH').textContent=c.has_password?'zapisane – zostaw puste, aby nie zmieniać':'wymagane';filled=true;}
+}
+async function load(){try{render(await get('/api/fusion/secloud'));}catch(e){}}
+async function save(){
+  const site=$('site').value.trim();
+  if($('en').checked&&!/^\d{3,12}$/.test(site)){toast('Podaj ID instalacji (same cyfry)',false);return;}
+  try{await post('/api/fusion/secloud',{enabled:$('en').checked,site,user:$('user').value.trim(),password:$('pass').value,interval:+$('iv').value});$('pass').value='';filled=false;toast('Zapisano – logowanie w ciągu kilku sekund');setTimeout(load,1500);}catch(e){toast('Błąd: '+e.message,false);}
+}
+async function refresh(){try{await post('/api/fusion/secloud/refresh');toast('Pobieranie…');setTimeout(load,8000);}catch(e){toast('Błąd: '+e.message,false);}}
