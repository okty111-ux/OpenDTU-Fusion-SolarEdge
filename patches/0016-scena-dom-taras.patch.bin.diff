+// house scene: SolarEdge panels on the house roof, Hoymiles panels on the terrace roof next to it
+const SV=(t,a,c='')=>'<'+t+' '+Object.entries(a).map(([k,v])=>k+'="'+v+'"').join(' ')+(c?'>'+c+'</'+t+'>':'/>');
+function pvGrid(A,B,D,n,rows,vals,colMajor){ // parallelogram A=front-left, B=front-right, D=back-left
+  let o='';if(!n)return o;const cols=Math.ceil(n/rows),gx=.06,gy=.08;
+  const P=(u,v)=>[A[0]+u*(B[0]-A[0])+v*(D[0]-A[0]),A[1]+u*(B[1]-A[1])+v*(D[1]-A[1])];
+  const cw=Math.hypot(B[0]-A[0],B[1]-A[1])/cols;
+  for(let k=0;k<n;k++){const c=colMajor?Math.floor(k/rows):k%cols,r=colMajor?k%rows:Math.floor(k/cols);
+    const u0=(c+gx)/cols,u1=(c+1-gx)/cols,v0=(r+gy)/rows,v1=(r+1-gy)/rows;
+    const pts=[P(u0,v0),P(u1,v0),P(u1,v1),P(u0,v1)].map(q=>q[0].toFixed(1)+','+q[1].toFixed(1)).join(' ');
+    const x=vals[k]||{},f=x.wp&&x.w>0?Math.min(1,x.w/x.wp):0,ctr=P((u0+u1)/2,(v0+v1)/2);
+    o+=SV('polygon',{class:'pv',points:pts});
+    if(f>0)o+=SV('polygon',{class:'pvh',points:pts,'fill-opacity':(0.12+f*0.6).toFixed(2)});
+    if(x.w!=null&&cw>=13)o+=SV('text',{class:'pvt',x:ctr[0].toFixed(1),y:(ctr[1]+2.3).toFixed(1),'font-size':cw>=19?7:6},Math.round(x.w));}
+  return o;
+}
+function scene(h){
+  const L=h.live||{},C=h.se_cloud,M=h.mppt||[];
+  let se=[];if(C&&C.opt&&C.opt.length){const wp=C.peak_kw?C.peak_kw*1000/C.opt.length:400;se=C.opt.map(o=>({w:C.valid?(o.st?0:o.p):null,wp}));}
+  const seN=se.length||10;
+  let hm=[];M.forEach(m=>{const ps=(m.panels||[]).length?m.panels:[{p:m.p,wp:0}];ps.forEach(e=>hm.push({w:m.reachable?e.p:null,wp:e.wp}));});
+  const hmN=hm.length||8,hmRows=M.length&&M.every(m=>(m.panels||[]).length===2)?2:(hmN<=4?1:2);
+  const seRows=seN<=8?2:(seN<=15?3:4);
+  const fmt=v=>v==null?'–':w(v);
+  let g='';
+  // house
+  g+=SV('rect',{class:'w1',x:6,y:188,width:108,height:72});
+  g+=SV('polygon',{class:'w2',points:'114,188 158,188 158,260 114,260'});
+  g+=SV('polygon',{class:'w3',points:'114,189 136,160 158,189'});
+  g+=SV('polygon',{class:'rf',points:'0,191 118,191 140,151 22,151'});
+  g+=pvGrid([3,188.5],[115,188.5],[24,153.5],seN,seRows,se,false);
+  g+=SV('line',{class:'eave',x1:-2,y1:191.5,x2:120,y2:191.5});
+  g+=SV('rect',{class:'win',x:16,y:206,width:40,height:54});
+  g+=SV('path',{class:'mul',d:'M29.3 206V260M42.7 206V260M16 225H56'});
+  g+=SV('rect',{class:'box se',x:121,y:207,width:30,height:20,rx:2})+SV('polygon',{class:'sem',points:'131,220 139,213 144,213 136,220'});
+  g+=SV('text',{class:'rlab',x:85,y:204},'SolarEdge');
+  g+=SV('text',{class:'rval',x:85,y:216},fmt(L.se_valid?L.se_w:null));
+  // terrace roof (pergola) attached to the side wall
+  g+=SV('line',{class:'post',x1:166,y1:205,x2:166,y2:260})+SV('line',{class:'post',x1:236,y1:205,x2:236,y2:260});
+  g+=SV('polygon',{class:'rf tr',points:'158,206 240,206 246,190 158,190'});
+  g+=pvGrid([160,204],[238,204],[162,192],hmN,hmRows,hm,true);
+  g+=SV('line',{class:'eave',x1:156,y1:206.5,x2:242,y2:206.5});
+  g+=SV('rect',{class:'box',x:186,y:222,width:22,height:14,rx:2})+SV('rect',{class:'hm',x:186,y:222,width:22,height:3,rx:1});
+  g+=SV('text',{class:'rlab lt',x:201,y:246},'Hoymiles');
+  g+=SV('text',{class:'rval lt',x:201,y:257},fmt(L.hoy_reachable?L.hoy_w:null));
+  $('houseG').innerHTML=g;
+}
