+.app{display:flex;min-height:100vh}
+@media(min-width:960px){.app{background:linear-gradient(to right,var(--side) 236px,var(--bd) 236px,var(--bd) 237px,transparent 237px)}}
+.side{position:sticky;top:0;height:100vh;width:236px;flex:0 0 236px;background:var(--side);border-right:1px solid var(--bd);display:flex;flex-direction:column;padding:18px 12px;z-index:30}
+.brand{display:flex;align-items:center;gap:10px;padding:2px 8px 18px}
+.brand .mk{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#f0a23a,#2f7fd0);display:grid;place-items:center;color:#fff}
+.brand b{display:block;font-size:16px;line-height:1.1}.brand small{color:var(--mu);font-size:12px}
+.side .grp{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--mu);padding:14px 10px 6px}
+.side a.it{display:flex;align-items:center;gap:11px;padding:9px 10px;margin:1px 0;border-radius:9px;color:var(--sideTx);text-decoration:none;font-size:14.5px}
+.side a.it svg{width:19px;height:19px;flex:0 0 19px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;opacity:.85}
+.side a.it:hover{background:var(--bg)}
+.side a.it.act{background:var(--sideAct);color:var(--acc);font-weight:600}
+.side a.it.act svg{opacity:1}
+.side .foot{margin-top:auto;padding:12px 10px 0;border-top:1px solid var(--bd);font-size:12px;color:var(--mu)}
+.content{flex:1;min-width:0}
+.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;padding:10px 18px;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--bd)}
+.top h1{font-size:17px;margin:0;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.top .t{color:var(--mu);font-size:13px;white-space:nowrap}
+.burger{display:none;border:0;background:transparent;color:var(--tx);padding:6px;margin:-6px 0 -6px -6px;border-radius:8px;cursor:pointer}
+.burger svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;display:block}
+.scrim{display:none}
+@media(max-width:959px){
+ .side{position:fixed;left:0;top:0;bottom:0;height:auto;transform:translateX(-102%);transition:transform .22s ease;box-shadow:0 10px 40px #0004}
+ .side.open{transform:none}
+ .scrim{display:block;position:fixed;inset:0;background:#0006;opacity:0;pointer-events:none;transition:opacity .2s;z-index:25}
+ .scrim.on{opacity:1;pointer-events:auto}
+ .burger{display:block}
+ .top{padding:10px 14px}
+}
+@media (prefers-reduced-motion:reduce){.side{transition:none}}
