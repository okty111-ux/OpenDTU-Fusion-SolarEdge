+  const R=fcRoofs(h);
+  box.innerHTML=R.map(x=>`<div class="fcr"><b>${x.name}</b>
+    <label>Moc paneli [kWp]<input type="number" step="0.01" min="0" id="fk_${x.k}" value="${x.kwp?+x.kwp.toFixed(2):''}" placeholder="np. 5.35"></label>
+    <label>Nachylenie [°]<input type="number" step="1" min="0" max="90" id="ft_${x.k}" value="${x.tilt}"></label>
+    <label>Kierunek<select id="fa_${x.k}">${AZ.map(([n,v])=>`<option value="${v}"${v===x.az?' selected':''}>${AZN[n]}</option>`).join('')}</select></label></div>`).join('')+
+    `<div class="mu" style="font-size:12px">Moc: suma mocy paneli na danym dachu (domyślnie z ustawień paneli MPPT i z chmury SolarEdge). Nachylenie: 0° = płasko. Kierunek: w którą stronę świata panele są zwrócone.</div><button class="btn" id="fcSave">Zapisz</button> <span id="fcMsg" class="mu"></span>`;
+  $('fcSave').onclick=async()=>{const fc={};R.forEach(x=>{fc[x.k]={kwp:+$('fk_'+x.k).value||0,tilt:+$('ft_'+x.k).value||0,az:+$('fa_'+x.k).value};});
+    const pref=Object.assign({},FC.pref||{},{fc});
+    try{const r=await fetch('/api/fusion/prefs',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'data='+encodeURIComponent(JSON.stringify(pref))});
+      if(!r.ok)throw new Error(r.status==401?'zaloguj się jako admin':r.status);FC.pref=pref;$('fcMsg').textContent='Zapisano.';box.dataset.done='';forecast(H);}catch(e){$('fcMsg').textContent='Nie zapisano: '+e.message;}};
+}
