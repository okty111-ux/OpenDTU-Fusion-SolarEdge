+// production forecast from the weather forecast (Open-Meteo global tilted irradiance for each roof)
+const FC={pref:null,data:{},exp5:null,busy:false,last:0};
+const AZ=[['S',0],['SW',45],['W',90],['NW',135],['N',180],['NE',-135],['E',-90],['SE',-45]],AZN={S:'południe',SW:'płd.-zach.',W:'zachód',NW:'płn.-zach.',N:'północ',NE:'płn.-wsch.',E:'wschód',SE:'płd.-wsch.'};
+function fcRoofs(h){
+  const P=(FC.pref&&FC.pref.fc)||{},C=h.se_cloud,M=h.mppt||[];
+  let hmW=0;M.forEach(m=>(m.panels||[]).forEach(e=>hmW+=e.wp||0));
+  const seW=C&&C.peak_kw?C.peak_kw*1000:0;
+  const r=(k,name,defW,defTilt)=>{const q=P[k]||{};return {k,name,kwp:q.kwp>0?+q.kwp:defW/1000,tilt:q.tilt!=null?+q.tilt:defTilt,az:q.az!=null?+q.az:0,auto:!(q.kwp>0)};};
+  return [r('se','Dach · SolarEdge',seW,30),r('hm','Taras · Hoymiles',hmW,8)];
+}
+async function fcFetch(h,R){
+  const key=`fz_fc_${h.lat}_${h.lon}_${R.tilt}_${R.az}`;let c=null;try{c=JSON.parse(localStorage.getItem(key)||'null');}catch(e){}
+  if(c&&Date.now()-c.ts<15*60000)return c;
+  const r=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${h.lat}&longitude=${h.lon}&hourly=global_tilted_irradiance,temperature_2m,cloud_cover,snowfall&current=global_tilted_irradiance,cloud_cover,temperature_2m&tilt=${R.tilt}&azimuth=${R.az}&past_days=1&forecast_days=2&timezone=auto`);
+  const j=await r.json();if(!j.hourly)throw new Error('brak danych');
+  const cu=j.current||{},d={ts:Date.now(),t:j.hourly.time,g:j.hourly.global_tilted_irradiance,T:j.hourly.temperature_2m,cc:j.hourly.cloud_cover,sn:j.hourly.snowfall,cur:{g:cu.global_tilted_irradiance,cc:cu.cloud_cover,T:cu.temperature_2m}};
+  try{localStorage.setItem(key,JSON.stringify(d));}catch(e){}return d;
+}
+// expected AC power [W] from irradiance on the panel plane
+const fcP=(kwp,G,T)=>{if(!(G>0)||!(kwp>0))return 0;const tc=(T==null?10:T)+G*0.025;return Math.max(0,Math.min(kwp*950,kwp*1000*G/1000*0.86*(1-0.0037*(tc-25))));};
+function fcSeries(R,d,day){ // hourly values are means of the preceding hour -> centred at hh-0.5
+  const pts=[];d.t.forEach((t,i)=>{if(t.slice(0,10)===day)pts.push([+t.slice(11,13)-0.5,fcP(R.kwp,d.g[i],d.T[i])]);});return pts;
+}
+function fcAt5(pts){const out=new Array(288).fill(null);if(pts.length<2)return out;
+  for(let s=0;s<288;s++){const h=s*5/60;let a=null,b=null;for(const p of pts){if(p[0]<=h)a=p;if(p[0]>=h){b=p;break;}}
+    if(!a)a=[pts[0][0]-1,0];if(!b)b=[pts[pts.length-1][0]+1,0];out[s]=a[0]===b[0]?a[1]:a[1]+(b[1]-a[1])*(h-a[0])/(b[0]-a[0]);}
+  return out;}
+async function forecast(h){
+  const sec=$('prog');if(!sec)return;
+  if(h.lat==null||h.lon==null){sec.style.display='none';return;}
+  if(!FC.pref){FC.pref={};try{const r=await fetch('/api/fusion/prefs');if(r.ok)FC.pref=await r.json();}catch(e){}}
+  const R=fcRoofs(h).filter(x=>x.kwp>0);sec.style.display='';
+  if(!R.length){$('fcG').innerHTML='<div class="mu">Podaj moc paneli (kWp) w ustawieniach poniżej.</div>';fcSettings(h);return;}
+  if(FC.busy)return;FC.busy=true;
+  try{for(const x of R)FC.data[x.k]=await fcFetch(h,x);}catch(e){$('fcSrc').textContent='· brak prognozy ('+e.message+')';FC.busy=false;fcSettings(h);return;}
+  FC.busy=false;
+  const today=h.today.k,tm=new Date(D(today));tm.setDate(tm.getDate()+1);const tomorrow=iso(tm);
+  const PR={};let e5=new Array(288).fill(0);
+  R.forEach(x=>{const d=FC.data[x.k];const t=fcSeries(x,d,today),n=fcSeries(x,d,tomorrow);
+    PR[x.k]={x,today:t.reduce((a,p)=>a+p[1],0)/1000,tomorrow:n.reduce((a,p)=>a+p[1],0)/1000,e5:fcAt5(t)};
+    PR[x.k].e5.forEach((v,i)=>e5[i]+=v||0);});
+  FC.exp5=e5;FC.PR=PR;
+  const nowS=pw[0]&&pw[0].slot!=null?pw[0].slot:null;
+  // production so far vs forecast so far
+  let expSoFar=0;if(nowS!=null)for(let i=0;i<=nowS;i++)expSoFar+=e5[i]*5/60/1000;
+  const prod=sum(h.today),tile=(lab,v,sub,cls='')=>`<div class="fct ${cls}"><span>${lab}</span><b>${v}</b><small>${sub}</small></div>`;
+  const totT=Object.values(PR).reduce((a,q)=>a+q.today,0),totN=Object.values(PR).reduce((a,q)=>a+q.tomorrow,0);
+  const split=k=>Object.values(PR).map(q=>`${q.x.k==='se'?'dach':'taras'} ${kwhS(q[k])}`).join(' · ');
+  $('fcG').innerHTML=tile('Dziś – prognoza',kwhS(totT),split('today'))+
+    tile('Dziś – dotąd',kwhS(prod),expSoFar>0.05?`${Math.round(100*prod/expSoFar)}% prognozy do tej pory`:'','y')+
+    tile('Jutro – prognoza',kwhS(totN),split('tomorrow'))+nowTile(h,PR);
+  $('fcSrc').textContent='· pogoda Open-Meteo';
+  fcWarn(h,PR);fcSettings(h);if(per==='d'&&off===0)drawChart();
+}
+// current weather from the web: what the panels should give right now vs. what they give
+function nowTile(h,PR){
+  let exp=0,cc=null,G=0,any=false;
+  Object.values(PR).forEach(q=>{const c=(FC.data[q.x.k]||{}).cur;if(!c||c.g==null)return;any=true;exp+=fcP(q.x.kwp,c.g,c.T);G=Math.max(G,c.g);if(c.cc!=null)cc=c.cc;});
+  if(!any)return '';
+  const L=h.live||{},act=(L.hoy_reachable?L.hoy_w||0:0)+(L.se_valid?L.se_w||0:0),pct=exp>50?Math.round(100*act/exp):null;
+  return `<div class="fct"><span>Teraz przy obecnej pogodzie</span><b>${w(exp)}</b><small>jest ${w(act)}${pct!=null?' ('+pct+'%)':''} · słońce ${Math.round(G)} W/m²${cc!=null?' · zachmurzenie '+cc+'%':''}</small></div>`;
+}
+function fcWarn(h,per){
+  const w=[],d0=pw[0];if(!d0||d0.slot==null){$('fcWarn').innerHTML='';return;}
+  const s1=d0.slot,s0=Math.max(0,s1-11),hr=String(Math.floor(s1*5/60)).padStart(2,'0');
+  for(const k of Object.keys(per)){const q=per[k],arr=k==='se'?d0.se:d0.hoy;let a=0,e=0,n=0;
+    for(let i=s0;i<=s1;i++){if(arr[i]==null)continue;a+=arr[i];e+=q.e5[i]||0;n++;}
+    if(n<6)continue;a/=n;e/=n;if(e<300||a>=0.45*e)continue;
+    const d=FC.data[k],idx=d.t.findIndex(t=>t.slice(0,13)===h.today.k+'T'+hr),cc=idx>=0?d.cc[idx]:null,T=idx>=0?d.T[idx]:null;
+    let snow=0;if(idx>=0)for(let i=Math.max(0,idx-24);i<=idx;i++)snow+=d.sn[i]||0;
+    const nm=k==='se'?'Dach (SolarEdge)':'Taras (Hoymiles)';
+    if(snow>0.2&&T!=null&&T<3)w.push(`❄️ ${nm}: produkcja ${Math.round(100*a/e)}% oczekiwanej – prawdopodobnie śnieg na panelach.`);
+    else if(cc!=null&&cc<40)w.push(`⚠️ ${nm}: przy prawie bezchmurnym niebie produkcja to tylko ${Math.round(100*a/e)}% oczekiwanej – sprawdź zacienienie, zabrudzenie albo falownik.`);
+  }
+  $('fcWarn').innerHTML=w.map(t=>`<div class="fcw">${t}</div>`).join('');
+}
+function fcSettings(h){
