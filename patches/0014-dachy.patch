+
+void SolarEdgeCloudClass::liveToJson(JsonObject o)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    o["enabled"] = _cfg.enabled;
+    o["valid"] = _data.valid;
+    o["age_s"] = _data.valid ? (millis() - _data.lastOkMs) / 1000 : 0;
+    o["name"] = _data.inverterName;
+    if (!isnan(_data.peakKw)) o["peak_kw"] = _data.peakKw;
+    auto arr = o["opt"].to<JsonArray>();
+    for (auto& x : _data.optimizers) {
+        auto j = arr.add<JsonObject>();
+        j["n"] = x.name;
+        j["s"] = x.string;
+        if (!isnan(x.p)) j["p"] = x.p;
+        if (!isnan(x.u)) j["u"] = x.u;
+        if (!isnan(x.i)) j["i"] = x.i;
+        if (!isnan(x.todayWh)) j["wh"] = x.todayWh;
+        if (!isnan(x.temp)) j["t"] = x.temp;
+        if (x.stale) j["st"] = true;
+        if (x.panel.length()) j["pm"] = x.panel;
+    }
+}
