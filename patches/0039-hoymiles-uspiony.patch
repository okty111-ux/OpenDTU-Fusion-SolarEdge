From 4c99959f5e3f030d8cb578ccce75a01aae692b98 Mon Sep 17 00:00:00 2001
From: Okty <okty@users.noreply.github.com>
Date: Thu, 26 Nov 2026 16:40:47 +0100
Subject: [PATCH] Dashboard: Hoymiles 'produkuje' only when the inverter
 answers and delivers power (not after it went to sleep)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EySGZ7zzCqzbQeGccwYzek
---
 src/EnergyHistory.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/EnergyHistory.cpp b/src/EnergyHistory.cpp
index bebe9bd0..065da14b 100644
--- a/src/EnergyHistory.cpp
+++ b/src/EnergyHistory.cpp
@@ -445,8 +445,12 @@ void EnergyHistoryClass::toJson(JsonVariant root)
     live["hoy_w"] = hoyW;
     live["se_w"] = seW;
     live["total_w"] = hoyW + seW;
-    live["hoy_reachable"] = Datastore.getIsAtLeastOneReachable();
-    live["hoy_producing"] = Datastore.getIsAtLeastOneProducing();
+    const bool hoyReach = Datastore.getIsAtLeastOneReachable();
+    live["hoy_reachable"] = hoyReach;
+    // OpenDTU's "producing" looks at the last AC power received, which stays > 0
+    // after the inverter has gone to sleep in the evening: also require the
+    // inverter to answer and the power counted now to be above zero
+    live["hoy_producing"] = Datastore.getIsAtLeastOneProducing() && hoyReach && hoyW > 0.5f;
     live["se_valid"] = d.valid;
     live["se_status"] = d.status;
     live["se_status_text"] = SolarEdgeClass::statusToString(d.status);
