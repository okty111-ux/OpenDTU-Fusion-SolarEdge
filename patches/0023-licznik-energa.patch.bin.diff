+extern "C" esp_err_t esp_crt_bundle_attach(void* conf);
+
+#undef TAG
+static const char* TAG = "energa";
+
+EnergaMeterClass EnergaMeter;
+
+#define EN_CFG_FILE "/energa.json"
+static const char* BASE = "https://api-mojlicznik.energa-operator.pl/dp";
+static const char* UA = "Energa/3.1.2 (pl.energa-operator.mojlicznik; build:1; iOS 16.6.1) Alamofire/5.6.4";
+static const size_t MAX_BODY = 96 * 1024;
+
+static String urlEnc(const String& s)
+{
+    static const char* hex = "0123456789ABCDEF";
+    String o;
+    for (size_t k = 0; k < s.length(); k++) {
+        const uint8_t c = s[k];
+        if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') {
+            o += (char)c;
+        } else {
+            o += '%';
+            o += hex[c >> 4];
+            o += hex[c & 15];
+        }
+    }
+    return o;
+}
+
+// ---------------------------------------------------------------- HTTP (GET, cookies kept)
+struct EnCtx {
+    String body;
+    bool truncated = false;
+    std::vector<std::pair<String, String>>* jar = nullptr;
+};
+
+static esp_err_t onEvent(esp_http_client_event_t* e)
+{
+    EnCtx* c = static_cast<EnCtx*>(e->user_data);
+    if (!c) return ESP_OK;
+    if (e->event_id == HTTP_EVENT_ON_HEADER && e->header_key && e->header_value && c->jar
+        && !strcasecmp(e->header_key, "Set-Cookie")) {
+        String v = e->header_value;
+        const int sc = v.indexOf(';');
+        if (sc >= 0) v = v.substring(0, sc);
+        const int eq = v.indexOf('=');
+        if (eq > 0) {
+            const String n = v.substring(0, eq), val = v.substring(eq + 1);
+            bool found = false;
+            for (auto& kv : *c->jar) {
+                if (kv.first == n) { kv.second = val; found = true; }
+            }
+            if (!found) c->jar->emplace_back(n, val);
+        }
+    } else if (e->event_id == HTTP_EVENT_ON_DATA && e->data_len > 0) {
+        if (c->body.length() + e->data_len <= MAX_BODY) c->body.concat(static_cast<const char*>(e->data), e->data_len);
+        else c->truncated = true;
+    }
+    return ESP_OK;
+}
+
+bool EnergaMeterClass::get(const String& path, String& out, int& status)
+{
+    String url = String(BASE) + path;
+    if (_token.length()) url += String(path.indexOf('?') >= 0 ? "&" : "?") + "token=" + urlEnc(_token);
+    EnCtx ctx;
+    ctx.jar = &_cookies;
+    esp_http_client_config_t cfg = {};
+    cfg.url = url.c_str();
+    cfg.method = HTTP_METHOD_GET;
+    cfg.crt_bundle_attach = esp_crt_bundle_attach;
+    cfg.timeout_ms = 20000;
+    cfg.buffer_size = 4096;
+    cfg.buffer_size_tx = 2048;
+    cfg.user_agent = UA;
+    cfg.event_handler = onEvent;
+    cfg.user_data = &ctx;
+    esp_http_client_handle_t c = esp_http_client_init(&cfg);
+    if (!c) {
+        status = -1;
+        return false;
+    }
+    esp_http_client_set_header(c, "Accept", "application/json");
+    esp_http_client_set_header(c, "Accept-Language", "pl-PL;q=1.0");
+    esp_http_client_set_header(c, "Accept-Encoding", "identity");
+    String ck;
+    for (auto& kv : _cookies) {
+        if (ck.length()) ck += "; ";
+        ck += kv.first + "=" + kv.second;
+    }
+    if (ck.length()) esp_http_client_set_header(c, "Cookie", ck.c_str());
+    const esp_err_t err = esp_http_client_perform(c);
+    status = err == ESP_OK ? esp_http_client_get_status_code(c) : -2;
+    esp_http_client_cleanup(c);
+    _requests++;
+    if (status != 200 || ctx.truncated) return false;
+    out = std::move(ctx.body);
+    return true;
+}
+
+// ---------------------------------------------------------------- config
+void EnergaMeterClass::load()
+{
+    File f = LittleFS.open(EN_CFG_FILE, "r");
+    if (f) {
+        JsonDocument d;
+        if (!deserializeJson(d, f)) {
+            _cfg.enabled = d["enabled"] | false;
+            _cfg.user = d["user"] | "";
+            _cfg.password = d["pass"] | "";
+            _deviceToken = d["dev"] | "";
+        }
+        f.close();
+    }
+    if (_deviceToken.length() != 64) { // like the app: one random token per installation
+        uint8_t r[32];
+        esp_fill_random(r, sizeof(r));
+        _deviceToken = "";
+        for (uint8_t b : r) {
+            char h[3];
+            snprintf(h, sizeof(h), "%02x", b);
+            _deviceToken += h;
+        }
+        save();
+    }
+}
+
+bool EnergaMeterClass::save()
+{
+    JsonDocument d;
+    d["enabled"] = _cfg.enabled;
+    d["user"] = _cfg.user;
+    d["pass"] = _cfg.password;
+    d["dev"] = _deviceToken;
+    File f = LittleFS.open(EN_CFG_FILE, "w");
+    if (!f) return false;
+    const bool ok = serializeJson(d, f) > 0;
+    f.close();
+    return ok;
+}
+
+EnergaConfig EnergaMeterClass::getConfig()
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    return _cfg;
+}
+
+bool EnergaMeterClass::setConfig(const EnergaConfig& c, bool keepPassword)
+{
+    bool ok;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        const String oldPass = _cfg.password;
+        const bool userChanged = c.user != _cfg.user;
+        _cfg = c;
+        _cfg.user.trim();
+        if (keepPassword) _cfg.password = oldPass;
+        if (userChanged || !keepPassword) {
+            _loggedIn = false;
+            _meterId = "";
+            _backfillLeft = -1;
+        }
+        ok = save();
+        _state = _cfg.enabled ? "oczekuje" : "wyłączone";
+        _error = "";
+    }
+    _cfgChanged = true;
+    _refresh = true;
+    return ok;
+}
+
+void EnergaMeterClass::setError(const String& e)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    _error = e;
+    _state = "błąd";
+    ESP_LOGW(TAG, "%s", e.c_str());
+}
+
+// ---------------------------------------------------------------- API
+bool EnergaMeterClass::login()
+{
+    const EnergaConfig c = getConfig();
+    if (c.user.isEmpty() || c.password.isEmpty()) {
+        setError("Brak e-maila lub hasła do Mój Licznik");
+        return false;
+    }
+    _cookies.clear();
+    _token = "";
+    String out;
+    int st;
+    get("/apihelper/SessionStatus", out, st);
+    const String q = "/apihelper/UserLogin?clientOS=ios&notifyService=APNs&username=" + urlEnc(c.user) + "&password=" + urlEnc(c.password)
+        + "&token=" + _deviceToken;
+    if (!get(q, out, st)) {
+        setError(String("Logowanie do Mój Licznik: HTTP ") + st);
+        return false;
+    }
+    JsonDocument d;
+    if (deserializeJson(d, out) || !(d["success"] | false)) {
+        const String msg = d["error"] | (d["message"] | "");
+        setError("Logowanie nieudane – sprawdź e-mail i hasło" + (msg.length() ? " (" + msg + ")" : String()));
+        return false;
+    }
+    _token = d["token"] | (d["response"]["token"] | "");
+    _loggedIn = true;
+    ESP_LOGI(TAG, "logged in");
+    return true;
+}
+
+bool EnergaMeterClass::fetchMeter()
+{
+    String out;
+    int st;
+    if (!get("/resources/user/data", out, st)) {
+        if (st == 401 || st == 403) _loggedIn = false;
+        setError(String("Dane licznika: HTTP ") + st);
+        return false;
+    }
+    JsonDocument filter;
+    JsonObject mp = filter["response"]["meterPoints"][0].to<JsonObject>();
+    mp["id"] = true;
+    mp["dev"] = true;
+    mp["tariff"] = true;
+    mp["lastMeasurements"][0]["zone"] = true;
+    mp["lastMeasurements"][0]["value"] = true;
+    mp["meterObjects"][0]["obis"] = true;
+    JsonDocument d;
+    if (deserializeJson(d, out, DeserializationOption::Filter(filter))) {
+        setError("Dane licznika: niepoprawna odpowiedź");
+        return false;
+    }
+    JsonObjectConst m = d["response"]["meterPoints"][0];
+    if (m.isNull()) {
+        setError("Na koncie nie ma licznika");
+        return false;
+    }
+    float plus = 0, minus = 0;
+    bool anyP = false, anyM = false;
+    for (JsonObjectConst x : m["lastMeasurements"].as<JsonArrayConst>()) {
+        const String z = x["zone"] | "";
+        const float v = x["value"].as<float>();
+        if (z.indexOf("A+") >= 0) { plus += v; anyP = true; }
+        if (z.indexOf("A-") >= 0) { minus += v; anyM = true; }
+    }
+    String op, om;
+    for (JsonObjectConst o : m["meterObjects"].as<JsonArrayConst>()) {
+        const String ob = o["obis"] | "";
+        if (ob.startsWith("1-0:1.8.0")) op = ob;
+        if (ob.startsWith("1-0:2.8.0")) om = ob;
+    }
+    std::lock_guard<std::mutex> lock(_mutex);
+    if (m["id"].is<const char*>()) {
+        _meterId = m["id"].as<String>();
+    } else {
+        char idb[24];
+        snprintf(idb, sizeof(idb), "%lld", (long long)m["id"].as<double>());
+        _meterId = idb;
+    }
+    _serial = m["dev"] | "";
+    _tariff = m["tariff"] | "";
+    _obisPlus = op.length() ? op : "1-0:1.8.0*255";
+    _obisMinus = om;
+    _totalPlus = anyP ? plus : NAN;
+    _totalMinus = anyM ? minus : NAN;
+    return true;
+}
+
+// one day (local midnight) -> hourly kWh for A+ and A-
+bool EnergaMeterClass::fetchDay(time_t dayStart, EnergaDay& day)
+{
+    struct tm t;
+    localtime_r(&dayStart, &t);
+    char ds[11];
+    strftime(ds, sizeof(ds), "%Y-%m-%d", &t);
+    day.date = ds;
+    for (int i = 0; i < 24; i++) day.hImp[i] = day.hExp[i] = NAN;
+    String id, op, om;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        id = _meterId;
+        op = _obisPlus;
+        om = _obisMinus;
+    }
+    char ms[24];
+    snprintf(ms, sizeof(ms), "%lld", (long long)dayStart * 1000LL);
+    auto chart = [&](const String& obis, float* h, float& total) -> bool {
+        if (obis.isEmpty()) return true;
+        String out;
+        int st;
+        const String q = "/resources/mchart?meterPoint=" + urlEnc(id) + "&type=DAY&meterObject=" + urlEnc(obis) + "&mainChartDate=" + ms;
+        if (!get(q, out, st)) {
+            if (st == 401 || st == 403) _loggedIn = false;
+            return false;
+        }
+        JsonDocument filter;
+        filter["response"]["mainChart"][0]["tm"] = true;
+        filter["response"]["mainChart"][0]["zones"] = true;
+        JsonDocument d;
+        if (deserializeJson(d, out, DeserializationOption::Filter(filter))) return false;
+        bool any = false;
+        total = 0;
+        for (JsonObjectConst p : d["response"]["mainChart"].as<JsonArrayConst>()) {
+            const time_t tm = (time_t)(p["tm"].as<double>() / 1000.0);
+            struct tm lt;
+            localtime_r(&tm, &lt);
+            int hr = lt.tm_hour;
+            float v = 0;
+            bool has = false;
+            for (JsonVariantConst z : p["zones"].as<JsonArrayConst>()) {
+                if (!z.isNull()) { v += z.as<float>(); has = true; }
+            }
+            if (!has || v < 0 || v > 100) continue; // no value yet / implausible
+            if (hr >= 0 && hr < 24) h[hr] = (isnan(h[hr]) ? 0 : h[hr]) + v;
+            total += v;
+            any = true;
+        }
+        if (!any) total = -1;
+        return true;
+    };
+    if (!chart(op, day.hImp, day.imp)) return false;
+    if (!chart(om, day.hExp, day.exp)) return false;
+    return true;
+}
+
+static time_t midnight(int daysBack)
+{
+    time_t now = time(nullptr);
+    struct tm t;
+    localtime_r(&now, &t);
+    t.tm_mday -= daysBack;
+    t.tm_hour = 0;
+    t.tm_min = 0;
+    t.tm_sec = 0;
+    t.tm_isdst = -1;
+    return mktime(&t);
+}
+
+bool EnergaMeterClass::cycle()
+{
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        _state = "pobieranie";
+    }
+    if (!_loggedIn && !login()) return false;
+    if (!fetchMeter()) {
+        if (!_loggedIn && login() && fetchMeter()) {
+        } else {
+            return false;
+        }
+    }
+    EnergaDay td, yd;
+    const bool ok1 = fetchDay(midnight(0), td);
+    const bool ok2 = fetchDay(midnight(1), yd);
+    if (!ok1 && !ok2) {
+        setError("Dane godzinowe: brak odpowiedzi");
+        return false;
+    }
+    if (ok2 && (yd.imp >= 0 || yd.exp >= 0)) EnergyHistory.setGridDay(yd.date.c_str(), yd.imp, yd.exp);
+    if (ok1) EnergyHistory.setGridToday(td.date.c_str(), td.imp, td.exp);
+    std::lock_guard<std::mutex> lock(_mutex);
+    if (ok1) _today = td;
+    if (ok2) _yesterday = yd;
+    if (_backfillLeft < 0) _backfillLeft = 60; // days 2..61 back
+    _lastOk = time(nullptr);
+    _state = "połączono";
+    _error = "";
+    return true;
+}
+
+// ---------------------------------------------------------------- task
+void EnergaMeterClass::init()
+{
+    load();
+    _state = _cfg.enabled ? "oczekuje" : "wyłączone";
+    if (xTaskCreatePinnedToCore(taskEntry, "energa", 10240, this, 1, nullptr, 0) != pdPASS) ESP_LOGE(TAG, "task not started");
+}
+
+void EnergaMeterClass::taskEntry(void* arg) { static_cast<EnergaMeterClass*>(arg)->taskLoop(); }
+
+void EnergaMeterClass::taskLoop()
+{
+    vTaskDelay(pdMS_TO_TICKS(90000));
+    uint32_t last = 0, backoff = 0;
+    bool first = true;
+    for (;;) {
+        const EnergaConfig c = getConfig();
+        if (_cfgChanged) {
+            _cfgChanged = false;
+            backoff = 0;
+        }
+        struct tm t;
+        const bool online = getLocalTime(&t, 5) && t.tm_year >= (2024 - 1900);
+        if (c.enabled && c.user.length() && online) {
+            if (first || _refresh || millis() - last >= 3600000UL + backoff) {
+                _refresh = false;
+                first = false;
+                last = millis();
+                backoff = cycle() ? 0 : min<uint32_t>(backoff ? backoff * 2 : 15 * 60000UL, 6 * 3600000UL);
+            } else if (_backfillLeft > 0 && _loggedIn) { // history of the last 62 days, one day every few seconds
+                const int back = 62 - _backfillLeft;
+                EnergaDay d;
+                if (fetchDay(midnight(back), d) && (d.imp >= 0 || d.exp >= 0)) EnergyHistory.setGridDay(d.date.c_str(), d.imp, d.exp);
+                _backfillLeft--;
+                vTaskDelay(pdMS_TO_TICKS(4000));
+                continue;
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(2000));
+    }
+}
+
+// ---------------------------------------------------------------- output
+void EnergaMeterClass::toJson(JsonVariant root)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    root["enabled"] = _cfg.enabled;
+    root["user"] = _cfg.user;
+    root["has_password"] = _cfg.password.length() > 0;
+    root["state"] = _state;
+    root["error"] = _error;
+    root["requests"] = _requests;
+    root["last_ok"] = (uint32_t)_lastOk;
+    root["serial"] = _serial;
+    root["tariff"] = _tariff;
+    if (!isnan(_totalPlus)) root["total_plus"] = _totalPlus;
+    if (!isnan(_totalMinus)) root["total_minus"] = _totalMinus;
+    root["backfill_left"] = _backfillLeft < 0 ? 0 : _backfillLeft;
+    auto day = [&](const EnergaDay& d, const char* name) {
+        if (d.date.isEmpty()) return;
+        auto o = root[name].to<JsonObject>();
+        o["date"] = d.date;
+        if (d.imp >= 0) o["imp"] = d.imp;
+        if (d.exp >= 0) o["exp"] = d.exp;
+    };
+    day(_today, "today");
+    day(_yesterday, "yesterday");
+}
+
+void EnergaMeterClass::hourlyToJson(JsonObject root)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    root["enabled"] = _cfg.enabled;
+    auto day = [&](const EnergaDay& d, const char* name) {
+        if (d.date.isEmpty()) return;
+        auto o = root[name].to<JsonObject>();
+        o["date"] = d.date;
+        auto a = o["imp"].to<JsonArray>(), b = o["exp"].to<JsonArray>();
+        for (int i = 0; i < 24; i++) {
+            if (isnan(d.hImp[i])) a.add(nullptr); else a.add(serialized(String(d.hImp[i], 3)));
+            if (isnan(d.hExp[i])) b.add(nullptr); else b.add(serialized(String(d.hExp[i], 3)));
+        }
+    };
+    day(_today, "today");
+    day(_yesterday, "yesterday");
+}
