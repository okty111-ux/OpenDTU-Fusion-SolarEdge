+
+// a finished day: replace import/export and correct the month and year sums
+void EnergyHistoryClass::setGridDay(const char* key, float imp, float exp)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    for (auto& d : _days) {
+        if (strcmp(d.key, key) != 0) continue;
+        const float di = imp >= 0 ? imp - (d.imp < 0 ? 0 : d.imp) : 0;
+        const float de = exp >= 0 ? exp - (d.exp < 0 ? 0 : d.exp) : 0;
+        if (fabsf(di) < 0.0005f && fabsf(de) < 0.0005f && (imp < 0 || d.imp >= 0) && (exp < 0 || d.exp >= 0)) return;
+        if (imp >= 0) d.imp = imp;
+        if (exp >= 0) d.exp = exp;
+        auto fix = [&](std::deque<EnergyRecord>& list, size_t n) {
+            for (auto& r : list) {
+                if (strncmp(r.key, key, n) != 0 || strlen(r.key) != n) continue;
+                if (imp >= 0) r.imp = (r.imp < 0 ? 0 : r.imp) + di;
+                if (exp >= 0) r.exp = (r.exp < 0 ? 0 : r.exp) + de;
+            }
+        };
+        fix(_months, 7);
+        fix(_years, 4);
+        _dirty = true;
+        return;
+    }
+}
