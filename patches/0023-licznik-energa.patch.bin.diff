+<section>
+  <h3>Licznik Energa · Mój Licznik</h3>
+  <div class="vrow"><div class="vst" id="st"><span class="pill">–</span></div><div class="mu" id="stT"></div></div>
+  <div id="err" class="result err" style="display:none"></div>
+  <div class="kv" id="kv"></div>
+</section>
+<section>
+  <h3>Ustawienia</h3>
+  <p class="sub">Fusion loguje się do Mój Licznik (Energa Operator) tak jak aplikacja na telefon i pobiera energię pobraną z sieci (A+) i oddaną do sieci (A−) z Twojego licznika – godzina po godzinie. Energa udostępnia te dane z opóźnieniem (zwykle następnego dnia), dlatego trafiają do historii (kolumny Import, Eksport i Zużycie), a nie do bieżącej mocy. Po pierwszym połączeniu Fusion uzupełni ostatnie 62 dni.</p>
+  <div class="form">
+    <div><label class="chk"><input id="en" type="checkbox"> Pobieranie włączone</label></div>
+    <div><label for="user">E-mail (login do Mój Licznik)</label><input id="user" type="text" inputmode="email" maxlength="80" autocomplete="off" spellcheck="false"></div>
+    <div><label for="pass">Hasło do Mój Licznik</label><input id="pass" type="password" maxlength="80" autocomplete="new-password"><div class="hint" id="passH">zostaw puste, aby nie zmieniać</div></div>
+  </div>
+  <div class="actions"><button onclick="save()">Zapisz i połącz</button><button class="sec" onclick="refresh()">Pobierz teraz</button></div>
+  <div class="box">Hasło jest zapisane tylko w pamięci Fusion i nigdy nie jest pokazywane na stronie. To nieoficjalny sposób dostępu (ten sam, którego używa aplikacja Mój Licznik) – jeśli Energa go zmieni, pobieranie może przestać działać. Działa tylko dla liczników Energa Operator.</div>
+</section>
+</main>
+<div id="toast" class="toast"></div>
+<script>
+
+const $=id=>document.getElementById(id);
+function toast(t,ok=true){const e=$('toast');e.textContent=t;e.style.background=ok?'#1f7a45':'#9b2c2c';e.style.display='block';clearTimeout(e._t);e._t=setTimeout(()=>e.style.display='none',3500);}
+async function get(u){const r=await fetch(u,{cache:'no-store'});if(!r.ok)throw new Error(r.status);return r.json();}
+async function post(u,obj){const r=await fetch(u,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'data='+encodeURIComponent(JSON.stringify(obj||{}))});const j=await r.json().catch(()=>({}));if(!r.ok||j.type==='warning'||j.type==='danger')throw new Error(j.message||r.status);return j;}
+const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
+const nf=(v,d=0)=>v==null?'–':Number(v).toLocaleString('pl-PL',{minimumFractionDigits:d,maximumFractionDigits:d});
+const kwh=wh=>wh==null?'–':(wh>=1e6?nf(wh/1e6,2)+' MWh':nf(wh/1000,2)+' kWh');
+let filled=false;
+const kwh3=v=>v==null?'–':nf(v,3)+' kWh';
+function render(c){
+  const s=!c.enabled?['wyłączone','']:(c.state==='połączono'?['połączono','ok']:(c.state==='błąd'?['błąd','err']:[c.state,'']));
+  $('st').innerHTML=`<span class="pill ${s[1]}">${esc(s[0])}</span>`;
+  $('stT').textContent=c.last_ok>1600000000?'ostatnie dane: '+new Date(c.last_ok*1000).toLocaleString('pl-PL')+(c.backfill_left?' · uzupełnianie historii: zostało '+c.backfill_left+' dni':''):'';
+  const e=$('err');if(c.enabled&&c.error){e.style.display='';e.textContent=c.error;}else e.style.display='none';
+  const T=c.today||{},Y=c.yesterday||{};
+  $('kv').innerHTML=[['Licznik',(c.serial||'–')+(c.tariff?' · taryfa '+c.tariff:'')],['Stan licznika – pobór (A+)',kwh3(c.total_plus)],['Stan licznika – oddanie (A−)',kwh3(c.total_minus)],
+    ['Dziś – pobrano / oddano',kwh3(T.imp)+' / '+kwh3(T.exp)],['Wczoraj – pobrano / oddano',kwh3(Y.imp)+' / '+kwh3(Y.exp)],['Zapytania',c.requests]]
+    .map(([a,b])=>`<div><span>${a}</span><b>${esc(b)}</b></div>`).join('');
+  if(!filled){$('en').checked=c.enabled;$('user').value=c.user||'';$('passH').textContent=c.has_password?'zapisane – zostaw puste, aby nie zmieniać':'wymagane';filled=true;}
+}
+async function load(){try{render(await get('/api/fusion/energa'));}catch(e){}}
+async function save(){
+  try{await post('/api/fusion/energa',{enabled:$('en').checked,user:$('user').value.trim(),password:$('pass').value});$('pass').value='';filled=false;toast('Zapisano – logowanie w ciągu kilku sekund');setTimeout(load,4000);}catch(e){toast('Błąd: '+e.message,false);}
+}
+async function refresh(){try{await post('/api/fusion/energa/refresh');toast('Pobieranie…');setTimeout(load,8000);}catch(e){toast('Błąd: '+e.message,false);}}
+load();setInterval(load,15000);
+</script>
