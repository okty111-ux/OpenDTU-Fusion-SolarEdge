+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Energa Operator "Mój Licznik" (smart meter portal): energy taken from the
+ * grid (A+) and fed into the grid (A-) per hour and day, and the meter totals.
+ *
+ * Same interface as the Mój Licznik mobile app (api-mojlicznik.energa-operator.pl,
+ * unofficial). The distributor publishes the hourly values with a delay
+ * (usually the next day), so this fills the history, not the live view.
+ *
+ *  - every hour: meter totals, today and yesterday (hourly)
+ *  - once after setup: the last 62 days, so the history gets import/export
+ *  - daily values go into EnergyHistory (columns Import / Eksport)
+ */
+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <mutex>
+#include <vector>
+
+struct EnergaConfig {
+    bool enabled = false;
+    String user;
+    String password;
+};
+
+struct EnergaDay {
+    String date;
+    float imp = -1, exp = -1;   // kWh
+    float hImp[24], hExp[24];   // kWh per hour, NAN = no data
+};
+
+class EnergaMeterClass {
+public:
+    void init();
+    EnergaConfig getConfig();
+    bool setConfig(const EnergaConfig& c, bool keepPassword);
+    void requestRefresh() { _refresh = true; }
+    void toJson(JsonVariant root);       // settings page (never the password)
+    void hourlyToJson(JsonObject root);  // today + yesterday per hour, for the dashboard
+
+private:
+    static void taskEntry(void* arg);
+    void taskLoop();
+    bool cycle();
+    bool login();
+    bool get(const String& path, String& out, int& status);
+    bool fetchMeter();
+    bool fetchDay(time_t dayStart, EnergaDay& d);
+    void setError(const String& e);
+    void load();
+    bool save();
+
+    std::mutex _mutex;
+    EnergaConfig _cfg;
+    String _deviceToken, _token;
+    std::vector<std::pair<String, String>> _cookies;
+    bool _loggedIn = false;
+    String _state = "wyłączone", _error;
+    volatile bool _refresh = false;
+    volatile bool _cfgChanged = false;
+    // meter
+    String _meterId, _obisPlus, _obisMinus, _serial, _tariff;
+    float _totalPlus = NAN, _totalMinus = NAN;
+    time_t _lastOk = 0;
+    EnergaDay _today, _yesterday;
+    int _backfillLeft = -1; // days still to fetch (-1 = not started)
+    uint32_t _requests = 0;
+};
+
+extern EnergaMeterClass EnergaMeter;
