     // rebuild days/months/years from saved daily totals (SD card) when the
     // history is empty; -1 = not yet (date unknown), 0 = not needed, 1 = done
     int importDays(const std::vector<EnergyRecord>& days);
+    // grid import / export from the distributor's meter portal (Energa Mój Licznik)
+    void setGridDay(const char* key, float imp, float exp);
+    void setGridToday(const char* key, float imp, float exp);
 
 private:
     void loop();
@@ -81,6 +84,8 @@ private:
     void readLiveCounters(Counters& c, float& hoyW, float& seW);
     void rollover(const char* newDate);
     EnergyRecord todayRecord() const;
+    char _gridKey[11] = "";
