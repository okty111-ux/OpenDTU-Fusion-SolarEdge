+
+void WebApiFusionClass::onEnergaPage(AsyncWebServerRequest* request)
+{
+    if (!WebApi.checkCredentials(request)) return;
+    request->send(200, "text/html; charset=utf-8", ENERGA_PAGE_HTML);
+}
+
+void WebApiFusionClass::onEnergaGet(AsyncWebServerRequest* request)
+{
+    if (!WebApi.checkCredentials(request)) return;
+    AsyncJsonResponse* response = new AsyncJsonResponse();
+    EnergaMeter.toJson(response->getRoot());
+    WebApi.sendJsonResponse(request, response, __FUNCTION__, __LINE__);
+}
+
+void WebApiFusionClass::onEnergaPost(AsyncWebServerRequest* request)
+{
+    if (!WebApi.checkCredentials(request)) return;
+    AsyncJsonResponse* response = new AsyncJsonResponse();
+    JsonDocument root;
+    if (!WebApi.parseRequestData(request, response, root)) return;
+    EnergaConfig c = EnergaMeter.getConfig();
+    c.enabled = root["enabled"] | c.enabled;
+    if (root["user"].is<const char*>()) c.user = root["user"].as<String>();
+    const String pass = root["password"] | "";
+    const bool keep = pass.isEmpty();
+    if (!keep) c.password = pass;
+    reply(request, response, EnergaMeter.setConfig(c, keep), "Settings saved!", "Failed to save settings!");
+}
+
+void WebApiFusionClass::onEnergaRefresh(AsyncWebServerRequest* request)
+{
+    if (!WebApi.checkCredentials(request)) return;
+    EnergaMeter.requestRefresh();
+    reply(request, new AsyncJsonResponse(), true, "Queued", "");
+}
