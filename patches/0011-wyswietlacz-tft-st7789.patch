+static void pageGrid(FtCanvas& c, const FdData& d)
+{
+    char n[24], b[32];
+    const char* u;
+    const bool exp = d.gridW >= 0;
+    const uint8_t col = exp ? FT_GREEN : FT_RED;
+    txt(c, 12, 54, F_RB, col, exp ? "EKSPORT DO SIECI" : "POBÓR Z SIECI");
+    rtxt(c, W - 12, 54, F_R, FT_GREY, "teraz");
+    fpowSplit(n, sizeof(n), &u, d.gridW);
+    bigValue(c, 10, 106, F_BIG, col, n, u, FT_GREY);
+
+    const float prod = sum2(d.todayHoy, d.todaySe);
+    float self = -1;
+    if (prod > 0 && d.todayExp >= 0) { self = prod - d.todayExp; if (self < 0) self = 0; }
+
+    struct T { const char* k; float v; uint8_t col; bool pct; } t[4] = {
+        { "eksport dziś", d.todayExp, FT_GREEN, false },
+        { "pobór dziś", d.todayImp, FT_RED, false },
+        { "zużyte z PV", self, FT_WHITE, false },
+        { "autokonsumpcja", self >= 0 && prod > 0 ? 100.0f * self / prod : -1, FT_DARK, true },
+    };
+    const int w = 145, h = 52;
+    for (int i = 0; i < 4; i++) {
+        const int x = 10 + (i % 2) * (w + 10), y = 124 + (i / 2) * (h + 8);
+        const bool yel = t[i].pct;
+        rbox(c, x, y, w, h, 8, yel ? FT_YELLOW : FT_CARD);
+        txt(c, x + 10, y + 18, F_S, yel ? FT_DARK : FT_GREY, t[i].k);
+        if (t[i].pct) {
+            if (t[i].v < 0) snprintf(b, sizeof(b), "-"); else snprintf(b, sizeof(b), "%.0f %%", t[i].v);
+        } else fkwh(b, sizeof(b), t[i].v);
+        txt(c, x + 10, y + 42, F_L, t[i].col, b);
+    }
+}
