+// ---------------------------------------------------------------- frame
+static void header(FtCanvas& c, const FdData& d, uint8_t page, uint8_t no, uint8_t cnt, bool autoRotate)
+{
+    box(c, 0, 0, W, 30, FT_HEAD);
+    txt(c, 10, 21, F_L, FT_WHITE, TITLES[page]);
+    int xr = W - 10;
+    if (d.timeValid) {
+        rtxt(c, xr, 21, F_L, FT_WHITE, d.clock);
+        xr -= width(c, F_L, d.clock) + 12;
+    }
+    // page dots
+    const int dot = 6, gap = 4;
+    int x = xr - cnt * (dot + gap) + gap;
+    for (uint8_t i = 1; i <= cnt; i++, x += dot + gap) {
+        rbox(c, x, 12, dot, dot, 3, i == no ? FT_YELLOW : FT_LINE);
+    }
+    if (!autoRotate) { // pause marker = automatic switching off
+        const int px = xr - cnt * (dot + gap) - 12;
+        box(c, px, 10, 2, 10, FT_GREY);
+        box(c, px + 4, 10, 2, 10, FT_GREY);
+    }
+}
