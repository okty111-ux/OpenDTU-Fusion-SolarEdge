+static void pagePanels(FtCanvas& c, const FdData& d)
+{
+    char b[32];
+    int y = 40;
+    const int rowH = 23;
+    for (uint8_t k = 0; k < d.mpptCount && y + rowH <= H; k++) {
+        const FdMppt& m = d.mppt[k];
+        for (uint8_t j = 0; j < m.panelCount && j < 2 && y + rowH <= H; j++, y += rowH) {
+            const FdPanel& p = m.panel[j];
+            if (d.multiInverter) snprintf(b, sizeof(b), "%u.%u", m.inv, m.ch);
+            else snprintf(b, sizeof(b), "%u", m.ch);
+            txt(c, 12, y + 16, F_SB, FT_ORANGE, b);
+            char nm[12];
+            strncpy(nm, p.name, sizeof(nm) - 1);
+            nm[sizeof(nm) - 1] = 0;
+            txt(c, 40, y + 16, F_R, FT_WHITE, nm);
+            // bar: share of the panel's peak power
+            const int bx = 128, bw = 120, bh = 10, byy = y + 7;
+            rbox(c, bx, byy, bw, bh, 5, FT_CARD);
+            if (m.reachable && p.wp > 0 && p.p > 0) {
+                float f = p.p / p.wp;
+                if (f > 1) f = 1;
+                const int fw = (int)lroundf(bw * f);
+                if (fw >= 2) rbox(c, bx, byy, fw < 10 ? 10 : fw, bh, 5, FT_ORANGE);
+            }
+            if (m.reachable) snprintf(b, sizeof(b), "~%.0f W", p.p); else snprintf(b, sizeof(b), "-");
+            rtxt(c, W - 12, y + 16, F_RB, FT_WHITE, b);
+        }
+        if (m.panelCount == 0) {
+            snprintf(b, sizeof(b), "%u", m.ch);
+            txt(c, 12, y + 16, F_SB, FT_ORANGE, b);
+            txt(c, 40, y + 16, F_R, FT_GREY, "brak danych paneli");
+            y += rowH;
+        }
+    }
+}
