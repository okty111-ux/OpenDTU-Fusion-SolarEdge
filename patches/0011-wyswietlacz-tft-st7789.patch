diff --git a/include/FusionTftPages.h b/include/FusionTftPages.h
new file mode 100644
index 00000000..6660ff7b
--- /dev/null
+++ b/include/FusionTftPages.h
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Page rendering for a 320x240 colour TFT (ST7789, 2.4").
+ * Text is drawn with U8g2 fonts into a 1 bit layer, which is then painted in
+ * the current colour into an 8 bit indexed frame buffer (palette ftPalette).
+ * No Arduino dependencies -> compiled natively for preview images too.
+ */
+#pragma once
+#include <stdint.h>
+#include "FusionDisplayPages.h"
+
+#define FT_W 320
+#define FT_H 240
+
+enum FtColor : uint8_t {
+    FT_BG = 0,   // screen background
+    FT_HEAD,     // header bar
+    FT_CARD,     // card background
+    FT_LINE,     // grid / separators
+    FT_WHITE,
+    FT_GREY,     // secondary text
+    FT_YELLOW,   // totals (dark text on it)
+    FT_DARK,     // text on yellow
+    FT_ORANGE,   // Hoymiles
+    FT_ORANGE_D, // Hoymiles area fill
+    FT_BLUE,     // SolarEdge
+    FT_BLUE_D,   // SolarEdge area fill
+    FT_GREEN,    // export / producing
+    FT_RED,      // import / offline
+    FT_CYAN,
+    FT_COLOR_COUNT
+};
+
+// RGB565 values of the palette
+extern const uint16_t ftPalette[FT_COLOR_COUNT];
+
+struct FtCanvas {
+    u8g2_t* u;    // 320x240 1 bit layer (full buffer, vertical_top_lsb)
+    uint8_t* fb;  // FT_W * FT_H bytes, one palette index per pixel
+    uint8_t ink;  // colour of the pending 1 bit layer
+};
+
+void ftRenderPage(FtCanvas& c, const FdData& d, uint8_t page, uint8_t pageNo, uint8_t pageCnt, bool autoRotate);
+void ftRenderOverlay(FtCanvas& c, const char* line1, const char* line2);
+// paints the pending 1 bit layer into fb and clears it (done by the render functions)
+void ftFlushLayer(FtCanvas& c);
