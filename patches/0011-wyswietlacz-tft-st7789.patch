+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "FusionTftPages.h"
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#define W FT_W
+#define H FT_H
+
+#define F_S u8g2_font_helvR08_te   // small
+#define F_SB u8g2_font_helvB08_te
+#define F_R u8g2_font_helvR10_te   // rows
+#define F_RB u8g2_font_helvB10_te
+#define F_M u8g2_font_helvB12_te   // card values
+#define F_L u8g2_font_helvB14_te
+#define F_XL u8g2_font_helvB18_te  // units next to big numbers
+#define F_BIG u8g2_font_fub42_tn   // digits only
+#define F_BIG2 u8g2_font_fub30_tn
+
+static inline uint16_t rgb(uint8_t r, uint8_t g, uint8_t b) { return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); }
+
+const uint16_t ftPalette[FT_COLOR_COUNT] = {
+    rgb(0x0B, 0x12, 0x20), // BG
+    rgb(0x16, 0x21, 0x36), // HEAD
+    rgb(0x1A, 0x25, 0x3A), // CARD
+    rgb(0x33, 0x41, 0x55), // LINE
+    rgb(0xF1, 0xF5, 0xF9), // WHITE
+    rgb(0x94, 0xA3, 0xB8), // GREY
+    rgb(0xFF, 0xC8, 0x3D), // YELLOW
+    rgb(0x1F, 0x17, 0x00), // DARK
+    rgb(0xF5, 0x9E, 0x0B), // ORANGE
+    rgb(0x8A, 0x5A, 0x0A), // ORANGE_D
+    rgb(0x3B, 0x82, 0xF6), // BLUE
+    rgb(0x1E, 0x45, 0x8C), // BLUE_D
+    rgb(0x22, 0xC5, 0x5E), // GREEN
+    rgb(0xEF, 0x44, 0x44), // RED
+    rgb(0x22, 0xD3, 0xEE), // CYAN
+};
+
+static const char* const TITLES[FD_PAGE_COUNT] = {
+    "Produkcja", "Wykres mocy", "Sieć", "Hoymiles MPPT", "Panele", "SolarEdge", "Historia", "Status"
+};
+
+// ---------------------------------------------------------------- formatting
+static void fnum(char* b, size_t n, float v, int dec)
+{
+    snprintf(b, n, "%.*f", dec, v);
+    for (char* p = b; *p; p++) if (*p == '.') *p = ',';
+}
+// number and unit separately (big numbers are drawn with a digits-only font)
+static void fpowSplit(char* num, size_t n, const char** unit, float w)
+{
+    w = fabsf(w);
+    if (w >= 1000) {
+        fnum(num, n, w / 1000.0f, w >= 10000 ? 1 : 2);
+        *unit = "kW";
+    } else {
+        snprintf(num, n, "%.0f", w);
+        *unit = "W";
+    }
+}
+static void fpow(char* b, size_t n, float w)
+{
+    char t[16];
+    const char* u;
+    fpowSplit(t, sizeof(t), &u, w);
+    snprintf(b, n, "%s %s", t, u);
+}
+static void fkwhSplit(char* num, size_t n, const char** unit, float k)
+{
+    if (k < 0) { snprintf(num, n, "-"); *unit = ""; return; }
+    if (k >= 1000) { fnum(num, n, k / 1000.0f, 2); *unit = "MWh"; return; }
+    fnum(num, n, k, k >= 100 ? 1 : 2);
+    *unit = "kWh";
+}
+static void fkwh(char* b, size_t n, float k)
+{
+    char t[16];
+    const char* u;
+    fkwhSplit(t, sizeof(t), &u, k);
+    if (*u) snprintf(b, n, "%s %s", t, u); else snprintf(b, n, "%s", t);
+}
+static float sum2(float a, float b)
+{
+    if (a < 0 && b < 0) return -1;
+    return (a < 0 ? 0 : a) + (b < 0 ? 0 : b);
+}
+
+// ---------------------------------------------------------------- canvas
+void ftFlushLayer(FtCanvas& c)
+{
+    uint8_t* buf = u8g2_GetBufferPtr(c.u);
+    const uint8_t ink = c.ink;
+    for (int row = 0; row < H / 8; row++) {
+        uint8_t* src = buf + row * W;
+        for (int x = 0; x < W; x++) {
+            uint8_t v = src[x];
+            if (!v) continue;
+            src[x] = 0;
+            uint8_t* dst = c.fb + (row * 8) * W + x;
+            for (int b = 0; b < 8; b++, dst += W) {
+                if (v & (1 << b)) *dst = ink;
+            }
+        }
+    }
+}
+
+static void ink(FtCanvas& c, uint8_t col)
+{
+    if (col == c.ink) return;
+    ftFlushLayer(c);
+    c.ink = col;
+}
+
+static void box(FtCanvas& c, int x, int y, int w, int h, uint8_t col)
+{
+    ftFlushLayer(c); // keep painter's order
+    if (x < 0) { w += x; x = 0; }
+    if (y < 0) { h += y; y = 0; }
+    if (x + w > W) w = W - x;
+    if (y + h > H) h = H - y;
+    if (w <= 0 || h <= 0) return;
+    for (int yy = y; yy < y + h; yy++) memset(c.fb + yy * W + x, col, w);
+}
+
+static void rbox(FtCanvas& c, int x, int y, int w, int h, int r, uint8_t col)
+{
+    box(c, x, y + r, w, h - 2 * r, col);
+    for (int i = 0; i < r; i++) {
+        // quarter circle inset for row i (from the top/bottom edge)
+        const float dy = r - i - 0.5f;
+        const int in = r - (int)lroundf(sqrtf((float)r * r - dy * dy));
+        box(c, x + in, y + i, w - 2 * in, 1, col);
+        box(c, x + in, y + h - 1 - i, w - 2 * in, 1, col);
+    }
+}
+
+static void hline(FtCanvas& c, int x, int y, int w, uint8_t col) { box(c, x, y, w, 1, col); }
+static void vline(FtCanvas& c, int x, int y, int h, uint8_t col) { box(c, x, y, 1, h, col); }
+static void pix(FtCanvas& c, int x, int y, uint8_t col)
+{
+    if (x >= 0 && x < W && y >= 0 && y < H) c.fb[y * W + x] = col;
+}
+
+static int width(FtCanvas& c, const uint8_t* font, const char* s)
+{
+    u8g2_SetFont(c.u, font);
+    return u8g2_GetUTF8Width(c.u, s);
+}
+static int txt(FtCanvas& c, int x, int y, const uint8_t* font, uint8_t col, const char* s)
+{
+    ink(c, col);
+    u8g2_SetFont(c.u, font);
+    return x + u8g2_DrawUTF8(c.u, x, y, s);
+}
+static void rtxt(FtCanvas& c, int xr, int y, const uint8_t* font, uint8_t col, const char* s)
+{
+    txt(c, xr - width(c, font, s), y, font, col, s);
+}
+static void ctxt(FtCanvas& c, int xc, int y, const uint8_t* font, uint8_t col, const char* s)
+{
+    txt(c, xc - width(c, font, s) / 2, y, font, col, s);
+}
+
+// big number + unit, left aligned at x; returns right edge
+static int bigValue(FtCanvas& c, int x, int y, const uint8_t* font, uint8_t col, const char* num, const char* unit, uint8_t ucol)
+{
+    int xe = txt(c, x, y, font, col, num);
+    if (unit && *unit) xe = txt(c, xe + 6, y, F_XL, ucol, unit);
+    return xe;
+}
