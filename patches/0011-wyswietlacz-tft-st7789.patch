+// compare 16x16 blocks with the last frame, queue the changed ones
+void FusionDisplayClass::tftMarkDirty()
+{
+    for (int by = 0; by < 15; by++) {
+        for (int bx = 0; bx < 20; bx++) {
+            uint32_t h = 2166136261u;
+            const uint8_t* p = _fb + by * 16 * FT_W + bx * 16;
+            for (int y = 0; y < 16; y++, p += FT_W) {
+                for (int x = 0; x < 16; x++) h = (h ^ p[x]) * 16777619u;
+            }
+            const int i = by * 20 + bx;
+            _dirty[i] = !_hashValid || h != _blockHash[i];
+            _blockHash[i] = h;
+        }
+    }
+    _hashValid = true;
+    _sendPos = 0;
+}
+
+// send up to 'budget' changed blocks (keeps each loop call short for the radios)
+void FusionDisplayClass::tftPump(uint16_t budget)
+{
+    while (_sendPos < 300 && budget) {
+        if (!_dirty[_sendPos]) {
+            _sendPos++;
+            continue;
+        }
+        // run of consecutive dirty blocks in this block row
+        const int by = _sendPos / 20, bx0 = _sendPos % 20;
+        int bx1 = bx0;
+        while (bx1 + 1 < 20 && _dirty[by * 20 + bx1 + 1] && (uint16_t)(bx1 - bx0 + 1) < budget) bx1++;
+        const int x0 = bx0 * 16, x1 = bx1 * 16 + 15, y0 = by * 16;
+        tftWindow(x0, y0, x1, y0 + 15);
+        for (int y = y0; y < y0 + 16; y++) {
+            const uint8_t* p = _fb + y * FT_W + x0;
+            for (int x = x0; x <= x1; x++) {
+                const uint16_t c = ftPalette[*p++];
+                tftByte(c >> 8);
+                tftByte(c);
+            }
+        }
+        tftEnd();
+        for (int b = bx0; b <= bx1; b++) _dirty[by * 20 + b] = 0;
+        budget -= (bx1 - bx0 + 1);
+        _sendPos = by * 20 + bx1 + 1;
+    }
 }
 
