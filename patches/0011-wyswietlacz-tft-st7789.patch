+// key/value row with a thin separator below
+static void kvRow(FtCanvas& c, int x, int xr, int y, const char* k, const char* v, uint8_t vcol = FT_WHITE, bool sep = true)
+{
+    txt(c, x, y, F_R, FT_GREY, k);
+    rtxt(c, xr, y, F_RB, vcol, v);
