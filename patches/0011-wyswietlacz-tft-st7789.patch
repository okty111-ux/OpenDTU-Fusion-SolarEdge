+static void pageMppt(FtCanvas& c, const FdData& d)
+{
+    char b[32], t[16];
+    const int cx[5] = { 12, 120, 182, 246, 310 }; // name | U(r) | I(r) | P(r) | today(r)
+    int y = 50;
+    txt(c, cx[0], y, F_S, FT_GREY, "MPPT");
+    rtxt(c, cx[1], y, F_S, FT_GREY, "napięcie");
+    rtxt(c, cx[2], y, F_S, FT_GREY, "prąd");
+    rtxt(c, cx[3], y, F_S, FT_GREY, "moc");
+    rtxt(c, cx[4], y, F_S, FT_GREY, "dziś");
+    const uint8_t n = d.mpptCount > 8 ? 8 : d.mpptCount;
+    const int rh = n > 6 ? 23 : 28;
+    y += 6;
+    for (uint8_t k = 0; k < n; k++) {
+        const FdMppt& m = d.mppt[k];
+        const int ry = y + k * rh;
+        if (k & 1) box(c, 6, ry, W - 12, rh, FT_CARD);
+        const int by = ry + rh / 2 + 5;
+        if (d.multiInverter) snprintf(b, sizeof(b), "%u.%u", m.inv, m.ch);
+        else snprintf(b, sizeof(b), "MPPT %u", m.ch);
+        txt(c, cx[0], by, F_RB, FT_ORANGE, b);
+        if (m.reachable) {
+            fnum(t, sizeof(t), m.u, 1); snprintf(b, sizeof(b), "%s V", t); rtxt(c, cx[1], by, F_R, FT_WHITE, b);
+            fnum(t, sizeof(t), m.i, 2); snprintf(b, sizeof(b), "%s A", t); rtxt(c, cx[2], by, F_R, FT_WHITE, b);
+            snprintf(b, sizeof(b), "%.0f W", m.p); rtxt(c, cx[3], by, F_RB, FT_ORANGE, b);
+        } else {
+            rtxt(c, cx[3], by, F_R, FT_GREY, "brak odczytu");
+        }
+        fkwh(b, sizeof(b), m.yd / 1000.0f);
+        rtxt(c, cx[4], by, F_R, FT_YELLOW, b);
+    }
+}
