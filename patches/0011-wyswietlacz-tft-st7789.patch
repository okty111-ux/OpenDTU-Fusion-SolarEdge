+static void pagePower(FtCanvas& c, const FdData& d)
+{
+    char n[24], b[32], s[32];
+    const char* u;
+    const float tot = d.hoyW + d.seW;
+    const bool producing = tot >= 1.0f;
+
+    txt(c, 12, 52, F_R, FT_GREY, producing ? "Moc teraz" : "Moc teraz · brak produkcji");
+    fpowSplit(n, sizeof(n), &u, tot);
+    bigValue(c, 10, 104, F_BIG, producing ? FT_WHITE : FT_GREY, n, u, FT_GREY);
+
+    // today, yellow highlighted
+    rbox(c, 204, 40, 106, 68, 10, FT_YELLOW);
+    txt(c, 214, 58, F_RB, FT_DARK, "Dziś");
+    fkwhSplit(n, sizeof(n), &u, sum2(d.todayHoy, d.todaySe));
+    txt(c, 214, 84, F_XL, FT_DARK, n);
+    txt(c, 214, 100, F_SB, FT_DARK, u);
+
+    // three source cards
+    const int y = 122, h = 110, w = 96, g = 9;
+    fpow(b, sizeof(b), d.hoyW);
+    fkwh(n, sizeof(n), d.todayHoy);
+    snprintf(s, sizeof(s), "dziś %s", n);
+    sourceCard(c, 10, y, w, h, FT_ORANGE, "Hoymiles", d.hoyReachable ? b : "-", s,
+        d.hoyReachable ? (d.hoyW >= 1 ? "produkuje" : "czuwa") : "offline", d.hoyReachable ? FT_GREEN : FT_RED);
+
+    if (d.seConfigured) {
+        fpow(b, sizeof(b), d.seW);
+        fkwh(n, sizeof(n), d.todaySe);
+        snprintf(s, sizeof(s), "dziś %s", n);
+        sourceCard(c, 10 + w + g, y, w, h, FT_BLUE, "SolarEdge", d.seValid ? b : "-", s,
+            d.seValid ? (d.seW >= 1 ? "produkuje" : "czuwa") : "offline", d.seValid ? FT_GREEN : FT_RED);
+    } else {
+        sourceCard(c, 10 + w + g, y, w, h, FT_BLUE, "SolarEdge", "-", nullptr, "wyłączony", FT_GREY);
+    }
+
+    if (d.meterValid) {
+        const bool exp = d.gridW >= 0;
+        fpow(b, sizeof(b), d.gridW);
+        sourceCard(c, 10 + 2 * (w + g), y, w, h, exp ? FT_GREEN : FT_RED, "Sieć", b, exp ? "oddawane" : "pobierane",
+            exp ? "eksport" : "pobór", exp ? FT_GREEN : FT_RED);
+    } else {
+        sourceCard(c, 10 + 2 * (w + g), y, w, h, FT_GREEN, "Sieć", "-", nullptr, "brak licznika", FT_GREY);
+    }
+}
