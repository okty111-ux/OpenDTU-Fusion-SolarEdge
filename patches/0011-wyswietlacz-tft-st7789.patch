+bool FusionDisplayClass::tftBegin()
+{
+    if (!_fb) {
+        _fb = static_cast<uint8_t*>(heap_caps_malloc(FT_W * FT_H, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (!_fb) _fb = static_cast<uint8_t*>(malloc(FT_W * FT_H));
+        if (!_fb) {
+            ESP_LOGE(TAG, "No memory for the TFT frame buffer");
+            return false;
+        }
+    }
+    for (uint8_t p : { FD_PIN_MOSI, FD_PIN_SCK, FD_PIN_CS, FD_PIN_DC, FD_PIN_RST }) {
+        pinMode(p, OUTPUT);
+        digitalWrite(p, p == FD_PIN_CS || p == FD_PIN_DC ? HIGH : LOW);
+    }
+    delay(10);
+    digitalWrite(FD_PIN_RST, HIGH);
+    delay(120);
+    tftCmd(0x01); tftEnd(); // software reset
+    delay(150);
+    tftCmd(0x11); tftEnd(); // sleep out
+    delay(120);
+    tftCmd1(0x3A, 0x55);    // 16 bit colour
+    tftCmd1(0x36, (_cfg.flip ? 0xA0 : 0x60) | (_cfg.tftBgr ? 0x08 : 0x00)); // landscape 320x240
+    tftCmd(_cfg.tftInvert ? 0x21 : 0x20); tftEnd();
+    tftCmd(0x13); tftEnd(); // normal mode
+    // clear to background
+    tftWindow(0, 0, FT_W - 1, FT_H - 1);
+    const uint16_t bg = ftPalette[FT_BG];
+    for (uint32_t i = 0; i < (uint32_t)FT_W * FT_H; i++) {
+        tftByte(bg >> 8);
+        tftByte(bg);
+    }
+    tftEnd();
+    tftCmd(0x29); tftEnd(); // display on
+
+    u8g2_SetupDisplay(&s_u8g2, tft_display_cb, u8x8_cad_001, tft_dummy_cb, tft_dummy_cb);
+    u8g2_SetupBuffer(&s_u8g2, s_layer, FT_H / 8, u8g2_ll_hvline_vertical_top_lsb, U8G2_R0);
+    u8g2_ClearBuffer(&s_u8g2);
