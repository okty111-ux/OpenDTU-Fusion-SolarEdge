+// ---------------------------------------------------------------- chart
+static void pageChart(FtCanvas& c, const FdData& d)
+{
+    const int X0 = 44, X1 = W - 10, TOP = 70, BOT = 206;
+    const int PW = X1 - X0 + 1;
+    const int per = 12;
+    int first = -1, last = -1, peakI = -1;
+    uint32_t peak = 0;
+    float wh = 0;
+    for (int i = 0; i < FD_CURVE_SLOTS; i++) {
+        const uint16_t a = d.curveHoy[i], s = d.curveSe[i];
+        if (a == FD_CURVE_NONE && s == FD_CURVE_NONE) continue;
+        const uint32_t t = (a == FD_CURVE_NONE ? 0 : a) + (s == FD_CURVE_NONE ? 0 : s);
+        if (t > 0) { if (first < 0) first = i; last = i; }
+        if (t > peak) { peak = t; peakI = i; }
+        wh += t * 5.0f / 60.0f;
+    }
+    int h0 = 6, h1 = 20;
+    if (first >= 0) {
+        h0 = first / per - 1; if (h0 < 0) h0 = 0;
+        h1 = (last + per) / per + 1; if (h1 > 24) h1 = 24;
+        if (h1 - h0 < 8) { int m = (h0 + h1) / 2; h0 = m - 4; if (h0 < 0) h0 = 0; h1 = h0 + 8; if (h1 > 24) { h1 = 24; h0 = 16; } }
+    }
+    const int s0 = h0 * per, sN = (h1 - h0) * per;
+
+    float ymax = 1000;
+    if (peak > 0) {
+        const float r = peak * 1.05f;
+        const float e = powf(10.0f, floorf(log10f(r)));
+        static const float F[] = { 1, 1.5f, 2, 2.5f, 3, 4, 5, 6, 8, 10 };
+        for (float f : F) if (f * e >= r) { ymax = f * e; break; }
+    }
+
+    // info line
+    char b[32], n[16];
+    txt(c, 12, 52, F_S, FT_GREY, "Szczyt");
+    fpow(b, sizeof(b), (float)peak);
+    int x = txt(c, 50, 52, F_RB, FT_WHITE, peak ? b : "-");
+    if (peakI >= 0 && peak) {
+        snprintf(b, sizeof(b), "o %02d:%02d", peakI / 12, (peakI % 12) * 5);
+        txt(c, x + 6, 52, F_S, FT_GREY, b);
+    }
+    fkwh(n, sizeof(n), (d.todayHoy >= 0 || d.todaySe >= 0) ? sum2(d.todayHoy, d.todaySe) : wh / 1000.0f);
+    snprintf(b, sizeof(b), "Dziś %s", n);
+    const int bw = width(c, F_RB, b) + 16;
+    rbox(c, W - 10 - bw, 38, bw, 20, 10, FT_YELLOW);
+    txt(c, W - 2 - bw, 53, F_RB, FT_DARK, b);
+
+    // grid lines + scale labels
+    for (int k = 0; k <= 4; k++) {
+        const int y = BOT - (BOT - TOP) * k / 4;
+        for (int gx = X0; gx <= X1; gx += 3) pix(c, gx, y, FT_LINE);
+        if (k == 0) continue;
+        const float v = ymax * k / 4;
+        if (ymax >= 1000) {
+            fnum(b, sizeof(b), v / 1000.0f, fabsf(v / 1000.0f - roundf(v / 1000.0f)) < 0.01f ? 0 : 1);
+        } else snprintf(b, sizeof(b), "%.0f", v);
+        rtxt(c, X0 - 6, y + 4, F_S, FT_GREY, b);
+        if (k == 4) txt(c, X0 + 4, y + 13, F_S, FT_GREY, ymax >= 1000 ? "kW" : "W");
+    }
+
+    // stacked area: Hoymiles (orange) below, SolarEdge (blue) on top, bright outlines
+    int prevH = -1, prevT = -1;
+    for (int i = 0; i < PW; i++) {
+        const int sa = s0 + i * sN / PW;
+        int se_ = s0 + (i + 1) * sN / PW; if (se_ <= sa) se_ = sa + 1;
+        if (sa >= FD_CURVE_SLOTS) break;
+        if (sa > (int)d.curveSlot) { prevH = prevT = -1; continue; }
+        uint32_t ha = 0, sa2 = 0; int cnt = 0;
+        for (int k = sa; k < se_ && k < FD_CURVE_SLOTS; k++) {
+            if (d.curveHoy[k] == FD_CURVE_NONE && d.curveSe[k] == FD_CURVE_NONE) continue;
+            ha += d.curveHoy[k] == FD_CURVE_NONE ? 0 : d.curveHoy[k];
+            sa2 += d.curveSe[k] == FD_CURVE_NONE ? 0 : d.curveSe[k];
+            cnt++;
+        }
+        if (!cnt) { prevH = prevT = -1; continue; }
+        const float hv = (float)ha / cnt, sv = (float)sa2 / cnt;
+        const int yh = BOT - (int)lroundf((BOT - TOP) * fminf(hv, ymax) / ymax);
+        const int yt = BOT - (int)lroundf((BOT - TOP) * fminf(hv + sv, ymax) / ymax);
+        const int px = X0 + i;
+        if (yh < BOT) vline(c, px, yh, BOT - yh, FT_ORANGE_D);
+        if (yt < yh) vline(c, px, yt, yh - yt, FT_BLUE_D);
+        auto edge = [&](int prev, int cur, uint8_t col) {
+            if (prev >= 0) {
+                const int a = prev < cur ? prev : cur, z = prev < cur ? cur : prev;
+                vline(c, px, a, z - a + 1, col);
+            } else pix(c, px, cur, col);
+        };
+        if (d.seConfigured && yt < yh) edge(prevT, yt, FT_BLUE);
+        edge(prevH, yh, FT_ORANGE);
+        if (d.seConfigured && yt >= yh) edge(prevT, yt, FT_BLUE);
+        prevH = yh;
+        prevT = yt;
+    }
+
+    // axis + hours
+    hline(c, X0, BOT, PW, FT_GREY);
+    const int span = h1 - h0, every = span > 12 ? 3 : 2;
+    for (int hh = h0; hh <= h1; hh++) {
+        const int gx = X0 + (hh - h0) * (PW - 1) / span;
+        vline(c, gx, BOT, 3, FT_GREY);
+        if (hh % every == 0) {
+            snprintf(b, sizeof(b), "%d", hh);
+            ctxt(c, gx, BOT + 15, F_S, FT_GREY, b);
+        }
+    }
+    // now marker
+    if (d.timeValid && (int)d.curveSlot >= s0 && (int)d.curveSlot <= s0 + sN) {
+        const int gx = X0 + ((int)d.curveSlot - s0) * PW / sN;
+        for (int y = TOP; y < BOT; y += 4) vline(c, gx, y, 2, FT_YELLOW);
+    }
+    // legend
+    int lx = 12;
+    box(c, lx, 228, 10, 10, FT_ORANGE);
+    lx = txt(c, lx + 14, 237, F_S, FT_WHITE, "Hoymiles") + 14;
+    if (d.seConfigured) {
+        box(c, lx, 228, 10, 10, FT_BLUE);
+        txt(c, lx + 14, 237, F_S, FT_WHITE, "SolarEdge");
+    }
+    if (first < 0) {
+        rbox(c, X0 + 30, 116, PW - 60, 40, 10, FT_CARD);
+        ctxt(c, X0 + PW / 2, 141, F_RB, FT_GREY, d.timeValid ? "Dziś brak produkcji" : "Brak czasu (NTP)");
+    }
+}
+
+// ---------------------------------------------------------------- public
+void ftRenderPage(FtCanvas& c, const FdData& d, uint8_t page, uint8_t no, uint8_t cnt, bool autoRotate)
+{
+    u8g2_SetFontMode(c.u, 1);
+    u8g2_SetDrawColor(c.u, 1);
+    u8g2_ClearBuffer(c.u);
+    c.ink = FT_WHITE;
+    memset(c.fb, FT_BG, W * H);
+    header(c, d, page, no, cnt, autoRotate);
+    switch (page) {
+    case FD_PAGE_POWER: pagePower(c, d); break;
+    case FD_PAGE_CHART: pageChart(c, d); break;
+    case FD_PAGE_GRID: pageGrid(c, d); break;
+    case FD_PAGE_MPPT: pageMppt(c, d); break;
+    case FD_PAGE_PANELS: pagePanels(c, d); break;
+    case FD_PAGE_SOLAREDGE: pageSolarEdge(c, d); break;
+    case FD_PAGE_HISTORY: pageHistory(c, d); break;
+    case FD_PAGE_STATUS: pageStatus(c, d); break;
+    }
+    ftFlushLayer(c);
+}
+
+void ftRenderOverlay(FtCanvas& c, const char* l1, const char* l2)
+{
+    const int w = 280, h = l2 ? 84 : 60, x = (W - w) / 2, y = 34 + (H - 34 - h) / 2;
+    rbox(c, x - 2, y - 2, w + 4, h + 4, 12, FT_YELLOW);
+    rbox(c, x, y, w, h, 10, FT_HEAD);
+    ctxt(c, W / 2, y + (l2 ? 34 : 37), F_L, FT_WHITE, l1);
+    if (l2) ctxt(c, W / 2, y + 62, F_R, FT_GREY, l2);
+    ftFlushLayer(c);
+}
