+.banner p{margin:2px 0;color:var(--mu)}
+.moon{font-size:26px;line-height:1}
+.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
+@media(max-width:640px){.grid{gap:8px}.card{padding:10px}.card .v{font-size:20px}.card .l{font-size:12px}th,td{padding:6px 5px;font-size:13px}main{padding:10px}}
+.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px 16px}
+.card .l{color:var(--mu);font-size:13px}
+.card .v{font-size:28px;font-weight:600;font-variant-numeric:tabular-nums}
