+.pill.ok{background:#1f9d5522;color:var(--ok)}.pill.warn{background:#b7791f22;color:var(--warn)}
+section{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px 16px;margin-bottom:16px;overflow-x:auto}
+section h3{margin:0 0 10px;font-size:16px}
+table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
+th,td{padding:7px 8px;border-bottom:1px solid var(--bd);text-align:right;white-space:nowrap}
+th:first-child,td:first-child{text-align:left}
+th{color:var(--mu);font-weight:500;font-size:13px}
+tr.sum td{font-weight:600}
