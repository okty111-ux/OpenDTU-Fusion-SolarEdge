+// SPDX-License-Identifier: GPL-2.0-or-later
+// Standalone history page served at /history (no chart, tables only)
+#pragma once
+#include <Arduino.h>
+
+static const char HISTORY_PAGE_HTML[] PROGMEM = R"HTMLPAGE(<!DOCTYPE html>
+<html lang="pl">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Fusion – energia</title>
+<style>
+:root{--bg:#f4f6f8;--card:#fff;--tx:#1d2733;--mu:#6b7785;--bd:#e3e7ec;--ok:#1f9d55;--warn:#b7791f;--off:#5a6b7d;--acc:#2b6cb0}
+@media (prefers-color-scheme:dark){:root{--bg:#12161b;--card:#1b2128;--tx:#e6ebf0;--mu:#93a0ae;--bd:#2a323c;--acc:#63a4e8}}
+*{box-sizing:border-box}
+body{margin:0;font:15px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--tx)}
+header{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:var(--card);border-bottom:1px solid var(--bd)}
+header h1{font-size:18px;margin:0}
+header .t{color:var(--mu);font-size:13px}
+main{max-width:980px;margin:0 auto;padding:16px}
+.banner{display:flex;gap:14px;align-items:flex-start;padding:16px 18px;border-radius:12px;background:var(--card);border:1px solid var(--bd);border-left:5px solid var(--off);margin-bottom:16px}
+.banner.on{border-left-color:var(--ok)}
