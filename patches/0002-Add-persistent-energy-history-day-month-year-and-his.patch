+</style>
+</head>
+<body>
+<header><h1>Fusion · energia</h1><div class="t" id="now">–</div></header>
+<main>
+  <div class="banner" id="banner"></div>
+
+  <div class="grid">
+    <div class="card"><div class="l"><span class="lg">Hoymiles MIT-5000-8T</span><span class="sm">Hoymiles</span></div><div class="v" id="hoyW">–</div><div class="s" id="hoyS"></div></div>
+    <div class="card"><div class="l">SolarEdge</div><div class="v" id="seW">–</div><div class="s" id="seS"></div></div>
+    <div class="card"><div class="l">Razem</div><div class="v" id="totW">–</div><div class="s" id="gridS"></div></div>
+  </div>
+
+  <section><h3>Dziś</h3>
+    <table><thead><tr><th>Źródło</th><th>Energia</th><th>Moc szczytowa</th></tr></thead><tbody id="today"></tbody></table>
+  </section>
+
+  <section><h3>Ostatnie dni <span class="mu">[kWh]</span></h3>
+    <table><thead><tr><th>Dzień</th><th><span class="lg">Hoymiles</span><span class="sm">Hoy</span></th><th><span class="lg">SolarEdge</span><span class="sm">SE</span></th><th>Razem</th><th><span class="lg">Eksport</span><span class="sm">Eksp.</span></th><th><span class="lg">Import</span><span class="sm">Imp.</span></th></tr></thead><tbody id="days"></tbody></table>
+  </section>
+
+  <section><h3>Miesiące <span class="mu">[kWh]</span></h3>
+    <table><thead><tr><th>Miesiąc</th><th><span class="lg">Hoymiles</span><span class="sm">Hoy</span></th><th><span class="lg">SolarEdge</span><span class="sm">SE</span></th><th>Razem</th><th><span class="lg">Eksport</span><span class="sm">Eksp.</span></th><th><span class="lg">Import</span><span class="sm">Imp.</span></th></tr></thead><tbody id="months"></tbody></table>
+  </section>
+
+  <section><h3>Lata i liczniki całkowite <span class="mu">[kWh]</span></h3>
+    <table><thead><tr><th>Rok</th><th><span class="lg">Hoymiles</span><span class="sm">Hoy</span></th><th><span class="lg">SolarEdge</span><span class="sm">SE</span></th><th>Razem</th><th><span class="lg">Eksport</span><span class="sm">Eksp.</span></th><th><span class="lg">Import</span><span class="sm">Imp.</span></th></tr></thead><tbody id="years"></tbody></table>
+  </section>
+</main>
+<footer id="foot"></footer>
+<script>
+const $=id=>document.getElementById(id);
+const MON=['styczeń','luty','marzec','kwiecień','maj','czerwiec','lipiec','sierpień','wrzesień','październik','listopad','grudzień'];
+const DOW=['nd','pn','wt','śr','cz','pt','sb'];
+const kwh=v=>(v===undefined||v===null||v<0)?'<span class="mu">–</span>':(+v).toLocaleString('pl-PL',{minimumFractionDigits:2,maximumFractionDigits:2})+' kWh';
+const w=v=>{v=+v||0;return v>=1000?(v/1000).toLocaleString('pl-PL',{maximumFractionDigits:2})+' kW':Math.round(v)+' W'};
+const num=v=>(v===undefined||v===null||v<0)?'<span class="mu">–</span>':(+v).toLocaleString('pl-PL',{minimumFractionDigits:v>=1000?0:2,maximumFractionDigits:v>=1000?0:2});
+const sum=r=>(+r.h||0)+(+r.s||0);
+const row=(label,r,cls='')=>`<tr class="${cls}"><td>${label}</td><td>${num(r.h)}</td><td>${num(r.s)}</td><td>${num(sum(r))}</td><td>${num(r.e)}</td><td>${num(r.i)}</td></tr>`;
+const SE={1:'wyłączony',2:'uśpiony',3:'uruchamianie',4:'produkuje',5:'ograniczony',6:'wyłączanie',7:'błąd',8:'czuwanie'};
+const dayLabel=k=>{const d=new Date(k+'T12:00:00');return `${DOW[d.getDay()]} ${String(d.getDate()).padStart(2,'0')}.${String(d.getMonth()+1).padStart(2,'0')}`};
+const monLabel=k=>{const [y,m]=k.split('-');return `${MON[+m-1].slice(0,3)} ${y}`};
+
+function render(h){
+  const L=h.live, T=h.today;
+  $('now').textContent=h.time_valid?h.now:'brak synchronizacji czasu (NTP)';
+  const producing=L.total_w>5;
+  const b=$('banner');
+  b.className='banner'+(producing?' on':'');
+  if(producing){
+    b.innerHTML=`<div class="moon">☀</div><div><h2>Trwa produkcja</h2><p>Od ${T.first||'–'} · dziś łącznie ${kwh(sum(T))}</p></div>`;
+  }else{
+    const why=[];
+    why.push(L.hoy_reachable?'Hoymiles: brak mocy':'Hoymiles: brak odpowiedzi (uśpiony)');
+    why.push(L.se_valid?`SolarEdge: ${SE[L.se_status]||L.se_status_text}`:'SolarEdge: brak połączenia Modbus');
+    b.innerHTML=`<div class="moon">☾</div><div><h2>Brak produkcji</h2>
+      <p>${why.join(' · ')}</p>
+      <p>Dziś wyprodukowano ${kwh(sum(T))}${T.first?` (od ${T.first} do ${T.last})`:''}.</p>
+      ${h.sunrise?`<p>Wschód słońca ${h.sunrise} · zachód ${h.sunset}</p>`:''}</div>`;
+  }
+  const setV=(id,v)=>{$(id).textContent=w(v);$(id).className='v'+((+v||0)<1?' zero':'')};
+  setV('hoyW',L.hoy_w); setV('seW',L.se_w); setV('totW',L.total_w);
+  $('hoyS').innerHTML=L.hoy_producing?'<span class="pill ok">produkuje</span>':(L.hoy_reachable?'<span class="pill">osiągalny</span>':'<span class="pill">uśpiony</span>');
+  $('seS').innerHTML=L.se_valid?`<span class="pill ${L.se_status==4?'ok':(L.se_status==7?'warn':'')}">${SE[L.se_status]||L.se_status_text}</span>`:'<span class="pill warn">offline</span>';
+  $('gridS').innerHTML=L.grid_w===undefined?'':(L.grid_w>=0?`sieć: eksport ${w(L.grid_w)}`:`sieć: pobór ${w(-L.grid_w)}`);
+
+  $('today').innerHTML=
+    `<tr><td>Hoymiles</td><td>${kwh(T.h)}</td><td>${w(T.hp)}</td></tr>`+
+    `<tr><td>SolarEdge</td><td>${kwh(T.s)}</td><td>${w(T.sp)}</td></tr>`+
+    `<tr class="sum"><td>Razem</td><td>${kwh(sum(T))}</td><td></td></tr>`+
+    (T.e!==undefined?`<tr><td>Eksport do sieci</td><td>${kwh(T.e)}</td><td></td></tr><tr><td>Pobór z sieci</td><td>${kwh(T.i)}</td><td></td></tr>`:'');
+
+  const days=(h.days||[]).slice().reverse();
+  $('days').innerHTML=row(`dziś ${dayLabel(T.k).slice(3)}`,T,'cur')+(days.length?days.map(r=>row(dayLabel(r.k),r)).join(''):'<tr><td colspan="6" class="mu">Brak zapisanych dni</td></tr>');
+  const months=(h.months||[]).slice().reverse();
+  $('months').innerHTML=months.map((r,i)=>row(monLabel(r.k),r,i===0?'cur':'')).join('')||'<tr><td colspan="6" class="mu">–</td></tr>';
+  const years=(h.years||[]).slice().reverse();
+  $('years').innerHTML=years.map((r,i)=>row(r.k,r,i===0?'cur':'')).join('')+row('Łącznie',h.lifetime||{},'sum');
+  $('foot').textContent=`Odświeżanie co 30 s · zapis do pamięci flash co ${h.save_interval_min} min i o północy`;
+}
+async function load(){
+  try{const r=await fetch('/api/history');if(r.ok)render(await r.json());}catch(e){$('now').textContent='brak połączenia z DTU';}
+}
+load();setInterval(load,30000);
+</script>
+</body>
+</html>
+)HTMLPAGE";
