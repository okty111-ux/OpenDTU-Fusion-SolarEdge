+// ---------------------------------------------------------------- XPT2046 touch
+// shares SCK (GPIO10) and MOSI (GPIO9) with the TFT; the TFT ignores the bus while its CS is high
+static uint16_t xptRead(uint8_t cmd, int8_t doPin)
+{
+    for (uint8_t i = 0; i < 8; i++) {
+        if (cmd & 0x80) pinHi(FD_PIN_MOSI); else pinLo(FD_PIN_MOSI);
+        cmd <<= 1;
+        delayMicroseconds(1);
+        pinHi(FD_PIN_SCK);
+        delayMicroseconds(1);
+        pinLo(FD_PIN_SCK);
+    }
+    pinLo(FD_PIN_MOSI);
+    uint16_t v = 0;
+    for (uint8_t i = 0; i < 16; i++) {
+        delayMicroseconds(1);
+        pinHi(FD_PIN_SCK);
+        delayMicroseconds(1);
+        v = (v << 1) | (digitalRead(doPin) ? 1 : 0);
+        pinLo(FD_PIN_SCK);
+    }
+    return v >> 3; // 12 bit result
+}
+
+bool FusionDisplayClass::touchPressed()
+{
+    if (_cfg.touchCs < 0) return false;
+    if (_cfg.touchIrq >= 0) return digitalRead(_cfg.touchIrq) == LOW; // PENIRQ: low while touched
+    if (_cfg.touchDo < 0) return false;
+    digitalWrite(_cfg.touchCs, LOW);
+    const uint16_t z1 = xptRead(0xB1, _cfg.touchDo);
+    const uint16_t z2 = xptRead(0xC1, _cfg.touchDo);
+    xptRead(0x80, _cfg.touchDo); // power down, PENIRQ enabled
+    digitalWrite(_cfg.touchCs, HIGH);
+    const int z = (int)z1 + 4095 - (int)z2;
+    return z1 > 50 && z > 600 && z < 4000;
+}
+
