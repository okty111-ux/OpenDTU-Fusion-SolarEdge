+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * History from the microSD card (files written by SdLogger):
+ *  - power curve of any logged day (/fusion/YYYY/YYYY-MM-DD.csv) in the same
+ *    format as PowerLog (5 minute slots)
+ *  - daily totals older than the 62 days kept in flash (/fusion/dni.csv)
+ *  - if the history in flash is empty (e.g. after a full flash erase), the
+ *    days, months and years are rebuilt from dni.csv
+ */
+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <TaskSchedulerDeclarations.h>
+#include <mutex>
+#include <vector>
+
+struct EnergyRecord;
+
+class SdHistoryClass {
+public:
+    SdHistoryClass();
+    void init(Scheduler& scheduler);
+    // date "YYYY-MM-DD"; false if the card has no file for that day
+    bool dayCurve(const String& date, JsonObject root);
+    // daily totals from dni.csv, from..to inclusive ("YYYY-MM-DD")
+    bool days(const String& from, const String& to, JsonArray out);
+    // {"mounted":true,"first":"YYYY-MM-DD"} for /api/history
+    void statusToJson(JsonObject o);
+
+private:
+    void loop();
+    bool readDays(std::vector<EnergyRecord>& out, const String& from, const String& to);
+    String findFirst();
+
+    Task _task;
+    std::mutex _mutex;
+    String _first;
+    uint32_t _firstMs = 0;
+    bool _importDone = false;
+};
+
+extern SdHistoryClass SdHistory;
