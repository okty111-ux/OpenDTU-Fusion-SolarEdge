+// sun (day) or moon (night) moving along an arc from left (sunrise / sunset) to right (sunset / sunrise)
+function sunPath(h){
+  const el=$('hSun');if(!el)return;
+  const m=v=>{const p=String(v||'').split(':');return p.length>1?(+p[0])*60+(+p[1]):NaN;};
+  const rise=m(h.sunrise),set=m(h.sunset),now=h.time_valid?m(String(h.now).slice(11,16)):NaN;
