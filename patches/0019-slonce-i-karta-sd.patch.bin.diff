+// GET /api/history/days?from=YYYY-MM-DD&to=YYYY-MM-DD   daily totals from the SD card
+void WebApiSolarEdgeClass::onSdDaysGet(AsyncWebServerRequest* request)
+{
+    if (!WebApi.checkCredentialsReadonly(request)) {
+        return;
+    }
+    AsyncJsonResponse* response = new AsyncJsonResponse();
+    const String from = request->hasParam("from") ? request->getParam("from")->value() : String();
+    const String to = request->hasParam("to") ? request->getParam("to")->value() : String();
+    if (!SdHistory.days(from, to, response->getRoot()["days"].to<JsonArray>())) {
+        response->getRoot()["error"] = SdLogger.isMounted() ? "no dni.csv" : "no card";
+    }
+    WebApi.sendJsonResponse(request, response, __FUNCTION__, __LINE__);
+}
