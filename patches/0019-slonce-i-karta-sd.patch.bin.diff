new file mode 100644
index 00000000..002b5ef3
--- /dev/null
+++ b/src/SdHistory.cpp
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "SdHistory.h"
+#include "EnergyHistory.h"
+#include "PowerLog.h"
+#include "SdLogger.h"
+#include <SD_MMC.h>
+#include <map>
+
+#undef TAG
+static const char* TAG = "sdhist";
+
+SdHistoryClass SdHistory;
+
+#if SD_CSV_DECIMAL_COMMA
+static const char SEP = ';';
+#else
+static const char SEP = ',';
+#endif
+
+static void splitLine(const String& l, std::vector<String>& f)
+{
+    f.clear();
+    int s = 0;
+    for (;;) {
+        const int e = l.indexOf(SEP, s);
+        if (e < 0) {
+            f.push_back(l.substring(s));
+            break;
+        }
+        f.push_back(l.substring(s, e));
+        s = e + 1;
+    }
+}
+
+static float toF(const String& s)
+{
+    if (s.isEmpty()) return NAN;
+    String t = s;
+    t.replace(',', '.');
+    return t.toFloat();
+}
+
+static int col(const std::vector<String>& h, const char* name)
+{
+    for (size_t i = 0; i < h.size(); i++) {
+        if (h[i] == name) return i;
+    }
+    return -1;
+}
+
+static String readLine(File& f)
+{
+    String l = f.readStringUntil('\n');
+    l.trim();
+    return l;
+}
+
+SdHistoryClass::SdHistoryClass()
+    : _task(30 * TASK_SECOND, TASK_FOREVER, std::bind(&SdHistoryClass::loop, this))
+{
+}
+
+void SdHistoryClass::init(Scheduler& scheduler)
+{
+    scheduler.addTask(_task);
+    _task.enable();
+}
+
+bool SdHistoryClass::dayCurve(const String& date, JsonObject root)
+{
+    if (!SdLogger.isMounted() || date.length() != 10) return false;
+    const String path = String(SD_LOG_ROOT "/") + date.substring(0, 4) + "/" + date + ".csv";
+    std::vector<float> sh(POWERLOG_SLOTS, 0), ss(POWERLOG_SLOTS, 0);
+    std::vector<uint8_t> ch(POWERLOG_SLOTS, 0), cs(POWERLOG_SLOTS, 0);
+    {
+        std::lock_guard<std::mutex> lock(SdLogger.fsMutex());
+        if (!SD_MMC.exists(path)) return false;
+        File f = SD_MMC.open(path, FILE_READ);
+        if (!f) return false;
+        std::vector<String> fld;
+        int iT = -1, iH = -1, iS = -1;
+        while (f.available()) {
+            const String l = readLine(f);
+            if (l.isEmpty()) continue;
+            splitLine(l, fld);
+            if (!fld.empty() && fld[0] == "czas") { // header (repeated if the MPPT layout changed)
+                iT = col(fld, "czas");
+                iH = col(fld, "hoymiles_W");
+                iS = col(fld, "solaredge_W");
+                continue;
+            }
+            if (iT < 0 || (int)fld.size() <= iT || fld[iT].length() < 16) continue;
+            const int hh = fld[iT].substring(11, 13).toInt(), mm = fld[iT].substring(14, 16).toInt();
+            const int slot = (hh * 60 + mm) / POWERLOG_STEP_MIN;
+            if (slot < 0 || slot >= POWERLOG_SLOTS) continue;
+            if (iH >= 0 && iH < (int)fld.size()) {
+                const float v = toF(fld[iH]);
+                if (!isnan(v) && ch[slot] < 255) { sh[slot] += v; ch[slot]++; }
+            }
+            if (iS >= 0 && iS < (int)fld.size()) {
+                const float v = toF(fld[iS]);
+                if (!isnan(v) && cs[slot] < 255) { ss[slot] += v; cs[slot]++; }
+            }
+        }
+        f.close();
+    }
+    // averages; short gaps (logging interval > 5 min) filled linearly, up to 30 min
+    auto finish = [](std::vector<float>& sum, std::vector<uint8_t>& cnt, JsonArray out) {
+        int last = -1;
+        for (int i = 0; i < POWERLOG_SLOTS; i++) {
+            if (!cnt[i]) continue;
+            sum[i] /= cnt[i];
+            if (last >= 0 && i - last > 1 && i - last <= 6) {
+                for (int k = last + 1; k < i; k++) {
+                    sum[k] = sum[last] + (sum[i] - sum[last]) * (k - last) / (i - last);
+                    cnt[k] = 1;
+                }
+            }
+            last = i;
+        }
+        for (int i = 0; i < POWERLOG_SLOTS; i++) {
+            if (cnt[i]) out.add((int)lroundf(sum[i] < 0 ? 0 : sum[i])); else out.add(nullptr);
+        }
+    };
+    root["date"] = date;
+    root["step_min"] = POWERLOG_STEP_MIN;
+    root["src"] = "sd";
+    finish(sh, ch, root["hoy"].to<JsonArray>());
+    finish(ss, cs, root["se"].to<JsonArray>());
+    return true;
+}
+
+bool SdHistoryClass::readDays(std::vector<EnergyRecord>& out, const String& from, const String& to)
+{
+    if (!SdLogger.isMounted()) return false;
+    std::map<String, EnergyRecord> m; // later rows win (a day written twice)
+    {
+        std::lock_guard<std::mutex> lock(SdLogger.fsMutex());
+        File f = SD_MMC.open(SD_LOG_ROOT "/dni.csv", FILE_READ);
+        if (!f) return false;
+        std::vector<String> fld;
+        int iD = -1, iH = -1, iS = -1, iE = -1, iI = -1, iHp = -1, iSp = -1;
+        while (f.available()) {
+            const String l = readLine(f);
+            if (l.isEmpty()) continue;
+            splitLine(l, fld);
+            if (!fld.empty() && fld[0] == "dzien") {
+                iD = 0;
+                iH = col(fld, "hoymiles_kWh");
+                iS = col(fld, "solaredge_kWh");
+                iE = col(fld, "eksport_kWh");
+                iI = col(fld, "import_kWh");
+                iHp = col(fld, "hoymiles_max_W");
+                iSp = col(fld, "solaredge_max_W");
+                continue;
+            }
+            if (iD < 0 || fld[0].length() != 10) continue;
+            if ((from.length() && fld[0] < from) || (to.length() && fld[0] > to)) continue;
+            EnergyRecord r;
+            strlcpy(r.key, fld[0].c_str(), sizeof(r.key));
+            auto get = [&](int i, float def) {
+                if (i < 0 || i >= (int)fld.size()) return def;
+                const float v = toF(fld[i]);
+                return isnan(v) ? def : v;
+            };
+            r.hoy = get(iH, 0);
+            r.se = get(iS, 0);
+            r.exp = get(iE, -1);
+            r.imp = get(iI, -1);
+            r.hoyPeak = get(iHp, 0);
+            r.sePeak = get(iSp, 0);
+            m[fld[0]] = r;
+            if (m.size() > 4000) break;
+        }
+        f.close();
+    }
+    for (auto& kv : m) out.push_back(kv.second);
+    return true;
+}
+
+bool SdHistoryClass::days(const String& from, const String& to, JsonArray out)
+{
+    std::vector<EnergyRecord> v;
+    if (!readDays(v, from, to)) return false;
+    size_t n = 0;
+    for (auto& r : v) {
+        if (++n > 400) break;
+        auto o = out.add<JsonObject>();
+        o["k"] = static_cast<const char*>(r.key);
+        o["h"] = serialized(String(r.hoy, 3));
+        o["s"] = serialized(String(r.se, 3));
+        if (r.exp >= 0) o["e"] = serialized(String(r.exp, 3));
+        if (r.imp >= 0) o["i"] = serialized(String(r.imp, 3));
+        o["hp"] = (int)r.hoyPeak;
+        o["sp"] = (int)r.sePeak;
+    }
+    return true;
+}
+
+// oldest day on the card: first day in dni.csv or oldest daily file
+String SdHistoryClass::findFirst()
+{
+    String first;
+    std::lock_guard<std::mutex> lock(SdLogger.fsMutex());
+    File d = SD_MMC.open(SD_LOG_ROOT "/dni.csv", FILE_READ);
+    if (d) {
+        while (d.available()) {
+            const String l = readLine(d);
+            if (l.length() >= 10 && isdigit((uint8_t)l[0])) {
+                first = l.substring(0, 10);
+                break;
+            }
+        }
+        d.close();
+    }
+    File root = SD_MMC.open(SD_LOG_ROOT);
+    String year;
+    if (root && root.isDirectory()) {
+        for (File e = root.openNextFile(); e; e = root.openNextFile()) {
+            String n = e.name();
+            const int sl = n.lastIndexOf('/');
+            if (sl >= 0) n = n.substring(sl + 1);
+            if (e.isDirectory() && n.length() == 4 && isdigit((uint8_t)n[0]) && (year.isEmpty() || n < year)) year = n;
+            e.close();
+        }
+        root.close();
+    }
+    if (year.length()) {
+        File y = SD_MMC.open(String(SD_LOG_ROOT "/") + year);
+        if (y && y.isDirectory()) {
+            for (File e = y.openNextFile(); e; e = y.openNextFile()) {
+                String n = e.name();
+                const int sl = n.lastIndexOf('/');
+                if (sl >= 0) n = n.substring(sl + 1);
+                if (n.length() == 14 && n.endsWith(".csv")) {
+                    const String k = n.substring(0, 10);
+                    if (first.isEmpty() || k < first) first = k;
+                }
+                e.close();
+            }
+            y.close();
+        }
+    }
+    return first;
+}
+
+void SdHistoryClass::statusToJson(JsonObject o)
+{
+    const bool m = SdLogger.isMounted();
+    o["mounted"] = m;
+    std::lock_guard<std::mutex> lock(_mutex);
+    if (m && _first.length()) o["first"] = _first;
+}
+
+void SdHistoryClass::loop()
+{
+    if (!SdLogger.isMounted()) {
+        std::lock_guard<std::mutex> lock(_mutex);
+        _first = "";
+        _firstMs = 0;
+        return;
+    }
+    if (_firstMs == 0 || millis() - _firstMs > 3600000UL) {
+        const String f = findFirst();
+        std::lock_guard<std::mutex> lock(_mutex);
+        _first = f;
+        _firstMs = millis() | 1;
+    }
+    if (!_importDone) {
+        std::vector<EnergyRecord> v;
+        if (readDays(v, "", "")) {
+            const int r = EnergyHistory.importDays(v);
+            if (r >= 0) {
+                _importDone = true;
+                if (r > 0) ESP_LOGI(TAG, "history rebuilt from the card: %u days", (unsigned)v.size());
+            }
+        } else {
+            _importDone = true; // no dni.csv
+        }
+    }
+}
