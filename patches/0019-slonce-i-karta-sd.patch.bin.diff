+int EnergyHistoryClass::importDays(const std::vector<EnergyRecord>& days)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    if (!_date[0]) return -1;
+    if (!_days.empty() || !_months.empty() || !_years.empty() || days.empty()) return 0;
+    std::vector<EnergyRecord> v(days);
+    std::sort(v.begin(), v.end(), [](const EnergyRecord& a, const EnergyRecord& b) { return strcmp(a.key, b.key) < 0; });
+    for (auto& d : v) {
+        if (strlen(d.key) != 10 || strcmp(d.key, _date) >= 0) continue; // only finished days
+        if (_days.empty() || strcmp(_days.back().key, d.key) != 0) {
+            _days.push_back(d);
+            while (_days.size() > HISTORY_MAX_DAYS) _days.pop_front();
+        }
+        char month[8], year[5];
+        strlcpy(month, d.key, sizeof(month));
+        strlcpy(year, d.key, sizeof(year));
+        addTo(_months, month, d, HISTORY_MAX_MONTHS);
+        addTo(_years, year, d, HISTORY_MAX_YEARS);
+    }
+    save();
+    return 1;
+}
