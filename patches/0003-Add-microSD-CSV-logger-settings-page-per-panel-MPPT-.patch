diff --git a/include/HoymilesChannels.h b/include/HoymilesChannels.h
new file mode 100644
index 0000000..581a0b6
--- /dev/null
+++ b/include/HoymilesChannels.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Per-MPPT (DC channel) readings of all Hoymiles inverters + per-panel estimate.
+ *
+ * MIT-5000-8T: 4 MPPT, 1 input per MPPT, typically 2 modules in SERIES on one
+ * input. The inverter only measures the whole string (U, I, P), so per-panel
+ * values are estimated from the panel data entered by the user:
+ *   series:   I_panel = I_string,  U_k = U * w_k,  P_k = P * w_k
+ *   parallel: U_panel = U_string,  I_k = I * w_k,  P_k = P * w_k
+ * where w_k = Vmp_k / sum(Vmp) (series, if Vmp of all panels given) or
+ *       w_k = Wp_k  / sum(Wp)  (otherwise).
+ * Config: LittleFS /mppt.json
+ */
+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <mutex>
+#include <vector>
+
+#define MPPT_MAX_PANELS 2
+
+struct PanelCfg {
+    String name;
+    uint16_t wp = 0;   // rated power, 0 = not used
+    float vmp = 0;     // optional, V
+};
+
+struct MpptCfg {
+    bool series = true;
+    PanelCfg panel[MPPT_MAX_PANELS];
+    uint8_t count() const;
+};
+
+struct PanelEstimate {
+    String name;
+    uint16_t wp;
+    float u, i, p, yieldDay; // V, A, W, Wh
+};
+
+struct MpptReading {
+    String inverter;
+    String serial;
+    uint8_t invIndex;  // 1-based
+    uint8_t channel;   // 1-based MPPT number
+    String name;       // channel name from OpenDTU settings
+    bool reachable;
+    float u, i, p;     // V, A, W
+    float yieldDay;    // Wh
+    float yieldTotal;  // kWh
+    bool series;
+    std::vector<PanelEstimate> panels;
+};
+
+class HoymilesChannelsClass {
+public:
+    void init();
+    std::vector<MpptReading> read();
+    void toJson(JsonArray arr);
+    void configToJson(JsonObject root);
+    bool configFromJson(JsonObjectConst root);
+
+private:
+    MpptCfg getCfg(const String& serial, uint8_t ch);
+    void load();
+    bool save();
+    std::mutex _mutex;
+    JsonDocument _cfg; // { "<serial>": [ {series, panels:[{name,wp,vmp}]} x channels ] }
+};
+
+extern HoymilesChannelsClass HoymilesChannels;
diff --git a/include/SdLogger.h b/include/SdLogger.h
new file mode 100644
index 0000000..ccd27f4
--- /dev/null
+++ b/include/SdLogger.h
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * microSD CSV logger for OpenDTU Fusion v2.
+ *
+ * Wiring, SDMMC 1-bit mode, 3.3 V card socket (SPI display header is used
+ * by the SSD1322 display):
+ *   CLK  GPIO14 (display header MISO pin)
+ *   CMD  GPIO2  (I2C header SDA)
+ *   D0   GPIO1  (I2C header SCL)
+ *   D3/CS of the card: 10k pull-up to 3V3; 10k pull-ups on CMD and D0 too.
+ * Uses the SDMMC peripheral, not SPI -> works with NRF24 + CMT + W5500.
+ *
+ * Files:
+ *   /fusion/YYYY/YYYY-MM-DD.csv   one row every N minutes
+ *   /fusion/dni.csv               one row per finished day
+ */
+#pragma once
+
+#include <Arduino.h>
+#include <TaskSchedulerDeclarations.h>
+#include <mutex>
+
+#ifndef SD_PIN_CLK
+#define SD_PIN_CLK 14
+#endif
+#ifndef SD_PIN_CMD
+#define SD_PIN_CMD 2
+#endif
+#ifndef SD_PIN_D0
+#define SD_PIN_D0 1
+#endif
+#ifndef SD_PIN_D3
+#define SD_PIN_D3 -1
+#endif
+#ifndef SD_MMC_FREQ_KHZ
+#define SD_MMC_FREQ_KHZ 20000
+#endif
+#ifndef SD_DEFAULT_INTERVAL_MIN
+#define SD_DEFAULT_INTERVAL_MIN 5
+#endif
+// 1 = Polish Excel friendly: ';' separator and ',' decimal mark
+#ifndef SD_CSV_DECIMAL_COMMA
+#define SD_CSV_DECIMAL_COMMA 1
+#endif
+
+#define SD_LOG_ROOT "/fusion"
+
+struct SdStatus {
+    bool compiled = false;
+    bool mounted = false;
+    String reason;
+    String cardType;
+    uint64_t totalBytes = 0;
+    uint64_t usedBytes = 0;
+    uint16_t intervalMin = SD_DEFAULT_INTERVAL_MIN;
+    bool enabled = true;
+    String lastWrite;
+    uint32_t writeErrors = 0;
+};
+
+class SdLoggerClass {
+public:
+    SdLoggerClass();
+    void init(Scheduler& scheduler);
+
+    SdStatus getStatus();
+    bool isMounted() const { return _mounted; }
+    bool setConfig(bool enabled, uint16_t intervalMin);
+    std::mutex& fsMutex() { return _fsMutex; }
+
+    static bool isSafePath(const String& path);
+
+private:
+    void loop();
+    bool mount();
+    void unmount(const char* reason);
+    bool appendLine(const String& path, const String& header, const String& line);
+    void writeSample(const struct tm& t);
+    void writeDaySummary(const struct EnergyRecord& r);
+    void loadConfig();
+    bool saveConfig();
+
+    static String num(float v, uint8_t digits);
+
+    Task _loopTask;
+    std::mutex _fsMutex;
+    bool _busOk = false;
+    volatile bool _mounted = false;
+    String _reason = "not initialised";
+    bool _enabled = true;
+    uint16_t _intervalMin = SD_DEFAULT_INTERVAL_MIN;
+    int _lastSlot = -1;
+    char _lastSummary[11] = { 0 }; // last day written to dni.csv (persisted)
+    uint32_t _lastMountTry = 0;
+    String _lastWrite;
+    uint32_t _writeErrors = 0;
+};
+
+extern SdLoggerClass SdLogger;
