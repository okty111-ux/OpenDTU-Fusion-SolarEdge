+
+EnergySummary EnergyHistoryClass::getSummary()
+{
+    EnergySummary s;
+    std::lock_guard<std::mutex> lock(_mutex);
+    s.lifetime = _last;
+    if (!_date[0]) return s;
+    s.valid = true;
+    s.today = todayRecord();
+    if (!_days.empty()) {
+        s.yesterday = _days.back();
+        s.hasYesterday = true;
+    }
+    char month[8], year[5];
+    strlcpy(month, _date, sizeof(month));
+    strlcpy(year, _date, sizeof(year));
+    auto pick = [&](const std::deque<EnergyRecord>& src, const char* key, EnergyRecord& out) {
+        if (!src.empty() && strcmp(src.back().key, key) == 0) out = src.back();
+        else strlcpy(out.key, key, sizeof(out.key));
+        out.hoy += s.today.hoy;
+        out.se += s.today.se;
+        if (s.today.exp >= 0) out.exp = (out.exp < 0 ? 0 : out.exp) + s.today.exp;
+        if (s.today.imp >= 0) out.imp = (out.imp < 0 ? 0 : out.imp) + s.today.imp;
+    };
+    pick(_months, month, s.month);
+    pick(_years, year, s.year);
+    return s;
+}
diff --git a/src/FusionDisplay.cpp b/src/FusionDisplay.cpp
new file mode 100644
index 0000000..8a4afef
--- /dev/null
+++ b/src/FusionDisplay.cpp
@@ -0,0 +1,389 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "FusionDisplay.h"
+#include "Datastore.h"
+#include "EnergyHistory.h"
+#include "FusionDisplayPages.h"
+#include "HoymilesChannels.h"
+#include "SdLogger.h"
+#include "SolarEdge.h"
+#include <Hoymiles.h>
+#include <LittleFS.h>
+#include <NetworkSettings.h>
+#include <WiFi.h>
+#include <soc/gpio_struct.h>
+#include <esp_timer.h>
+#include <time.h>
+
+#undef TAG
+static const char* TAG = "fdisplay";
+static const char* CFG_FILE = "/display.json";
+static const uint32_t LONG_PRESS_MS = 1000;
+static const uint32_t DEBOUNCE_MS = 30;
+
+FusionDisplayClass FusionDisplay;
+static u8g2_t s_u8g2;
+
+// ---------------------------------------------------------------- fast SW SPI
+// SPI mode 0, MSB first. Pins 0..31 only (GPIO9..13 on the display header).
+static inline void IRAM_ATTR pinHi(uint8_t p) { GPIO.out_w1ts = (1UL << p); }
+static inline void IRAM_ATTR pinLo(uint8_t p) { GPIO.out_w1tc = (1UL << p); }
+
+static uint8_t fd_byte_cb(u8x8_t* u8x8, uint8_t msg, uint8_t arg_int, void* arg_ptr)
+{
+    switch (msg) {
+    case U8X8_MSG_BYTE_SEND: {
+        const uint8_t* data = static_cast<const uint8_t*>(arg_ptr);
+        while (arg_int--) {
+            uint8_t b = *data++;
+            for (uint8_t i = 0; i < 8; i++) {
+                if (b & 0x80) pinHi(FD_PIN_MOSI); else pinLo(FD_PIN_MOSI);
+                b <<= 1;
+                __asm__ __volatile__("nop; nop; nop; nop;");
+                pinHi(FD_PIN_SCK); // SSD1322 latches on rising edge
+                __asm__ __volatile__("nop; nop; nop; nop;");
+                pinLo(FD_PIN_SCK);
+            }
+        }
+        break;
+    }
+    case U8X8_MSG_BYTE_INIT:
+        pinLo(FD_PIN_SCK);
+        u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_disable_level);
+        break;
+    case U8X8_MSG_BYTE_SET_DC:
+        u8x8_gpio_SetDC(u8x8, arg_int);
+        break;
+    case U8X8_MSG_BYTE_START_TRANSFER:
+        u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_enable_level);
+        u8x8->gpio_and_delay_cb(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->post_chip_enable_wait_ns, NULL);
+        break;
+    case U8X8_MSG_BYTE_END_TRANSFER:
+        u8x8->gpio_and_delay_cb(u8x8, U8X8_MSG_DELAY_NANO, u8x8->display_info->pre_chip_disable_wait_ns, NULL);
+        u8x8_gpio_SetCS(u8x8, u8x8->display_info->chip_disable_level);
+        break;
+    default:
+        return 0;
+    }
+    return 1;
+}
+
+static uint8_t fd_gpio_cb(u8x8_t* u8x8, uint8_t msg, uint8_t arg_int, void* arg_ptr)
+{
+    switch (msg) {
+    case U8X8_MSG_GPIO_AND_DELAY_INIT:
+        for (uint8_t p : { FD_PIN_MOSI, FD_PIN_SCK, FD_PIN_CS, FD_PIN_DC, FD_PIN_RST }) {
+            pinMode(p, OUTPUT);
+            digitalWrite(p, p == FD_PIN_CS || p == FD_PIN_RST ? HIGH : LOW);
+        }
+        break;
+    case U8X8_MSG_DELAY_NANO: delayMicroseconds(arg_int == 0 ? 0 : 1); break;
+    case U8X8_MSG_DELAY_100NANO: delayMicroseconds(1); break;
+    case U8X8_MSG_DELAY_10MICRO: delayMicroseconds(10 * arg_int); break;
+    case U8X8_MSG_DELAY_MILLI: delay(arg_int); break;
+    case U8X8_MSG_GPIO_CS: digitalWrite(FD_PIN_CS, arg_int); break;
+    case U8X8_MSG_GPIO_DC: digitalWrite(FD_PIN_DC, arg_int); break;
+    case U8X8_MSG_GPIO_RESET: digitalWrite(FD_PIN_RST, arg_int); break;
+    default: return 0;
+    }
+    return 1;
+}
+
+// ---------------------------------------------------------------- class
+FusionDisplayClass::FusionDisplayClass()
+    : _loopTask(20 * TASK_MILLISECOND, TASK_FOREVER, std::bind(&FusionDisplayClass::loop, this))
+{
+}
+
+void FusionDisplayClass::init(Scheduler& scheduler)
+{
+    loadConfig();
+    pinMode(FD_PIN_BUTTON, INPUT_PULLUP);
+    if (_cfg.enabled) begin();
+    _lastActivity = _lastSwitch = millis();
+    scheduler.addTask(_loopTask);
+    _loopTask.enable();
+}
+
+void FusionDisplayClass::begin()
+{
+    if (_started) {
+        u8g2_SetPowerSave(&s_u8g2, 0);
+        return;
+    }
+    u8g2_Setup_ssd1322_nhd_256x64_f(&s_u8g2, _cfg.flip ? U8G2_R2 : U8G2_R0, fd_byte_cb, fd_gpio_cb);
+    u8g2_InitDisplay(&s_u8g2);
+    u8g2_SetPowerSave(&s_u8g2, 0);
+    u8g2_SetContrast(&s_u8g2, _cfg.contrast);
+    _u8g2 = &s_u8g2;
+    _started = true;
+    _sleeping = false;
+    ESP_LOGI(TAG, "SSD1322 started");
+}
+
+FusionDisplayConfig FusionDisplayClass::getConfig()
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    return _cfg;
+}
+
+bool FusionDisplayClass::setConfig(const FusionDisplayConfig& c)
+{
+    bool ok;
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        _cfg = c;
+        _cfg.contrast = c.contrast;
+        if (_cfg.pages == 0) _cfg.pages = 1;
+        ok = saveConfig();
+    }
+    if (_cfg.enabled) {
+        begin();
+        u8g2_SetContrast(&s_u8g2, _cfg.contrast);
+        u8g2_SetDisplayRotation(&s_u8g2, _cfg.flip ? U8G2_R2 : U8G2_R0);
+        _lastActivity = millis();
+        _sleeping = false;
+        _lastDraw = 0;
+    } else if (_started) {
+        u8g2_ClearDisplay(&s_u8g2);
+        u8g2_SetPowerSave(&s_u8g2, 1);
+    }
+    return ok;
+}
+
+void FusionDisplayClass::toJson(JsonObject root)
+{
+    const FusionDisplayConfig c = getConfig();
+    root["enabled"] = c.enabled;
+    root["auto_sec"] = c.autoSec;
+    root["sleep_min"] = c.sleepMin;
+    root["contrast"] = c.contrast;
+    root["flip"] = c.flip;
+    auto pages = root["pages"].to<JsonArray>();
+    for (uint8_t p = 0; p < FD_PAGE_COUNT; p++) {
+        auto o = pages.add<JsonObject>();
+        o["id"] = p;
+        o["name"] = fdPageTitle(p);
+        o["on"] = (c.pages >> p) & 1;
+    }
+    root["page"] = _page;
+    root["sleeping"] = _sleeping;
+    root["auto_on"] = _autoOn;
+}
+
+void FusionDisplayClass::nextPage() { _webNext = true; }
+
+void FusionDisplayClass::loadConfig()
+{
+    File f = LittleFS.open(CFG_FILE, "r");
+    if (!f) return;
+    JsonDocument doc;
+    if (!deserializeJson(doc, f)) {
+        _cfg.enabled = doc["enabled"] | false;
+        _cfg.autoSec = doc["auto_sec"] | 10;
+        _cfg.sleepMin = doc["sleep_min"] | 10;
+        _cfg.contrast = doc["contrast"] | 160;
+        _cfg.flip = doc["flip"] | false;
+        _cfg.pages = doc["pages"] | 0x7F;
+    }
+    f.close();
+}
+
+bool FusionDisplayClass::saveConfig()
+{
+    JsonDocument doc;
+    doc["enabled"] = _cfg.enabled;
+    doc["auto_sec"] = _cfg.autoSec;
+    doc["sleep_min"] = _cfg.sleepMin;
+    doc["contrast"] = _cfg.contrast;
+    doc["flip"] = _cfg.flip;
+    doc["pages"] = _cfg.pages;
+    File f = LittleFS.open(CFG_FILE, "w");
+    if (!f) return false;
+    const bool ok = serializeJson(doc, f) > 0;
+    f.close();
+    return ok;
+}
+
+bool FusionDisplayClass::producing()
+{
+    const SolarEdgeData se = SolarEdge.getData();
+    return Datastore.getIsAtLeastOneProducing() || (se.valid && se.acPower > 1.0f);
+}
+
+uint8_t FusionDisplayClass::nextAvailable(const FdData& d, uint8_t from)
+{
+    for (uint8_t k = 1; k <= FD_PAGE_COUNT; k++) {
+        const uint8_t p = (from + k) % FD_PAGE_COUNT;
+        if (((_cfg.pages >> p) & 1) && fdPageAvailable(d, p)) return p;
+    }
+    return FD_PAGE_POWER;
+}
+
+void FusionDisplayClass::loop()
+{
+    if (!_cfg.enabled || !_started) return;
+    const uint32_t now = millis();
+
+    // ---- button (active low, debounced)
+    bool shortPress = false, longPress = false;
+    const bool down = digitalRead(FD_PIN_BUTTON) == LOW;
+    if (down != _btnDown && now - _btnChange > DEBOUNCE_MS) {
+        _btnDown = down;
+        _btnChange = now;
+        if (down) {
+            _btnSince = now;
+            _btnLongDone = false;
+        } else if (!_btnLongDone) {
+            shortPress = true;
+        }
+    }
+    if (_btnDown && !_btnLongDone && now - _btnSince >= LONG_PRESS_MS) {
+        _btnLongDone = true;
+        longPress = true;
+    }
+    if (_webNext) {
+        _webNext = false;
+        shortPress = true;
+    }
+
+    bool redraw = now - _lastDraw >= 1000;
+    if (shortPress || longPress) {
+        _lastActivity = now;
+        if (_sleeping) {
+            _sleeping = false;
+            u8g2_SetPowerSave(&s_u8g2, 0);
+            shortPress = false; // first press only wakes the screen
+        }
+        redraw = true;
+    }
+
+    // ---- night sleep
+    if (!_sleeping && _cfg.sleepMin > 0 && !producing() && now - _lastActivity > _cfg.sleepMin * 60000UL) {
+        _sleeping = true;
+        u8g2_SetPowerSave(&s_u8g2, 1);
+    }
+    if (_sleeping) {
+        if (producing()) { // morning: production started
+            _sleeping = false;
+            _lastActivity = now;
+            u8g2_SetPowerSave(&s_u8g2, 0);
+        } else {
+            return;
+        }
+    }
+    if (!redraw) return;
+
+    static FdData d;
+    collect(d);
+    if (!(((_cfg.pages >> _page) & 1) && fdPageAvailable(d, _page))) _page = nextAvailable(d, _page);
+
+    if (shortPress) {
+        _page = nextAvailable(d, _page);
+        _lastSwitch = now;
+    }
+    if (longPress) {
+        _autoOn = !_autoOn;
+        _lastSwitch = now;
+        _ov1 = "Automatyczne przełączanie";
+        _ov2 = _autoOn ? (String("włączone · co ") + _cfg.autoSec + " s") : String("wyłączone · krótko = następna");
+        _overlayUntil = now + 2000;
+    }
+    if (_autoOn && _cfg.autoSec > 0 && now - _lastSwitch >= _cfg.autoSec * 1000UL) {
+        _page = nextAvailable(d, _page);
+        _lastSwitch = now;
+    }
+
+    uint8_t cnt = 0, no = 0;
+    for (uint8_t p = 0; p < FD_PAGE_COUNT; p++) {
+        if (((_cfg.pages >> p) & 1) && fdPageAvailable(d, p)) {
+            cnt++;
+            if (p <= _page) no++;
+        }
+    }
+
+    u8g2_ClearBuffer(&s_u8g2);
+    fdRenderPage(&s_u8g2, d, _page, no ? no : 1, cnt ? cnt : 1, _autoOn && _cfg.autoSec > 0);
+    if (now < _overlayUntil) fdRenderOverlay(&s_u8g2, _ov1.c_str(), _ov2.length() ? _ov2.c_str() : nullptr);
+    u8g2_SendBuffer(&s_u8g2);
+    _lastDraw = now;
+}
+
+static void copyStr(char* dst, size_t n, const String& s) { strlcpy(dst, s.c_str(), n); }
+
+void FusionDisplayClass::collect(FdData& d)
+{
+    memset(&d, 0, sizeof(d));
+    struct tm t;
+    d.timeValid = getLocalTime(&t, 0) && t.tm_year >= (2024 - 1900);
+    if (d.timeValid) {
+        strftime(d.clock, sizeof(d.clock), "%H:%M", &t);
+        strftime(d.date, sizeof(d.date), "%d.%m.%Y", &t);
+    }
+
+    d.hoyW = Datastore.getTotalAcPowerEnabled();
+    d.hoyReachable = Datastore.getIsAtLeastOneReachable();
+    const SolarEdgeData se = SolarEdge.getData();
+    const SolarEdgeConfig sc = SolarEdge.getConfig();
+    d.seConfigured = sc.enabled && sc.host.length() > 0;
+    d.seValid = se.valid;
+    d.seW = se.valid ? se.acPower : 0;
+    d.meterValid = se.valid && se.meterValid;
+    d.gridW = se.meterPower;
+    copyStr(d.seStatus, sizeof(d.seStatus), SolarEdgeClass::statusToString(se.status));
+    d.seTemp = se.heatsinkTemp;
+    d.seTotalKWh = se.energyTotal / 1000.0f;
+    d.seDcV = se.dcVoltage;
+    copyStr(d.seModel, sizeof(d.seModel), se.model);
+
+    const EnergySummary s = EnergyHistory.getSummary();
+    d.todayHoy = s.valid ? s.today.hoy : -1;
+    d.todaySe = s.valid && d.seConfigured ? s.today.se : -1;
+    d.todayExp = s.valid ? s.today.exp : -1;
+    d.todayImp = s.valid ? s.today.imp : -1;
+    d.hasYesterday = s.hasYesterday;
+    d.yHoy = s.yesterday.hoy; d.ySe = s.yesterday.se;
+    d.mHoy = s.valid ? s.month.hoy : -1; d.mSe = s.valid ? s.month.se : -1;
+    d.yrHoy = s.valid ? s.year.hoy : -1; d.yrSe = s.valid ? s.year.se : -1;
+    d.ltHoy = s.lifetime.hoy; d.ltSe = s.lifetime.se;
+
+    const auto mppt = HoymilesChannels.read();
+    uint8_t maxInv = 0;
+    for (auto& m : mppt) {
+        if (d.mpptCount >= FD_MAX_MPPT) break;
+        FdMppt& o = d.mppt[d.mpptCount++];
+        o.inv = m.invIndex; o.ch = m.channel; o.reachable = m.reachable;
+        o.u = m.u; o.i = m.i; o.p = m.p; o.yd = m.yieldDay;
+        if (m.invIndex > maxInv) maxInv = m.invIndex;
+        o.panelCount = m.panels.size() > 2 ? 2 : m.panels.size();
+        for (uint8_t k = 0; k < o.panelCount; k++) {
+            copyStr(o.panel[k].name, sizeof(o.panel[k].name), m.panels[k].name);
+            o.panel[k].wp = m.panels[k].wp;
+            o.panel[k].p = m.panels[k].p;
+        }
+    }
+    d.multiInverter = maxInv > 1;
+
+    copyStr(d.ip, sizeof(d.ip), NetworkSettings.localIP().toString());
+    if (NetworkSettings.NetworkMode() == network_mode::Ethernet) strlcpy(d.net, "Ethernet (PoE)", sizeof(d.net));
+    else if (NetworkSettings.isConnected()) snprintf(d.net, sizeof(d.net), "Wi-Fi %d dBm", WiFi.RSSI());
+    else strlcpy(d.net, "brak połączenia", sizeof(d.net));
+
+    const SdStatus sd = SdLogger.getStatus();
+    if (sd.mounted) {
+        char a[12], b[12];
+        snprintf(a, sizeof(a), "%.1f", sd.totalBytes / 1073741824.0);
+        snprintf(b, sizeof(b), "%.1f", (sd.totalBytes - sd.usedBytes) / 1073741824.0);
+        for (char* p = a; *p; p++) if (*p == '.') *p = ',';
+        for (char* p = b; *p; p++) if (*p == '.') *p = ',';
+        snprintf(d.sd, sizeof(d.sd), "%s GB · wolne %s GB", a, b);
+    } else {
+        strlcpy(d.sd, sd.enabled ? "brak karty" : "wyłączona", sizeof(d.sd));
+    }
+
+    d.invTotal = Hoymiles.getNumInverters();
+    for (uint8_t i = 0; i < d.invTotal; i++) {
+        auto inv = Hoymiles.getInverterByPos(i);
+        if (inv && inv->isReachable()) d.invOnline++;
+    }
+    d.uptimeS = (uint32_t)(esp_timer_get_time() / 1000000ULL);
+}
diff --git a/src/FusionDisplayPages.cpp b/src/FusionDisplayPages.cpp
new file mode 100644
index 0000000..4df98df
--- /dev/null
+++ b/src/FusionDisplayPages.cpp
@@ -0,0 +1,297 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "FusionDisplayPages.h"
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#define W 256
+#define FONT_SMALL u8g2_font_helvR08_te
+#define FONT_SMALLB u8g2_font_helvB08_te
+#define FONT_ROW u8g2_font_6x12_te
+#define FONT_MID u8g2_font_helvB12_te
+#define FONT_BIG u8g2_font_helvB24_te
+
+static const char* const TITLES[FD_PAGE_COUNT] = {
+    "Produkcja", "Sieć", "Hoymiles MPPT", "Panele (szacunek)", "SolarEdge", "Historia", "Status"
+};
+
+const char* fdPageTitle(uint8_t page) { return page < FD_PAGE_COUNT ? TITLES[page] : ""; }
+
+// ---------- number formatting (decimal comma) ----------
+static void fnum(char* b, size_t n, float v, int dec)
+{
+    snprintf(b, n, "%.*f", dec, v);
+    for (char* p = b; *p; p++) if (*p == '.') *p = ',';
+}
+static void fpow(char* b, size_t n, float w)
+{
+    if (fabsf(w) >= 1000) {
+        char t[16];
+        fnum(t, sizeof(t), w / 1000.0f, fabsf(w) >= 10000 ? 1 : 2);
+        snprintf(b, n, "%s kW", t);
+    } else {
+        snprintf(b, n, "%.0f W", w);
+    }
+}
+static void fkwh(char* b, size_t n, float k)
+{
+    if (k < 0) { snprintf(b, n, "-"); return; }
+    char t[16];
+    if (k >= 1000) { fnum(t, sizeof(t), k / 1000.0f, 2); snprintf(b, n, "%s MWh", t); return; }
+    fnum(t, sizeof(t), k, k >= 100 ? 1 : 2);
+    snprintf(b, n, "%s kWh", t);
+}
+static float sum2(float a, float b)
+{
+    if (a < 0 && b < 0) return -1;
+    return (a < 0 ? 0 : a) + (b < 0 ? 0 : b);
+}
+
+// ---------- drawing helpers ----------
+static void txt(u8g2_t* u, int x, int y, const char* s) { u8g2_DrawUTF8(u, x, y, s); }
+static void rtxt(u8g2_t* u, int xr, int y, const char* s) { u8g2_DrawUTF8(u, xr - u8g2_GetUTF8Width(u, s), y, s); }
+static void ctxt(u8g2_t* u, int xc, int y, const char* s) { u8g2_DrawUTF8(u, xc - u8g2_GetUTF8Width(u, s) / 2, y, s); }
+
+static void header(u8g2_t* u, const FdData& d, uint8_t page, uint8_t no, uint8_t cnt, bool autoRotate)
+{
+    u8g2_SetFont(u, FONT_SMALLB);
+    txt(u, 0, 8, TITLES[page]);
+    u8g2_SetFont(u, FONT_SMALL);
+    char b[24];
+    snprintf(b, sizeof(b), "%u/%u", no, cnt);
+    const int pw = u8g2_GetUTF8Width(u, b);
+    rtxt(u, W, 8, b);
+    if (!autoRotate) { // small "pause" marker = auto switching off
+        u8g2_DrawBox(u, W - pw - 9, 2, 2, 6);
+        u8g2_DrawBox(u, W - pw - 5, 2, 2, 6);
+    }
+    if (d.timeValid) rtxt(u, W - pw - (autoRotate ? 8 : 16), 8, d.clock);
+    u8g2_DrawHLine(u, 0, 11, W);
+}
+
+// 4 content rows for FONT_ROW
+static const int ROW_Y[4] = { 23, 35, 47, 59 };
+
+static void kvRow(u8g2_t* u, int x, int xr, int y, const char* k, const char* v)
+{
+    txt(u, x, y, k);
+    rtxt(u, xr, y, v);
+}
+
+// ---------- pages ----------
+static void pagePower(u8g2_t* u, const FdData& d)
+{
+    char b[32], c[32];
+    const float tot = d.hoyW + d.seW;
+    const bool producing = tot >= 1.0f;
+    u8g2_SetFont(u, FONT_BIG);
+    fpow(b, sizeof(b), tot);
+    txt(u, 0, 44, b);
+    u8g2_SetFont(u, FONT_ROW);
+    fkwh(c, sizeof(c), sum2(d.todayHoy, d.todaySe));
+    snprintf(b, sizeof(b), "Dziś %s", c);
+    txt(u, 0, 60, b);
+    if (!producing) {
+        u8g2_SetFont(u, FONT_SMALL);
+        rtxt(u, 134, 24, "brak produkcji");
+        u8g2_SetFont(u, FONT_ROW);
+    }
+
+    const int x = 150;
+    u8g2_DrawVLine(u, x - 8, 15, 48);
+    fpow(b, sizeof(b), d.hoyW);
+    kvRow(u, x, W, ROW_Y[0], "Hoymiles", d.hoyReachable ? b : "offline");
+    fpow(b, sizeof(b), d.seW);
+    kvRow(u, x, W, ROW_Y[1], "SolarEdge", !d.seConfigured ? "-" : (d.seValid ? b : "offline"));
+    fkwh(b, sizeof(b), d.todayHoy);
+    kvRow(u, x, W, ROW_Y[2], "dziś H", b);
+    fkwh(b, sizeof(b), d.todaySe);
+    kvRow(u, x, W, ROW_Y[3], "dziś SE", b);
+}
+
+static void pageGrid(u8g2_t* u, const FdData& d)
+{
+    char b[32];
+    const bool exp = d.gridW >= 0;
+    u8g2_SetFont(u, FONT_SMALLB);
+    txt(u, 0, 24, exp ? "EKSPORT DO SIECI" : "POBÓR Z SIECI");
+    rtxt(u, 134, 24, "teraz");
+    u8g2_SetFont(u, FONT_BIG);
+    fpow(b, sizeof(b), fabsf(d.gridW));
+    txt(u, 0, 56, b);
+
+    const int x = 150;
+    u8g2_DrawVLine(u, x - 8, 15, 48);
+    u8g2_SetFont(u, FONT_ROW);
+    fkwh(b, sizeof(b), d.todayExp);
+    kvRow(u, x, W, ROW_Y[0], "eksport", b);
+    fkwh(b, sizeof(b), d.todayImp);
+    kvRow(u, x, W, ROW_Y[1], "pobór", b);
+    const float prod = sum2(d.todayHoy, d.todaySe);
+    if (prod > 0 && d.todayExp >= 0) {
+        float self = prod - d.todayExp;
+        if (self < 0) self = 0;
+        fkwh(b, sizeof(b), self);
+        kvRow(u, x, W, ROW_Y[2], "zużyte", b);
+        snprintf(b, sizeof(b), "%.0f %%", 100.0f * self / prod);
+        kvRow(u, x, W, ROW_Y[3], "udział", b);
+    }
+}
+
+static void pageMppt(u8g2_t* u, const FdData& d)
+{
+    char b[32];
+    u8g2_SetFont(u, FONT_ROW);
+    const uint8_t n = d.mpptCount > 4 ? 4 : d.mpptCount; // 4 rows per screen
+    for (uint8_t k = 0; k < n; k++) {
+        const FdMppt& m = d.mppt[k];
+        const int y = ROW_Y[k];
+        if (d.multiInverter) snprintf(b, sizeof(b), "%u.%u", m.inv, m.ch);
+        else snprintf(b, sizeof(b), "MPPT%u", m.ch);
+        txt(u, 0, y, b);
+        if (m.reachable) {
+            char t[16];
+            fnum(t, sizeof(t), m.u, 1); snprintf(b, sizeof(b), "%s V", t); rtxt(u, 92, y, b);
+            fnum(t, sizeof(t), m.i, 2); snprintf(b, sizeof(b), "%s A", t); rtxt(u, 140, y, b);
+            snprintf(b, sizeof(b), "%.0f W", m.p); rtxt(u, 190, y, b);
+        } else {
+            rtxt(u, 160, y, "brak odczytu");
+        }
+        fkwh(b, sizeof(b), m.yd / 1000.0f);
+        rtxt(u, W, y, b);
+    }
+}
+
+static void pagePanels(u8g2_t* u, const FdData& d)
+{
+    char b[32];
+    u8g2_SetFont(u, FONT_ROW);
+    const uint8_t n = d.mpptCount > 4 ? 4 : d.mpptCount;
+    u8g2_DrawVLine(u, 140, 15, 48);
+    for (uint8_t k = 0; k < n; k++) {
+        const FdMppt& m = d.mppt[k];
+        const int y = ROW_Y[k];
+        snprintf(b, sizeof(b), "%u", m.ch);
+        u8g2_SetFont(u, FONT_SMALLB);
+        txt(u, 0, y, b);
+        u8g2_SetFont(u, FONT_ROW);
+        if (m.panelCount == 0) {
+            txt(u, 12, y, "brak danych paneli");
+            continue;
+        }
+        for (uint8_t j = 0; j < m.panelCount && j < 2; j++) {
+            const FdPanel& p = m.panel[j];
+            const int x0 = j ? 148 : 12, xr = j ? W : 134;
+            char nm[12];
+            strncpy(nm, p.name, sizeof(nm) - 1); nm[sizeof(nm) - 1] = 0;
+            if (strlen(nm) > 8) nm[8] = 0;
+            txt(u, x0, y, nm);
+            if (m.reachable) snprintf(b, sizeof(b), "~%.0f W", p.p);
+            else snprintf(b, sizeof(b), "-");
+            rtxt(u, xr, y, b);
+        }
+    }
+}
+
+static void pageSolarEdge(u8g2_t* u, const FdData& d)
+{
+    char b[32];
+    u8g2_SetFont(u, FONT_ROW);
+    if (!d.seValid) {
+        txt(u, 0, ROW_Y[0], "Brak połączenia Modbus TCP");
+        txt(u, 0, ROW_Y[1], "Sprawdź IP i port w ustawieniach");
+        return;
+    }
+    const int m = 128;
+    fpow(b, sizeof(b), d.seW);            kvRow(u, 0, m - 8, ROW_Y[0], "Moc AC", b);
+    fkwh(b, sizeof(b), d.todaySe);        kvRow(u, 0, m - 8, ROW_Y[1], "Dziś", b);
+    fkwh(b, sizeof(b), d.seTotalKWh);     kvRow(u, 0, m - 8, ROW_Y[2], "Łącznie", b);
+    txt(u, 0, ROW_Y[3], d.seModel);
+    u8g2_DrawVLine(u, m, 15, 48);
+    kvRow(u, m + 8, W, ROW_Y[0], "Stan", d.seStatus);
+    char t[12];
+    fnum(t, sizeof(t), d.seTemp, 0); snprintf(b, sizeof(b), "%s °C", t);
+    kvRow(u, m + 8, W, ROW_Y[1], "Radiator", b);
+    fnum(t, sizeof(t), d.seDcV, 0); snprintf(b, sizeof(b), "%s V", t);
+    kvRow(u, m + 8, W, ROW_Y[2], "DC", b);
+}
+
+static void histRow(u8g2_t* u, int y, const char* label, float h, float s)
+{
+    char b[32], bh[16], bs[16];
+    u8g2_SetFont(u, FONT_ROW);
+    txt(u, 0, y, label);
+    fkwh(b, sizeof(b), sum2(h, s));
+    rtxt(u, 150, y, b);
+    u8g2_SetFont(u, FONT_SMALL);
+    fnum(bh, sizeof(bh), h < 0 ? 0 : h, h >= 100 ? 0 : 1);
+    fnum(bs, sizeof(bs), s < 0 ? 0 : s, s >= 100 ? 0 : 1);
+    snprintf(b, sizeof(b), "H %s · SE %s", bh, bs);
+    rtxt(u, W, y, b);
+}
+
+static void pageHistory(u8g2_t* u, const FdData& d)
+{
+    histRow(u, ROW_Y[0], "Wczoraj", d.hasYesterday ? d.yHoy : -1, d.hasYesterday ? d.ySe : -1);
+    histRow(u, ROW_Y[1], "Ten miesiąc", d.mHoy, d.mSe);
+    histRow(u, ROW_Y[2], "Ten rok", d.yrHoy, d.yrSe);
+    histRow(u, ROW_Y[3], "Łącznie", d.ltHoy, d.ltSe);
+}
+
+static void pageStatus(u8g2_t* u, const FdData& d)
+{
+    char b[40];
+    u8g2_SetFont(u, FONT_ROW);
+    kvRow(u, 0, W, ROW_Y[0], "IP", d.ip[0] ? d.ip : "brak");
+    kvRow(u, 0, W, ROW_Y[1], "Sieć", d.net);
+    kvRow(u, 0, W, ROW_Y[2], "Karta SD", d.sd);
+    const uint32_t dd = d.uptimeS / 86400, hh = (d.uptimeS / 3600) % 24, mm = (d.uptimeS / 60) % 60;
+    if (dd) snprintf(b, sizeof(b), "%u/%u online · %u d %u h", d.invOnline, d.invTotal, (unsigned)dd, (unsigned)hh);
+    else snprintf(b, sizeof(b), "%u/%u online · %u h %u min", d.invOnline, d.invTotal, (unsigned)hh, (unsigned)mm);
+    kvRow(u, 0, W, ROW_Y[3], "Inwertery", b);
+}
+
+bool fdPageAvailable(const FdData& d, uint8_t page)
+{
+    switch (page) {
+    case FD_PAGE_GRID: return d.meterValid;
+    case FD_PAGE_MPPT: return d.mpptCount > 0;
+    case FD_PAGE_PANELS:
+        for (uint8_t k = 0; k < d.mpptCount; k++) if (d.mppt[k].panelCount > 1) return true;
+        return false;
+    case FD_PAGE_SOLAREDGE: return d.seConfigured;
+    default: return page < FD_PAGE_COUNT;
+    }
+}
+
+void fdRenderPage(u8g2_t* u, const FdData& d, uint8_t page, uint8_t no, uint8_t cnt, bool autoRotate)
+{
+    u8g2_SetFontMode(u, 1);
+    u8g2_SetDrawColor(u, 1);
+    header(u, d, page, no, cnt, autoRotate);
+    switch (page) {
+    case FD_PAGE_POWER: pagePower(u, d); break;
+    case FD_PAGE_GRID: pageGrid(u, d); break;
+    case FD_PAGE_MPPT: pageMppt(u, d); break;
+    case FD_PAGE_PANELS: pagePanels(u, d); break;
+    case FD_PAGE_SOLAREDGE: pageSolarEdge(u, d); break;
+    case FD_PAGE_HISTORY: pageHistory(u, d); break;
+    case FD_PAGE_STATUS: pageStatus(u, d); break;
+    }
+}
+
+void fdRenderOverlay(u8g2_t* u, const char* l1, const char* l2)
+{
+    const int bw = 170, bh = l2 ? 36 : 22, bx = (W - bw) / 2, by = (64 - bh) / 2;
+    u8g2_SetDrawColor(u, 0);
+    u8g2_DrawBox(u, bx, by, bw, bh);
+    u8g2_SetDrawColor(u, 1);
+    u8g2_DrawFrame(u, bx, by, bw, bh);
+    u8g2_DrawFrame(u, bx + 2, by + 2, bw - 4, bh - 4);
+    u8g2_SetFont(u, FONT_SMALLB);
+    ctxt(u, W / 2, by + 15, l1);
+    if (l2) {
+        u8g2_SetFont(u, FONT_SMALL);
+        ctxt(u, W / 2, by + 28, l2);
+    }
+}
diff --git a/src/HoymilesChannels.cpp b/src/HoymilesChannels.cpp
new file mode 100644
index 0000000..3423016
--- /dev/null
+++ b/src/HoymilesChannels.cpp
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "HoymilesChannels.h"
+#include "Configuration.h"
+#include <Hoymiles.h>
+#include <LittleFS.h>
+
+#undef TAG
+static const char* TAG = "mppt";
+static const char* CFG_FILE = "/mppt.json";
+
+HoymilesChannelsClass HoymilesChannels;
+
+uint8_t MpptCfg::count() const
+{
+    uint8_t n = 0;
+    for (auto& p : panel) if (p.wp > 0) n++;
+    return n;
+}
+
+void HoymilesChannelsClass::init() { load(); }
+
+void HoymilesChannelsClass::load()
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    _cfg.clear();
+    File f = LittleFS.open(CFG_FILE, "r");
+    if (!f) { _cfg.to<JsonObject>(); return; }
+    if (deserializeJson(_cfg, f)) { ESP_LOGW(TAG, "bad %s", CFG_FILE); _cfg.to<JsonObject>(); }
+    f.close();
+}
+
+bool HoymilesChannelsClass::save()
+{
+    File f = LittleFS.open("/mppt.tmp", "w");
+    if (!f) return false;
+    const bool ok = serializeJson(_cfg, f) > 0;
+    f.close();
+    if (!ok) return false;
+    LittleFS.remove(CFG_FILE);
+    return LittleFS.rename("/mppt.tmp", CFG_FILE);
+}
+
+MpptCfg HoymilesChannelsClass::getCfg(const String& serial, uint8_t ch)
+{
+    MpptCfg c;
+    std::lock_guard<std::mutex> lock(_mutex);
+    JsonVariantConst e = _cfg[serial][ch];
+    if (e.isNull()) return c;
+    c.series = e["series"] | true;
+    JsonArrayConst ps = e["panels"];
+    for (uint8_t k = 0; k < MPPT_MAX_PANELS && k < ps.size(); k++) {
+        c.panel[k].name = ps[k]["name"] | "";
+        c.panel[k].wp = ps[k]["wp"] | 0;
+        c.panel[k].vmp = ps[k]["vmp"] | 0.0f;
+    }
+    return c;
+}
+
+static String serialStr(uint64_t s)
+{
+    char b[17];
+    snprintf(b, sizeof(b), "%0x%08x", (uint32_t)(s >> 32), (uint32_t)(s & 0xFFFFFFFF));
+    return String(b);
+}
+
+std::vector<MpptReading> HoymilesChannelsClass::read()
+{
+    std::vector<MpptReading> out;
+    for (uint8_t i = 0; i < Hoymiles.getNumInverters(); i++) {
+        auto inv = Hoymiles.getInverterByPos(i);
+        if (!inv) continue;
+        auto cfg = Configuration.getInverterConfig(inv->serial());
+        auto stats = inv->Statistics();
+        const String ser = serialStr(inv->serial());
+        for (auto& c : stats->getChannelsByType(TYPE_DC)) {
+            MpptReading r;
+            r.inverter = inv->name();
+            r.serial = ser;
+            r.invIndex = i + 1;
+            r.channel = static_cast<uint8_t>(c) + 1;
+            r.name = cfg ? String(cfg->channel[c].Name) : String();
+            r.reachable = inv->isReachable();
+            r.u = stats->getChannelFieldValue(TYPE_DC, c, FLD_UDC);
+            r.i = stats->getChannelFieldValue(TYPE_DC, c, FLD_IDC);
+            r.p = stats->getChannelFieldValue(TYPE_DC, c, FLD_PDC);
+            r.yieldDay = stats->getChannelFieldValue(TYPE_DC, c, FLD_YD);
+            r.yieldTotal = stats->getChannelFieldValue(TYPE_DC, c, FLD_YT);
+
+            const MpptCfg mc = getCfg(ser, static_cast<uint8_t>(c));
+            r.series = mc.series;
+            const uint8_t n = mc.count();
+            if (n > 0) {
+                bool allVmp = true;
+                float sumWp = 0, sumVmp = 0;
+                for (auto& p : mc.panel) {
+                    if (!p.wp) continue;
+                    sumWp += p.wp;
+                    sumVmp += p.vmp;
+                    if (p.vmp <= 0) allVmp = false;
+                }
+                const bool useVmp = mc.series && allVmp && sumVmp > 0;
+                uint8_t k = 0;
+                for (auto& p : mc.panel) {
+                    k++;
+                    if (!p.wp) continue;
+                    const float w = n == 1 ? 1.0f : (useVmp ? p.vmp / sumVmp : p.wp / sumWp);
+                    PanelEstimate e;
+                    e.name = p.name.length() ? p.name : String("Panel ") + k;
+                    e.wp = p.wp;
+                    e.p = r.p * w;
+                    e.yieldDay = r.yieldDay * w;
+                    if (mc.series) { e.u = r.u * w; e.i = r.i; }
+                    else { e.u = r.u; e.i = r.i * w; }
+                    r.panels.push_back(e);
+                }
+            }
+            out.push_back(r);
+        }
+    }
+    return out;
+}
+
+void HoymilesChannelsClass::toJson(JsonArray arr)
+{
+    for (auto& r : read()) {
+        auto o = arr.add<JsonObject>();
+        o["inv"] = r.inverter;
+        o["serial"] = r.serial;
+        o["inv_idx"] = r.invIndex;
+        o["ch"] = r.channel;
+        o["name"] = r.name;
+        o["reachable"] = r.reachable;
+        o["u"] = r.u;
+        o["i"] = r.i;
+        o["p"] = r.p;
+        o["yd"] = r.yieldDay;
+        o["yt"] = r.yieldTotal;
+        o["series"] = r.series;
+        auto ps = o["panels"].to<JsonArray>();
+        for (auto& e : r.panels) {
+            auto po = ps.add<JsonObject>();
+            po["name"] = e.name;
+            po["wp"] = e.wp;
+            po["u"] = e.u;
+            po["i"] = e.i;
+            po["p"] = e.p;
+            po["yd"] = e.yieldDay;
+        }
+    }
+}
+
+// GET: { "inverters":[{serial,name,channels:[{ch,name,series,panels:[{name,wp,vmp}]}]}] }
+void HoymilesChannelsClass::configToJson(JsonObject root)
+{
+    auto invs = root["inverters"].to<JsonArray>();
+    for (uint8_t i = 0; i < Hoymiles.getNumInverters(); i++) {
+        auto inv = Hoymiles.getInverterByPos(i);
+        if (!inv) continue;
+        auto icfg = Configuration.getInverterConfig(inv->serial());
+        const String ser = serialStr(inv->serial());
+        auto io = invs.add<JsonObject>();
+        io["serial"] = ser;
+        io["name"] = inv->name();
+        io["type"] = inv->typeName();
+        auto chs = io["channels"].to<JsonArray>();
+        for (auto& c : inv->Statistics()->getChannelsByType(TYPE_DC)) {
+            const MpptCfg mc = getCfg(ser, static_cast<uint8_t>(c));
+            auto co = chs.add<JsonObject>();
+            co["ch"] = static_cast<uint8_t>(c) + 1;
+            co["name"] = icfg ? String(icfg->channel[c].Name) : String();
+            co["series"] = mc.series;
+            auto ps = co["panels"].to<JsonArray>();
+            for (auto& p : mc.panel) {
+                auto po = ps.add<JsonObject>();
+                po["name"] = p.name;
+                po["wp"] = p.wp;
+                po["vmp"] = p.vmp;
+            }
+        }
+    }
+}
+
+// POST: { "<serial>": [ {series, panels:[{name,wp,vmp},{...}]}, ... ] }
+bool HoymilesChannelsClass::configFromJson(JsonObjectConst root)
+{
+    std::lock_guard<std::mutex> lock(_mutex);
+    JsonDocument n;
+    auto no = n.to<JsonObject>();
+    for (JsonPairConst kv : root) {
+        JsonArrayConst chs = kv.value();
+        if (chs.isNull() || chs.size() > 8) return false;
+        auto a = no[kv.key()].to<JsonArray>();
+        for (JsonVariantConst c : chs) {
+            auto co = a.add<JsonObject>();
+            co["series"] = c["series"] | true;
+            auto ps = co["panels"].to<JsonArray>();
+            JsonArrayConst ip = c["panels"];
+            for (uint8_t k = 0; k < MPPT_MAX_PANELS; k++) {
+                auto po = ps.add<JsonObject>();
+                String nm = ip[k]["name"] | "";
+                if (nm.length() > 24) nm = nm.substring(0, 24);
+                po["name"] = nm;
+                po["wp"] = constrain((int)(ip[k]["wp"] | 0), 0, 2000);
+                po["vmp"] = constrain((float)(ip[k]["vmp"] | 0.0f), 0.0f, 140.0f);
+            }
+        }
+    }
+    _cfg = n;
+    return save();
+}
diff --git a/src/SdLogger.cpp b/src/SdLogger.cpp
new file mode 100644
index 0000000..7fbea58
--- /dev/null
+++ b/src/SdLogger.cpp
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "SdLogger.h"
+#include "Datastore.h"
+#include "EnergyHistory.h"
+#include "HoymilesChannels.h"
+#include "SolarEdge.h"
+#include <ArduinoJson.h>
+#include <FS.h>
+#include <LittleFS.h>
+#include <SD_MMC.h>
+#include <cmath>
+#include <time.h>
+
+#undef TAG
+static const char* TAG = "sdlog";
+
+#define SD_CFG_FILE "/sdlog.json"
+
+#if SD_CSV_DECIMAL_COMMA
+static const char SEP = ';';
+#else
+static const char SEP = ',';
+#endif
+
+SdLoggerClass SdLogger;
+
+SdLoggerClass::SdLoggerClass()
+    : _loopTask(5 * TASK_SECOND, TASK_FOREVER, std::bind(&SdLoggerClass::loop, this))
+{
+}
+
+void SdLoggerClass::init(Scheduler& scheduler)
+{
+    loadConfig();
+
+    // SDMMC host (1-bit) via GPIO matrix: does not use any SPI host,
+    // so NRF24, CMT2300A and W5500 (PoE) all keep working.
+    if (SD_PIN_D3 >= 0) { // otherwise DAT3/CS is pulled up by a resistor
+        pinMode(SD_PIN_D3, OUTPUT);
+        digitalWrite(SD_PIN_D3, HIGH); // DAT3/CS high = SD mode, not SPI mode
+    }
+    pinMode(SD_PIN_CMD, INPUT_PULLUP);
+    pinMode(SD_PIN_D0, INPUT_PULLUP);
+    if (!SD_MMC.setPins(SD_PIN_CLK, SD_PIN_CMD, SD_PIN_D0)) {
+        _reason = "SDMMC pin setup failed";
+        ESP_LOGW(TAG, "%s", _reason.c_str());
+        return;
+    }
+    _busOk = true;
+
+    mount();
+    scheduler.addTask(_loopTask);
+    _loopTask.enable();
+}
+
+bool SdLoggerClass::mount()
+{
+    std::lock_guard<std::mutex> lock(_fsMutex);
+    _lastMountTry = millis();
+    if (!SD_MMC.begin("/sd", true, false, SD_MMC_FREQ_KHZ, 5)) {
+        SD_MMC.end();
+        _mounted = false;
+        _reason = "no card / card not readable (FAT32/exFAT)";
+        return false;
+    }
+    if (SD_MMC.cardType() == CARD_NONE) {
+        SD_MMC.end();
+        _mounted = false;
+        _reason = "no card";
+        return false;
+    }
+    if (!SD_MMC.exists(SD_LOG_ROOT)) {
+        SD_MMC.mkdir(SD_LOG_ROOT);
+    }
+    _mounted = true;
+    _reason = "";
+    ESP_LOGI(TAG, "SD mounted, %llu MB", SD_MMC.cardSize() / (1024ULL * 1024ULL));
+    return true;
+}
+
+void SdLoggerClass::unmount(const char* reason)
+{
+    SD_MMC.end();
+    _mounted = false;
+    _reason = reason;
+    ESP_LOGW(TAG, "SD unmounted: %s", reason);
+}
+
+// ------------------------------------------------------------- config
+void SdLoggerClass::loadConfig()
+{
+    File f = LittleFS.open(SD_CFG_FILE, "r", false);
+    if (!f) return;
+    JsonDocument doc;
+    if (!deserializeJson(doc, f)) {
+        _enabled = doc["enabled"] | true;
+        _intervalMin = doc["interval"] | SD_DEFAULT_INTERVAL_MIN;
+        strlcpy(_lastSummary, doc["last_summary"] | "", sizeof(_lastSummary));
+    }
+    f.close();
+}
+
+bool SdLoggerClass::saveConfig()
+{
+    JsonDocument doc;
+    doc["enabled"] = _enabled;
+    doc["interval"] = _intervalMin;
+    doc["last_summary"] = _lastSummary;
+    File f = LittleFS.open(SD_CFG_FILE, "w");
+    if (!f) return false;
+    const bool ok = serializeJson(doc, f) > 0;
+    f.close();
+    return ok;
+}
+
+bool SdLoggerClass::setConfig(bool enabled, uint16_t intervalMin)
+{
+    if (intervalMin < 1) intervalMin = 1;
+    if (intervalMin > 60) intervalMin = 60;
+    _enabled = enabled;
+    _intervalMin = intervalMin;
+    _lastSlot = -1;
+    return saveConfig();
+}
+
+SdStatus SdLoggerClass::getStatus()
+{
+    SdStatus s;
+    s.compiled = _busOk;
+    s.mounted = _mounted;
+    s.reason = _reason;
+    s.enabled = _enabled;
+    s.intervalMin = _intervalMin;
+    s.lastWrite = _lastWrite;
+    s.writeErrors = _writeErrors;
+    if (_mounted) {
+        std::lock_guard<std::mutex> lock(_fsMutex);
+        switch (SD_MMC.cardType()) {
+        case CARD_MMC: s.cardType = "MMC"; break;
+        case CARD_SD: s.cardType = "SD"; break;
+        case CARD_SDHC: s.cardType = "SDHC/SDXC"; break;
+        default: s.cardType = "?";
+        }
+        s.totalBytes = SD_MMC.totalBytes();
+        s.usedBytes = SD_MMC.usedBytes();
+    }
+    return s;
+}
+
+bool SdLoggerClass::isSafePath(const String& path)
+{
+    return path.startsWith(SD_LOG_ROOT) && path.indexOf("..") < 0 && path.indexOf("//") < 0;
+}
+
+// ---------------------------------------------------------------- write
+String SdLoggerClass::num(float v, uint8_t digits)
+{
+    if (std::isnan(v) || v < -1e8) return "";
+    String s(v, (unsigned int)digits);
+#if SD_CSV_DECIMAL_COMMA
+    s.replace('.', ',');
+#endif
+    return s;
+}
+
+bool SdLoggerClass::appendLine(const String& path, const String& header, const String& line)
+{
+    std::lock_guard<std::mutex> lock(_fsMutex);
+    const int slash = path.lastIndexOf('/');
+    if (slash > 0) {
+        const String dir = path.substring(0, slash);
+        if (!SD_MMC.exists(dir)) SD_MMC.mkdir(dir);
+    }
+    const bool isNew = !SD_MMC.exists(path);
+    File f = SD_MMC.open(path, FILE_APPEND);
+    if (!f) return false;
+    bool ok = true;
+    if (isNew) {
+        f.write(0xEF); f.write(0xBB); f.write(0xBF); // UTF-8 BOM -> Excel shows Polish chars
+        ok &= f.print(header) > 0;
+        ok &= f.print("\r\n") > 0;
+    }
+    ok &= f.print(line) > 0;
+    ok &= f.print("\r\n") > 0;
+    f.close();
+    return ok;
+}
+
+void SdLoggerClass::writeSample(const struct tm& t)
+{
+    char date[11], ts[20], path[40];
+    strftime(date, sizeof(date), "%Y-%m-%d", &t);
+    strftime(ts, sizeof(ts), "%Y-%m-%d %H:%M", &t);
+    snprintf(path, sizeof(path), SD_LOG_ROOT "/%.4s/%s.csv", date, date);
+
+    const SolarEdgeData d = SolarEdge.getData();
+    const EnergyRecord today = EnergyHistory.getToday();
+    const Counters c = EnergyHistory.getLastCounters();
+    const float hoyW = Datastore.getTotalAcPowerEnabled();
+    const float hoyDcW = Datastore.getTotalDcPowerEnabled();
+    const float seW = d.valid ? d.acPower : 0;
+
+    String h;
+    const char* cols[] = { "czas", "hoymiles_W", "hoymiles_DC_W", "solaredge_W", "razem_W", "siec_W",
+        "hoymiles_dzis_kWh", "solaredge_dzis_kWh", "razem_dzis_kWh", "eksport_dzis_kWh", "import_dzis_kWh",
+        "hoymiles_licznik_kWh", "solaredge_licznik_kWh", "solaredge_status", "solaredge_temp_C",
+        "solaredge_DC_V", "napiecie_L1_V", "napiecie_L2_V", "napiecie_L3_V", "czestotliwosc_Hz" };
+    for (size_t i = 0; i < sizeof(cols) / sizeof(cols[0]); i++) {
+        if (i) h += SEP;
+        h += cols[i];
+    }
+
+    const auto mppt = HoymilesChannels.read();
+    for (auto& m : mppt) {
+        char pre[24];
+        snprintf(pre, sizeof(pre), "%cinw%u_mppt%u_", SEP, m.invIndex, m.channel);
+        h += pre; h += "U_V";
+        h += pre; h += "I_A";
+        h += pre; h += "P_W";
+        h += pre; h += "dzis_Wh";
+        for (uint8_t k = 0; k < m.panels.size(); k++) {
+            char pp[40];
+            snprintf(pp, sizeof(pp), "%cinw%u_mppt%u_panel%u_P_W_szac", SEP, m.invIndex, m.channel, k + 1);
+            h += pp;
+        }
+    }
+
+    String l;
+    l.reserve(200 + mppt.size() * 30);
+    l += ts; l += SEP;
+    l += num(hoyW, 1); l += SEP;
+    l += num(hoyDcW, 1); l += SEP;
+    l += d.valid ? num(seW, 1) : ""; l += SEP;
+    l += num(hoyW + seW, 1); l += SEP;
+    l += d.meterValid ? num(d.meterPower, 1) : ""; l += SEP;
+    l += num(today.hoy, 3); l += SEP;
+    l += num(today.se, 3); l += SEP;
+    l += num(today.hoy + today.se, 3); l += SEP;
+    l += today.exp >= 0 ? num(today.exp, 3) : ""; l += SEP;
+    l += today.imp >= 0 ? num(today.imp, 3) : ""; l += SEP;
+    l += c.hoy >= 0 ? num(c.hoy, 3) : ""; l += SEP;
+    l += c.se >= 0 ? num(c.se, 3) : ""; l += SEP;
+    l += d.valid ? SolarEdgeClass::statusToString(d.status) : "offline"; l += SEP;
+    l += d.valid ? num(d.heatsinkTemp, 1) : ""; l += SEP;
+    l += d.valid ? num(d.dcVoltage, 1) : ""; l += SEP;
+    l += d.valid ? num(d.acVoltageAN, 1) : ""; l += SEP;
+    l += d.valid ? num(d.acVoltageBN, 1) : ""; l += SEP;
+    l += d.valid ? num(d.acVoltageCN, 1) : ""; l += SEP;
+    l += d.valid ? num(d.acFrequency, 2) : "";
+    for (auto& m : mppt) {
+        l += SEP; l += m.reachable ? num(m.u, 1) : "";
+        l += SEP; l += m.reachable ? num(m.i, 2) : "";
+        l += SEP; l += m.reachable ? num(m.p, 1) : "";
+        l += SEP; l += num(m.yieldDay, 0);
+        for (auto& e : m.panels) { l += SEP; l += m.reachable ? num(e.p, 1) : ""; }
+    }
+
+    if (appendLine(path, h, l)) {
+        _lastWrite = ts;
+    } else {
+        _writeErrors++;
+        unmount("write failed (card removed?)");
+    }
+}
+
+void SdLoggerClass::writeDaySummary(const EnergyRecord& r)
+{
+    String h = String("dzien") + SEP + "hoymiles_kWh" + SEP + "solaredge_kWh" + SEP + "razem_kWh" + SEP
+        + "eksport_kWh" + SEP + "import_kWh" + SEP + "hoymiles_max_W" + SEP + "solaredge_max_W";
+    String l = String(r.key) + SEP + num(r.hoy, 3) + SEP + num(r.se, 3) + SEP + num(r.hoy + r.se, 3) + SEP
+        + (r.exp >= 0 ? num(r.exp, 3) : "") + SEP + (r.imp >= 0 ? num(r.imp, 3) : "") + SEP
+        + num(r.hoyPeak, 0) + SEP + num(r.sePeak, 0);
+    if (!appendLine(SD_LOG_ROOT "/dni.csv", h, l)) {
+        _writeErrors++;
+        unmount("write failed (card removed?)");
+        return;
+    }
+    strlcpy(_lastSummary, r.key, sizeof(_lastSummary));
+    saveConfig();
+}
+
+void SdLoggerClass::loop()
+{
+    if (!_busOk || !_enabled) return;
+
+    if (!_mounted) {
+        if (millis() - _lastMountTry > 30000) mount(); // hot-plug: retry every 30 s
+        return;
+    }
+
+    struct tm t;
+    if (!getLocalTime(&t, 5) || t.tm_year < (2024 - 1900)) return;
+
+    // daily summary: every day closed by EnergyHistory (also after reboot / card swap)
+    EnergyRecord closed;
+    if (EnergyHistory.getLastClosedDay(closed) && strcmp(closed.key, _lastSummary) > 0) {
+        writeDaySummary(closed);
+        if (!_mounted) return;
+    }
+
+    const int slot = (t.tm_hour * 60 + t.tm_min) / _intervalMin;
+    if (slot != _lastSlot) {
+        _lastSlot = slot;
+        writeSample(t);
+    }
+}
