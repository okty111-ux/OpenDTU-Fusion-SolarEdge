diff --git a/include/FusionDisplay.h b/include/FusionDisplay.h
new file mode 100644
index 0000000..b27a2d0
--- /dev/null
+++ b/include/FusionDisplay.h
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * SSD1322 256x64 OLED with several pages, switched with a push button.
+ *
+ * Wiring (Fusion v2 SPI display header, display in 4-wire SPI mode):
+ *   DIN/SDA GPIO9, SCLK GPIO10, CS GPIO11, DC GPIO12, RES GPIO13, VCC 3V3, GND
+ * Button: on-board BOOT button (GPIO0) or an external push button GPIO0 -> GND.
+ *   short press  = next page (and wake the screen)
+ *   long press   = automatic page switching on/off
+ *
+ * Both hardware SPI hosts of the ESP32-S3 are taken by NRF24/CMT2300A/W5500,
+ * therefore the display is driven by a fast register based software SPI.
+ * Config: LittleFS /display.json
+ */
+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <TaskSchedulerDeclarations.h>
+#include <mutex>
+
+struct FdData;
+
+#ifndef FD_PIN_MOSI
+#define FD_PIN_MOSI 9
+#endif
+#ifndef FD_PIN_SCK
+#define FD_PIN_SCK 10
+#endif
+#ifndef FD_PIN_CS
+#define FD_PIN_CS 11
+#endif
+#ifndef FD_PIN_DC
+#define FD_PIN_DC 12
+#endif
+#ifndef FD_PIN_RST
+#define FD_PIN_RST 13
+#endif
+#ifndef FD_PIN_BUTTON
+#define FD_PIN_BUTTON 0
+#endif
+
+struct FusionDisplayConfig {
+    bool enabled = false;
+    uint16_t autoSec = 10;  // 0 = no automatic switching
+    uint16_t sleepMin = 10; // screen off at night after N min without button, 0 = never
+    uint8_t contrast = 160; // 0..255
+    bool flip = false;      // rotate 180°
+    uint8_t pages = 0x7F;   // bit mask of enabled pages
+};
+
+class FusionDisplayClass {
+public:
+    FusionDisplayClass();
+    void init(Scheduler& scheduler);
+    FusionDisplayConfig getConfig();
+    bool setConfig(const FusionDisplayConfig& c);
+    void toJson(JsonObject root);
+    void nextPage(); // also from the web UI
+
+private:
+    void loop();
+    void begin();
+    void draw();
+    void collect(FdData& d);
+    bool producing();
+    void loadConfig();
+    bool saveConfig();
+    uint8_t nextAvailable(const FdData& d, uint8_t from);
+
+    std::mutex _mutex;
+    FusionDisplayConfig _cfg;
+    Task _loopTask;
+    void* _u8g2 = nullptr; // u8g2_t*
+    bool _started = false;
+    bool _sleeping = false;
+    bool _autoOn = true;
+    uint8_t _page = 0;
+    uint32_t _lastDraw = 0, _lastSwitch = 0, _lastActivity = 0;
+    uint32_t _overlayUntil = 0;
+    String _ov1, _ov2;
+    bool _btnDown = false, _btnLongDone = false;
+    uint32_t _btnSince = 0, _btnChange = 0;
+    volatile bool _webNext = false;
+};
+
+extern FusionDisplayClass FusionDisplay;
diff --git a/include/FusionDisplayPages.h b/include/FusionDisplayPages.h
new file mode 100644
index 0000000..831e843
--- /dev/null
+++ b/include/FusionDisplayPages.h
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Page rendering for the SSD1322 256x64 OLED (U8g2 C API only, no Arduino
+ * dependencies -> the same code is compiled natively for preview images).
+ */
+#pragma once
+#include <stdint.h>
+#include "clib/u8g2.h"
+
+#define FD_MAX_MPPT 8
+
+enum FdPage : uint8_t {
+    FD_PAGE_POWER = 0, // total production now + today
+    FD_PAGE_GRID,      // SolarEdge meter: export/import
+    FD_PAGE_MPPT,      // Hoymiles MPPT U/I/P/today
+    FD_PAGE_PANELS,    // per-panel estimate
+    FD_PAGE_SOLAREDGE, // SolarEdge inverter details
+    FD_PAGE_HISTORY,   // yesterday / month / year / lifetime
+    FD_PAGE_STATUS,    // IP, network, SD, inverters
+    FD_PAGE_COUNT
+};
+
+struct FdPanel {
+    char name[12];
+    uint16_t wp;
+    float p;
+};
+
+struct FdMppt {
+    uint8_t inv, ch;
+    bool reachable;
+    float u, i, p, yd; // V, A, W, Wh
+    uint8_t panelCount;
+    FdPanel panel[2];
+};
+
+struct FdData {
+    char clock[6];      // "14:35"
+    char date[11];      // "12.11.2026"
+    bool timeValid;
+
+    float hoyW, seW;
+    bool hoyReachable, seConfigured, seValid;
+    float todayHoy, todaySe;        // kWh, <0 unknown
+    float peakW;
+
+    bool meterValid;
+    float gridW;                    // + export, - import
+    float todayExp, todayImp;       // kWh, <0 unknown
+
+    uint8_t mpptCount;
+    bool multiInverter;
+    FdMppt mppt[FD_MAX_MPPT];
+
+    char seStatus[16];
+    float seTemp, seTotalKWh, seDcV;
+    char seModel[20];
+
+    bool hasYesterday;
+    float yHoy, ySe, mHoy, mSe, yrHoy, yrSe, ltHoy, ltSe; // kWh, <0 unknown
+
+    char ip[16];
+    char net[24];       // "Wi-Fi -61 dBm" / "Ethernet"
+    char sd[32];        // "29,7 GB, wolne 28,1 GB" / "brak karty"
+    uint8_t invOnline, invTotal;
+    uint32_t uptimeS;
+};
+
+#ifdef __cplusplus
+extern "C++" {
+#endif
+// true if the page has data to show (others are skipped while switching)
+bool fdPageAvailable(const FdData& d, uint8_t page);
+// draws page into the u8g2 buffer (caller clears/sends)
+void fdRenderPage(u8g2_t* u, const FdData& d, uint8_t page, uint8_t pageNo, uint8_t pageCnt, bool autoRotate);
+// centered message box drawn on top (button feedback)
+void fdRenderOverlay(u8g2_t* u, const char* line1, const char* line2);
+// night / no-data clock screen
+const char* fdPageTitle(uint8_t page);
+#ifdef __cplusplus
+}
+#endif
