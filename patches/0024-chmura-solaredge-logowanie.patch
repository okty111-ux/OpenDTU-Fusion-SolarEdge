 // ---------------------------------------------------------------- OAuth
+static bool has(const String& h, const char* s) { return h.indexOf(s) >= 0; }
+
+// readable reason why the portal did not give an authorization code.
+// The sign-in page (AWS Cognito managed login, a Remix app) carries all its
+// translations, so plain keyword search on the page means nothing: the result of
+// the form post is in window.__remixContext ... "actionData":{...}, and a further
+// step (verification code, new password) shows as a different page path.
+static String loginFailText(const HttpCtx& ctx, int st, const String& lastUrl, size_t fields)
+{
+    String path = ctx.location.length() ? ctx.location : lastUrl;
+    int q = path.indexOf('?');
+    if (q >= 0) path = path.substring(0, q);
+    q = path.indexOf("://");
+    if (q >= 0) {
+        const int sl = path.indexOf('/', q + 3);
+        path = sl >= 0 ? path.substring(sl) : String("/");
+    }
+    String ad;
+    int p = ctx.body.indexOf("\"actionData\":");
+    if (p >= 0) {
+        p += 13;
+        if (!ctx.body.substring(p, p + 4).equals("null")) ad = ctx.body.substring(p, p + 300);
+    }
+    String low = ad;
+    low.toLowerCase();
+    String lp = path;
+    lp.toLowerCase();
+    String why;
+    if (has(low, "usernameorpassword") || has(low, "incorrect"))
+        why = "nieprawidłowy e-mail lub hasło";
+    else if (has(low, "attemptsexceeded") || has(low, "attempts exceeded") || has(low, "too many") || has(low, "limitexceeded"))
+        why = "portal zablokował logowanie po zbyt wielu próbach – odczekaj kilka godzin";
+    else if (has(low, "usernotfound") || has(low, "does not exist"))
+        why = "nie ma konta z tym e-mailem";
+    else if (has(low, "captcha") || has(lp, "captcha"))
+        why = "portal żąda CAPTCHA – zaloguj się raz w przeglądarce i spróbuj ponownie";
+    else if (has(lp, "mfa") || has(lp, "otp") || has(lp, "code") || has(lp, "verify") || has(lp, "totp") || has(lp, "sms"))
+        why = "portal wymaga kodu weryfikacyjnego (2FA) – wyłącz weryfikację dwuetapową na koncie";
+    else if (has(lp, "password") && !has(lp, "login"))
+        why = "portal wymaga zmiany hasła – zaloguj się w przeglądarce i ustaw nowe";
+    else
+        why = "portal nie przyjął logowania";
+    String s = String("Logowanie: ") + why + " (HTTP " + String(st) + ", " + path.substring(0, 50) + ", pól " + String((unsigned)fields) + ")";
+    if (ad.length() && why.endsWith("logowania")) {
+        // unknown answer: show it, it helps to adapt the login
+        String t;
+        for (size_t i = 0; i < ad.length() && t.length() < 160; i++) {
+            const char c = ad[i];
+            if (c == '"' || c == '{' || c == '}' || c == '\\') continue;
+            t += c;
+        }
+        s += " – odpowiedź: ";
+        s += t;
+    }
+    return s;
+}
