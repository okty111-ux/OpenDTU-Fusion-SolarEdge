+// outdoor weather for the house location (lat/lon from the OpenDTU time settings), Open-Meteo, cached 15 min
+const WX={c:{0:['☀️','bezchmurnie'],1:['🌤️','prawie bezchmurnie'],2:['⛅','częściowe zachmurzenie'],3:['☁️','pochmurno'],45:['🌫️','mgła'],48:['🌫️','szadź'],
+  51:['🌦️','mżawka'],53:['🌦️','mżawka'],55:['🌦️','mżawka'],56:['🌧️','marznąca mżawka'],57:['🌧️','marznąca mżawka'],61:['🌧️','słaby deszcz'],63:['🌧️','deszcz'],65:['🌧️','ulewa'],
+  66:['🌧️','marznący deszcz'],67:['🌧️','marznący deszcz'],71:['🌨️','słaby śnieg'],73:['🌨️','śnieg'],75:['❄️','intensywny śnieg'],77:['🌨️','ziarna śniegu'],
+  80:['🌦️','przelotny deszcz'],81:['🌦️','przelotny deszcz'],82:['⛈️','ulewa'],85:['🌨️','przelotny śnieg'],86:['🌨️','przelotny śnieg'],95:['⛈️','burza'],96:['⛈️','burza z gradem'],99:['⛈️','burza z gradem']},busy:false};
+function wxShow(d){
+  const c=WX.c[d.code]||['🌡️',''],ic=(d.code<=2&&!d.day)?'🌙':c[0];
+  $('heroWx').innerHTML=`<span class="wi">${ic}</span><span><b>${nf(d.t,0)}°C</b><small>${esc(c[1])}${d.app!=null?' · odczuwalna '+nf(d.app,0)+'°':''}${d.wind!=null?' · wiatr '+nf(d.wind,0)+' km/h':''}</small></span>`;
+}
+async function weather(h){
+  const el=$('heroWx');if(!el)return;
+  if(h.lat==null||h.lon==null){el.innerHTML='<span class="wi">🌡️</span><span><small>Ustaw położenie domu: OpenDTU → Ustawienia → Czas (szer./dł. geogr.)</small></span>';return;}
+  const key='fz_wx',now=Date.now();let c=null;
+  try{c=JSON.parse(localStorage.getItem(key)||'null');}catch(e){}
+  if(c&&c.lat===h.lat&&c.lon===h.lon&&now-c.ts<15*60000){wxShow(c);return;}
+  if(c&&c.lat===h.lat&&c.lon===h.lon)wxShow(c);
+  if(WX.busy)return;WX.busy=true;
+  try{const r=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${h.lat}&longitude=${h.lon}&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m,is_day&timezone=auto`);
+    const j=await r.json(),cu=j.current||{};
+    if(cu.temperature_2m!=null){const d={lat:h.lat,lon:h.lon,ts:now,t:cu.temperature_2m,app:cu.apparent_temperature,code:cu.weather_code,wind:cu.wind_speed_10m,day:cu.is_day===1};
+      wxShow(d);try{localStorage.setItem(key,JSON.stringify(d));}catch(e){}}}
+  catch(e){if(!c)el.innerHTML='';}
+  finally{WX.busy=false;}
+}
 let tMode='days';
 function tables(){
   if(!H)return;const row=(l,r,c='')=>`<tr class="${c}"><td>${l}</td><td>${num(r.h)}</td><td>${num(r.s)}</td><td>${num(sum(r))}</td><td>${num(r.e)}</td><td>${num(r.i)}</td></tr>`;
