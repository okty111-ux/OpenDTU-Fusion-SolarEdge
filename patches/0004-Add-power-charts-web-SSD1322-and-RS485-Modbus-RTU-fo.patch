+  for(let i=Math.floor(h0*per);i<Math.min(n,h1*per);i++){const ok=!(hoy[i]===null&&se[i]===null)&&i<(d&&pwDay===0?d.slot+1:n);if(ok){if(!cur){cur=[];runs.push(cur);}cur.push(i);}else cur=null;}
