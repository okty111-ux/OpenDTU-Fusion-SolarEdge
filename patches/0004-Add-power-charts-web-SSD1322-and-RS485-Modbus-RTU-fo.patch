+  const per=60/step;let h0=6,h1=20;
+  if(first>=0){h0=Math.max(0,Math.floor(first/per)-1);h1=Math.min(24,Math.ceil((last+1)/per)+1);if(h1-h0<8){const c=(h0+h1)/2;h0=Math.max(0,Math.floor(c-4));h1=Math.min(24,h0+8);}}
