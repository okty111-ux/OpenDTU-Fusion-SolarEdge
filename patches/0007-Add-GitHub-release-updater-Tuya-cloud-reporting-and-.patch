+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * TuyaLink MQTT (https://developer.tuya.com/en/docs/iot/MQTT-protocol?id=Kb65nphxrj8f1)
+ *   host     m1.tuyaeu.com:8883 (TLS)
+ *   clientId tuyalink_<deviceId>
+ *   username <deviceId>|signMethod=hmacSha256,timestamp=<s>,secureMode=1,accessType=1
+ *   password hex(HMAC-SHA256(deviceSecret,
+ *            "deviceId=<id>,timestamp=<s>,secureMode=1,accessType=1"))
+ *   publish  tylink/<deviceId>/thing/property/report
+ *
+ * Properties (TuyaLink thing model, all type "value", scale 0, read-only):
+ *   pv_power          W   total production (Hoymiles + SolarEdge)
+ *   hoymiles_power    W
+ *   solaredge_power   W
+ *   grid_power        W   + export / - import (SolarEdge meter)
+ *   energy_today      Wh  production today
+ *   energy_month      kWh production this month
+ *   energy_total      kWh lifetime production
+ */
+#include "FusionTuya.h"
+#include "Datastore.h"
+#include "EnergyHistory.h"
+#include <esp_log.h>
+#include "SolarEdge.h"
+#include <LittleFS.h>
+#include <mbedtls/md.h>
+#include <mqtt_client.h>
+
+extern "C" esp_err_t esp_crt_bundle_attach(void* conf);
+
+#undef TAG
+static const char* TAG = "tuya";
+
+FusionTuyaClass FusionTuya;
+
+#define TUYA_CFG_FILE "/fusion_tuya.json"
+
+String FusionTuyaClass::host(const String& r)
+{
+    if (r == "us") return "m1.tuyaus.com";
+    if (r == "us-e") return "m1-ueaz.tuyaus.com";
+    if (r == "eu-w") return "m1-weaz.tuyaeu.com";
+    if (r == "cn") return "m1.tuyacn.com";
+    if (r == "in") return "m1.tuyain.com";
+    return "m1.tuyaeu.com";
+}
+
+static String hmacHex(const String& key, const String& msg)
+{
+    uint8_t out[32];
+    mbedtls_md_context_t ctx;
+    mbedtls_md_init(&ctx);
+    mbedtls_md_setup(&ctx, mbedtls_md_info_from_type(MBEDTLS_MD_SHA256), 1);
+    mbedtls_md_hmac_starts(&ctx, (const uint8_t*)key.c_str(), key.length());
+    mbedtls_md_hmac_update(&ctx, (const uint8_t*)msg.c_str(), msg.length());
+    mbedtls_md_hmac_finish(&ctx, out);
+    mbedtls_md_free(&ctx);
+    char hex[65];
+    for (int i = 0; i < 32; i++) sprintf(hex + 2 * i, "%02x", out[i]);
+    return String(hex);
+}
+
+static void mqttHandler(void* arg, esp_event_base_t, int32_t id, void* data)
+{
+    static_cast<FusionTuyaClass*>(arg)->onEvent(id, data);
+}
+
+void FusionTuyaClass::load()
+{
+    File f = LittleFS.open(TUYA_CFG_FILE, "r");
+    if (!f) return;
+    JsonDocument d;
+    if (!deserializeJson(d, f)) {
+        _cfg.enabled = d["enabled"] | false;
+        _cfg.region = d["region"] | "eu";
+        _cfg.deviceId = d["device_id"] | "";
+        _cfg.secret = d["secret"] | "";
+        _cfg.interval = constrain((int)(d["interval"] | 60), 10, 3600);
+    }
+    f.close();
+}
+
+void FusionTuyaClass::init(Scheduler& scheduler)
+{
+    load();
+    scheduler.addTask(_loopTask);
+    _loopTask.setCallback(std::bind(&FusionTuyaClass::loop, this));
+    _loopTask.setIterations(TASK_FOREVER);
+    _loopTask.setInterval(TASK_SECOND);
+    _loopTask.enable();
+}
+
+FusionTuyaConfig FusionTuyaClass::getConfig()
+{
+    std::lock_guard<std::mutex> l(_mutex);
+    return _cfg;
+}
+
+bool FusionTuyaClass::setConfig(const FusionTuyaConfig& in, bool keepSecret)
+{
+    FusionTuyaConfig c = in;
+    c.deviceId.trim();
+    c.secret.trim();
+    c.interval = constrain((int)c.interval, 10, 3600);
+    {
+        std::lock_guard<std::mutex> l(_mutex);
+        if (keepSecret) c.secret = _cfg.secret;
+        _cfg = c;
+        _restart = true;
+        _lastErr = "";
+    }
+    File f = LittleFS.open(TUYA_CFG_FILE, "w");
+    if (!f) return false;
+    JsonDocument d;
+    d["enabled"] = c.enabled;
+    d["region"] = c.region;
+    d["device_id"] = c.deviceId;
+    d["secret"] = c.secret;
+    d["interval"] = c.interval;
+    serializeJson(d, f);
+    f.close();
+    return true;
+}
+
+void FusionTuyaClass::disconnect()
+{
+    if (!_client) return;
+    auto c = (esp_mqtt_client_handle_t)_client;
+    _client = nullptr;
+    _connected = false;
+    esp_mqtt_client_stop(c);
+    esp_mqtt_client_destroy(c);
+}
+
+void FusionTuyaClass::connect()
+{
+    const FusionTuyaConfig c = getConfig();
+    const time_t ts = time(nullptr);
+    const String tss = String((uint32_t)ts);
+    static String uri, cid, user, pass; // must outlive esp_mqtt_client_init
+    uri = "mqtts://" + host(c.region) + ":8883";
+    cid = "tuyalink_" + c.deviceId;
+    user = c.deviceId + "|signMethod=hmacSha256,timestamp=" + tss + ",secureMode=1,accessType=1";
+    pass = hmacHex(c.secret, "deviceId=" + c.deviceId + ",timestamp=" + tss + ",secureMode=1,accessType=1");
+    _topicReport = "tylink/" + c.deviceId + "/thing/property/report";
+    _topicResp = "tylink/" + c.deviceId + "/thing/property/report_response";
+
+    esp_mqtt_client_config_t m = {};
+    m.uri = uri.c_str();
+    m.client_id = cid.c_str();
+    m.username = user.c_str();
+    m.password = pass.c_str();
+    m.keepalive = 60;
+    m.disable_auto_reconnect = true; // fresh signature on every connect
+    m.crt_bundle_attach = esp_crt_bundle_attach;
+    m.network_timeout_ms = 15000;
+    m.buffer_size = 1536;
+    m.task_stack = 6144;
+    auto h = esp_mqtt_client_init(&m);
+    if (!h) {
+        _lastErr = "brak pamięci dla klienta MQTT";
+        return;
+    }
+    esp_mqtt_client_register_event(h, (esp_mqtt_event_id_t)ESP_EVENT_ANY_ID, mqttHandler, this);
+    _client = h;
+    esp_mqtt_client_start(h);
+    ESP_LOGI(TAG, "Tuya: connecting to %s as %s", uri.c_str(), cid.c_str());
+}
+
+void FusionTuyaClass::onEvent(int32_t id, void* data)
+{
+    auto ev = (esp_mqtt_event_handle_t)data;
+    switch ((esp_mqtt_event_id_t)id) {
+    case MQTT_EVENT_CONNECTED:
+        _connected = true;
+        _retry = 5000;
+        esp_mqtt_client_subscribe(ev->client, _topicResp.c_str(), 1);
+        {
+            std::lock_guard<std::mutex> l(_mutex);
+            _lastErr = "";
+        }
+        _forceReport = true;
+        break;
+    case MQTT_EVENT_DISCONNECTED:
+        _connected = false;
+        break;
+    case MQTT_EVENT_ERROR: {
+        std::lock_guard<std::mutex> l(_mutex);
+        if (ev->error_handle->error_type == MQTT_ERROR_TYPE_CONNECTION_REFUSED) {
+            const int rc = ev->error_handle->connect_return_code;
+            _lastErr = rc == 4 || rc == 5 ? "Tuya odrzuciła logowanie (sprawdź Device ID, Device Secret i region)"
+                                          : "Tuya odrzuciła połączenie, kod " + String(rc);
+        } else {
+            _lastErr = "błąd połączenia TLS/TCP z " + host(_cfg.region) + " (esp_err 0x" + String(ev->error_handle->esp_tls_last_esp_err, HEX) + ")";
+        }
+        _connected = false;
+        break;
+    }
+    case MQTT_EVENT_DATA: {
+        JsonDocument d;
+        if (!deserializeJson(d, ev->data, ev->data_len)) {
+            std::lock_guard<std::mutex> l(_mutex);
+            _lastCode = d["code"] | 0;
+            if (_lastCode == 0) {
+                _acked++;
+                time(&_lastOk);
+            }
+        }
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+void FusionTuyaClass::loop()
+{
+    FusionTuyaConfig c;
+    bool restart;
+    {
+        std::lock_guard<std::mutex> l(_mutex);
+        c = _cfg;
+        restart = _restart;
+        _restart = false;
+    }
+    if (restart) disconnect();
+    const bool ready = c.enabled && c.deviceId.length() > 4 && c.secret.length() > 4;
+    if (!ready) {
+        disconnect();
+        return;
+    }
+    if (time(nullptr) < 1700000000) {
+        std::lock_guard<std::mutex> l(_mutex);
+        _lastErr = "czekam na czas z NTP";
+        return;
+    }
+    const uint32_t now = millis();
+    if (!_connected) {
+        if (_client && now - _lastTry < 20000) return; // still connecting
+        if (now - _lastTry < _retry) return;
+        disconnect();
+        _lastTry = now;
+        _retry = min<uint32_t>(_retry * 2, 300000);
+        connect();
+        return;
+    }
+    if (_forceReport || now - _lastReport >= c.interval * 1000UL) {
+        _forceReport = false;
+        _lastReport = now;
+        report();
+    }
+}
+
+void FusionTuyaClass::report()
+{
+    if (!_client) return;
+    const SolarEdgeData se = SolarEdge.getData();
+    const float hoyW = Datastore.getIsAtLeastOneReachable() ? Datastore.getTotalAcPowerEnabled() : 0;
+    const float seW = se.valid ? se.acPower : 0;
+    const EnergySummary s = EnergyHistory.getSummary();
+
+    struct timeval tv;
+    gettimeofday(&tv, nullptr);
+    const uint64_t ms = (uint64_t)tv.tv_sec * 1000ULL + tv.tv_usec / 1000;
+
+    JsonDocument d;
+    d["msgId"] = String(_sent + 1) + "-" + String((uint32_t)tv.tv_sec);
+    d["time"] = ms;
+    d["sys"]["ack"] = 1;
+    JsonObject data = d["data"].to<JsonObject>();
+    auto put = [&](const char* k, long v) {
+        JsonObject o = data[k].to<JsonObject>();
+        o["value"] = v;
+        o["time"] = ms;
+    };
+    put("pv_power", lroundf(hoyW + seW));
+    put("hoymiles_power", lroundf(hoyW));
+    put("solaredge_power", lroundf(seW));
+    if (se.valid && se.meterValid) put("grid_power", lroundf(se.meterPower));
+    if (s.valid) {
+        put("energy_today", lroundf((max(0.0f, s.today.hoy) + max(0.0f, s.today.se)) * 1000.0f));
+        put("energy_month", lroundf(max(0.0f, s.month.hoy) + max(0.0f, s.month.se)));
+        const float lt = max(0.0f, s.lifetime.hoy) + max(0.0f, s.lifetime.se);
+        if (lt > 0) put("energy_total", lroundf(lt));
+    }
+    String out;
+    serializeJson(d, out);
+    const int r = esp_mqtt_client_enqueue((esp_mqtt_client_handle_t)_client, _topicReport.c_str(), out.c_str(), out.length(), 1, 0, true);
+    std::lock_guard<std::mutex> l(_mutex);
+    if (r >= 0) {
+        _sent++;
+        _lastPayload = out;
+    } else {
+        _lastErr = "nie udało się wysłać raportu";
+    }
+}
+
+void FusionTuyaClass::statusToJson(JsonVariant root)
+{
+    std::lock_guard<std::mutex> l(_mutex);
+    root["enabled"] = _cfg.enabled;
+    root["region"] = _cfg.region;
+    root["host"] = host(_cfg.region);
+    root["device_id"] = _cfg.deviceId;
+    root["has_secret"] = _cfg.secret.length() > 0;
+    root["interval"] = _cfg.interval;
+    root["connected"] = (bool)_connected;
+    root["sent"] = _sent;
+    root["acked"] = _acked;
+    root["last_code"] = _lastCode;
+    root["last_ok"] = (uint32_t)_lastOk;
+    root["error"] = _lastErr;
+    root["payload"] = _lastPayload;
+}
diff --git a/src/FusionUpdate.cpp b/src/FusionUpdate.cpp
new file mode 100644
index 0000000..de9251d
--- /dev/null
+++ b/src/FusionUpdate.cpp
@@ -0,0 +1,507 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "FusionUpdate.h"
+#include "FusionVersion.h"
+#include <esp_log.h>
+#include "RestartHelper.h"
+#include <LittleFS.h>
+#include <esp_http_client.h>
+#include <esp_ota_ops.h>
+#include <mbedtls/sha256.h>
+
+extern "C" esp_err_t esp_crt_bundle_attach(void* conf);
+
+#undef TAG
+static const char* TAG = "fusionupd";
+
+FusionUpdateClass FusionUpdate;
+
+#define FU_CFG_FILE "/fusion_update.json"
+#define FU_FIRST_CHECK_MS (2UL * 60UL * 1000UL)
+#define FU_CHECK_EVERY_MS (24UL * 3600UL * 1000UL)
+#define FU_UA "OpenDTU-Fusion/" STR(FUSION_VERSION)
+#define STR_(x) #x
+#define STR(x) STR_(x)
+
+static const char* stateName(FuState s)
+{
+    switch (s) {
+    case FuState::Checking: return "checking";
+    case FuState::UpToDate: return "uptodate";
+    case FuState::Available: return "available";
+    case FuState::Downloading: return "downloading";
+    case FuState::Verifying: return "verifying";
+    case FuState::Done: return "done";
+    case FuState::Error: return "error";
+    default: return "idle";
+    }
+}
+
+// ---------- small esp_http_client helpers (TLS via the IDF certificate bundle)
+static esp_http_client_handle_t openUrl(const String& url, int& status, int64_t& len, const char* accept)
+{
+    String cur = url;
+    for (int hop = 0; hop < 6; hop++) {
+        esp_http_client_config_t cfg = {};
+        cfg.url = cur.c_str();
+        cfg.crt_bundle_attach = esp_crt_bundle_attach;
+        cfg.timeout_ms = 15000;
+        cfg.buffer_size = 2048;
+        cfg.buffer_size_tx = 1024;
+        cfg.disable_auto_redirect = true;
+        cfg.user_agent = "OpenDTU-Fusion";
+        esp_http_client_handle_t c = esp_http_client_init(&cfg);
+        if (!c) return nullptr;
+        if (accept) esp_http_client_set_header(c, "Accept", accept);
+        if (esp_http_client_open(c, 0) != ESP_OK) {
+            esp_http_client_cleanup(c);
+            status = -1;
+            return nullptr;
+        }
+        len = esp_http_client_fetch_headers(c);
+        status = esp_http_client_get_status_code(c);
+        if (status == 301 || status == 302 || status == 303 || status == 307 || status == 308) {
+            char* loc = nullptr;
+            esp_http_client_get_header(c, "Location", &loc);
+            String next = loc ? String(loc) : String();
+            esp_http_client_close(c);
+            esp_http_client_cleanup(c);
+            if (next.isEmpty()) {
+                status = -2;
+                return nullptr;
+            }
+            cur = next;
+            continue;
+        }
+        return c;
+    }
+    status = -3;
+    return nullptr;
+}
+
+static void closeUrl(esp_http_client_handle_t c)
+{
+    if (!c) return;
+    esp_http_client_close(c);
+    esp_http_client_cleanup(c);
+}
+
+// Stream adapter so ArduinoJson can parse the response without buffering it
+struct HttpStream : public Stream {
+    esp_http_client_handle_t c;
+    uint8_t buf[512];
+    int pos = 0, len = 0;
+    bool eof = false;
+    explicit HttpStream(esp_http_client_handle_t h) : c(h) {}
+    bool fill()
+    {
+        if (pos < len) return true;
+        if (eof) return false;
+        len = esp_http_client_read(c, (char*)buf, sizeof(buf));
+        pos = 0;
+        if (len <= 0) {
+            eof = true;
+            len = 0;
+            return false;
+        }
+        return true;
+    }
+    int available() override { return fill() ? len - pos : 0; }
+    int read() override { return fill() ? buf[pos++] : -1; }
+    int peek() override { return fill() ? buf[pos] : -1; }
+    size_t readBytes(char* b, size_t n) override
+    {
+        size_t got = 0;
+        while (got < n && fill()) {
+            size_t k = min((size_t)(len - pos), n - got);
+            memcpy(b + got, buf + pos, k);
+            pos += k;
+            got += k;
+        }
+        return got;
+    }
+    size_t write(uint8_t) override { return 0; }
+    void flush() override {}
+};
+
+// ---------------------------------------------------------------- config
+void FusionUpdateClass::loadConfig()
+{
+    _cfg.repo = FUSION_UPDATE_REPO;
+    _cfg.prefix = FUSION_TAG_PREFIX;
+    _cfg.autoCheck = true;
+    File f = LittleFS.open(FU_CFG_FILE, "r");
+    if (!f) return;
+    JsonDocument d;
+    if (!deserializeJson(d, f)) {
+        if (d["repo"].is<const char*>() && strlen(d["repo"]) > 2) _cfg.repo = d["repo"].as<String>();
+        if (d["prefix"].is<const char*>()) _cfg.prefix = d["prefix"].as<String>();
+        _cfg.autoCheck = d["auto"] | true;
+    }
+    f.close();
+}
+
+FusionUpdateConfig FusionUpdateClass::getConfig()
+{
+    std::lock_guard<std::mutex> l(_mutex);
+    return _cfg;
+}
+
+bool FusionUpdateClass::setConfig(const FusionUpdateConfig& c)
+{
+    FusionUpdateConfig n = c;
+    n.repo.trim();
+    n.prefix.trim();
+    if (n.repo.startsWith("https://github.com/")) n.repo = n.repo.substring(19);
+    while (n.repo.endsWith("/")) n.repo.remove(n.repo.length() - 1);
+    if (n.repo.endsWith(".git")) n.repo.remove(n.repo.length() - 4);
+    if (n.repo.indexOf('/') < 1 || n.repo.length() > 100 || n.prefix.length() > 24) return false;
+    {
+        std::lock_guard<std::mutex> l(_mutex);
+        _cfg = n;
+    }
+    File f = LittleFS.open(FU_CFG_FILE, "w");
+    if (!f) return false;
+    JsonDocument d;
+    d["repo"] = n.repo;
+    d["prefix"] = n.prefix;
+    d["auto"] = n.autoCheck;
+    serializeJson(d, f);
+    f.close();
+    return true;
+}
+
+// ---------------------------------------------------------------- lifecycle
+void FusionUpdateClass::init(Scheduler& scheduler)
+{
+    loadConfig();
+    _bootMs = millis();
+    scheduler.addTask(_loopTask);
+    _loopTask.setCallback(std::bind(&FusionUpdateClass::loop, this));
+    _loopTask.setIterations(TASK_FOREVER);
+    _loopTask.setInterval(10 * TASK_SECOND);
+    _loopTask.enable();
+    ESP_LOGI(TAG, "FusionUpdate: version %d, repo %s, asset %s", FUSION_VERSION, _cfg.repo.c_str(), FUSION_ASSET_NAME);
+}
+
+void FusionUpdateClass::loop()
+{
+    if (_busy || !_cfg.autoCheck) return;
+    const uint32_t now = millis();
+    const bool due = !_checkedOnce ? (now - _bootMs > FU_FIRST_CHECK_MS) : (now - _lastCheckMs > FU_CHECK_EVERY_MS);
+    if (due) requestCheck();
+}
+
+bool FusionUpdateClass::requestCheck()
+{
+    if (_busy) return false;
+    _busy = true;
+    _job = 1;
+    _checkedOnce = true;
+    _lastCheckMs = millis();
+    setState(FuState::Checking, "");
+    if (xTaskCreatePinnedToCore(taskEntry, "fusion_upd", 10240, this, 1, nullptr, 0) != pdPASS) {
+        _busy = false;
+        setState(FuState::Error, "brak pamięci na zadanie");
+        return false;
+    }
+    return true;
+}
+
+bool FusionUpdateClass::requestInstall()
+{
+    if (_busy) return false;
+    {
+        std::lock_guard<std::mutex> l(_mutex);
+        if (_binUrl.isEmpty() || _latest <= 0) return false;
+    }
+    _busy = true;
+    _job = 2;
+    setState(FuState::Downloading, "");
+    if (xTaskCreatePinnedToCore(taskEntry, "fusion_upd", 10240, this, 1, nullptr, 0) != pdPASS) {
+        _busy = false;
+        setState(FuState::Error, "brak pamięci na zadanie");
+        return false;
+    }
+    return true;
+}
+
+bool FusionUpdateClass::updateAvailable()
+{
+    std::lock_guard<std::mutex> l(_mutex);
+    return _latest > FUSION_VERSION && !_binUrl.isEmpty();
+}
+
+void FusionUpdateClass::taskEntry(void* arg)
+{
+    auto* self = static_cast<FusionUpdateClass*>(arg);
+    if (self->_job == 1) self->doCheck();
+    else if (self->_job == 2) self->doInstall();
+    self->_busy = false;
+    vTaskDelete(nullptr);
+}
+
+void FusionUpdateClass::setState(FuState s, const String& msg)
+{
+    std::lock_guard<std::mutex> l(_mutex);
+    _state = s;
+    _msg = msg;
+}
+
+// ---------------------------------------------------------------- check
+void FusionUpdateClass::doCheck()
+{
+    const FusionUpdateConfig cfg = getConfig();
+    const String url = "https://api.github.com/repos/" + cfg.repo + "/releases?per_page=20";
+    int status = 0;
+    int64_t len = 0;
+    esp_http_client_handle_t c = openUrl(url, status, len, "application/vnd.github+json");
+    if (!c) {
+        setState(FuState::Error, "brak połączenia z GitHub (sprawdź internet i DNS)");
+        return;
+    }
+    if (status != 200) {
+        closeUrl(c);
+        setState(FuState::Error, status == 404 ? "nie znaleziono repozytorium " + cfg.repo + " (musi być publiczne)"
+                                               : (status == 403 ? String("limit zapytań GitHub, spróbuj za godzinę") : "GitHub odpowiedział kodem " + String(status)));
+        return;
+    }
+
+    JsonDocument filter;
+    JsonObject fr = filter.add<JsonObject>();
+    fr["tag_name"] = true;
+    fr["name"] = true;
+    fr["body"] = true;
+    fr["draft"] = true;
+    fr["published_at"] = true;
+    fr["html_url"] = true;
+    JsonObject fa = fr["assets"].add<JsonObject>();
+    fa["name"] = true;
+    fa["size"] = true;
+    fa["browser_download_url"] = true;
+
+    JsonDocument doc;
+    HttpStream st(c);
+    const DeserializationError err = deserializeJson(doc, st, DeserializationOption::Filter(filter), DeserializationOption::NestingLimit(12));
+    closeUrl(c);
+    if (err) {
+        setState(FuState::Error, String("błąd odczytu listy wydań: ") + err.c_str());
+        return;
+    }
+
+    int best = 0;
+    JsonObject rel;
+    for (JsonObject r : doc.as<JsonArray>()) {
+        if (r["draft"] | false) continue;
+        const String tag = r["tag_name"] | "";
+        if (!tag.startsWith(cfg.prefix)) continue;
+        const int v = tag.substring(cfg.prefix.length()).toInt();
+        if (v > best) {
+            // must contain the firmware for this board
+            bool has = false;
+            for (JsonObject a : r["assets"].as<JsonArray>())
+                if (strcmp(a["name"] | "", FUSION_ASSET_NAME) == 0) has = true;
+            if (!has) continue;
+            best = v;
+            rel = r;
+        }
+    }
+
+    std::lock_guard<std::mutex> l(_mutex);
+    time(&_lastCheck);
+    if (best == 0) {
+        _latest = 0;
+        _binUrl = "";
+        _state = FuState::Error;
+        _msg = "brak wydań " + cfg.prefix + "N z plikiem " FUSION_ASSET_NAME;
+        return;
+    }
+    _latest = best;
+    _tag = rel["tag_name"].as<String>();
+    _name = rel["name"] | _tag.c_str();
+    _date = String(rel["published_at"] | "").substring(0, 10);
+    _notes = rel["body"] | "";
+    if (_notes.length() > 3000) _notes = _notes.substring(0, 3000) + "…";
+    _pageUrl = rel["html_url"] | "";
+    _binUrl = "";
+    _shaUrl = "";
+    _binSize = 0;
+    for (JsonObject a : rel["assets"].as<JsonArray>()) {
+        const char* n = a["name"] | "";
+        if (strcmp(n, FUSION_ASSET_NAME) == 0) {
+            _binUrl = a["browser_download_url"].as<String>();
+            _binSize = a["size"] | 0;
+        } else if (strcmp(n, "SHA256SUMS.txt") == 0) {
+            _shaUrl = a["browser_download_url"].as<String>();
+        }
+    }
+    _state = best > FUSION_VERSION ? FuState::Available : FuState::UpToDate;
+    _msg = "";
+    ESP_LOGI(TAG, "FusionUpdate: newest %s (%d), running %d", _tag.c_str(), best, FUSION_VERSION);
+}
+
+bool FusionUpdateClass::fetchSha(const String& url, String& sha)
+{
+    int status = 0;
+    int64_t len = 0;
+    esp_http_client_handle_t c = openUrl(url, status, len, nullptr);
+    if (!c) return false;
+    if (status != 200) {
+        closeUrl(c);
+        return false;
+    }
+    String txt;
+    char b[256];
+    int n;
+    while ((n = esp_http_client_read(c, b, sizeof(b))) > 0 && txt.length() < 8192) txt.concat(b, n);
+    closeUrl(c);
+    // lines: "<64 hex>  <file name>"
+    int p = 0;
+    while (p < (int)txt.length()) {
+        int e = txt.indexOf('\n', p);
+        if (e < 0) e = txt.length();
+        String line = txt.substring(p, e);
+        line.trim();
+        if (line.length() > 66 && line.endsWith(FUSION_ASSET_NAME)) {
+            String name = line.substring(64);
+            name.trim();
+            if (name.startsWith("*")) name.remove(0, 1);
+            if (name == FUSION_ASSET_NAME) {
+                sha = line.substring(0, 64);
+                sha.toLowerCase();
+                return true;
+            }
+        }
+        p = e + 1;
+    }
+    return false;
+}
+
+// ---------------------------------------------------------------- install
+void FusionUpdateClass::doInstall()
+{
+    String binUrl, shaUrl;
+    uint32_t size;
+    {
+        std::lock_guard<std::mutex> l(_mutex);
+        binUrl = _binUrl;
+        shaUrl = _shaUrl;
+        size = _binSize;
+        _done = 0;
+        _total = size;
+    }
+    String want;
+    if (shaUrl.isEmpty() || !fetchSha(shaUrl, want)) {
+        setState(FuState::Error, "brak sumy kontrolnej SHA256SUMS.txt w wydaniu - aktualizacja przerwana");
+        return;
+    }
+
+    const esp_partition_t* part = esp_ota_get_next_update_partition(nullptr);
+    if (!part) {
+        setState(FuState::Error, "brak partycji OTA");
+        return;
+    }
+    int status = 0;
+    int64_t len = 0;
+    esp_http_client_handle_t c = openUrl(binUrl, status, len, "application/octet-stream");
+    if (!c || status != 200) {
+        closeUrl(c);
+        setState(FuState::Error, "nie można pobrać pliku (kod " + String(status) + ")");
+        return;
+    }
+    if (len > 0) size = (uint32_t)len;
+    if (size > part->size) {
+        closeUrl(c);
+        setState(FuState::Error, "plik większy niż partycja OTA");
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> l(_mutex);
+        _total = size;
+    }
+    esp_ota_handle_t ota = 0;
+    if (esp_ota_begin(part, size ? size : OTA_SIZE_UNKNOWN, &ota) != ESP_OK) {
+        closeUrl(c);
+        setState(FuState::Error, "esp_ota_begin nie powiódł się");
+        return;
+    }
+    mbedtls_sha256_context sh;
+    mbedtls_sha256_init(&sh);
+    mbedtls_sha256_starts(&sh, 0);
+    uint8_t* buf = (uint8_t*)malloc(4096);
+    bool ok = buf != nullptr;
+    uint32_t got = 0;
+    while (ok) {
+        const int n = esp_http_client_read(c, (char*)buf, 4096);
+        if (n < 0) {
+            ok = false;
+            break;
+        }
+        if (n == 0) break;
+        mbedtls_sha256_update(&sh, buf, n);
+        if (esp_ota_write(ota, buf, n) != ESP_OK) {
+            ok = false;
+            break;
+        }
+        got += n;
+        std::lock_guard<std::mutex> l(_mutex);
+        _done = got;
+    }
+    free(buf);
+    closeUrl(c);
+    uint8_t dig[32];
+    mbedtls_sha256_finish(&sh, dig);
+    mbedtls_sha256_free(&sh);
+    if (!ok || got == 0 || (size && got != size)) {
+        esp_ota_abort(ota);
+        setState(FuState::Error, "przerwane pobieranie (" + String(got) + " z " + String(size) + " B)");
+        return;
+    }
+    setState(FuState::Verifying, "");
+    char hex[65];
+    for (int i = 0; i < 32; i++) sprintf(hex + 2 * i, "%02x", dig[i]);
+    if (want != hex) {
+        esp_ota_abort(ota);
+        setState(FuState::Error, "suma SHA-256 nie zgadza się - plik odrzucony, obecny firmware bez zmian");
+        return;
+    }
+    if (esp_ota_end(ota) != ESP_OK || esp_ota_set_boot_partition(part) != ESP_OK) {
+        setState(FuState::Error, "zapis/weryfikacja obrazu nie powiodła się");
+        return;
+    }
+    setState(FuState::Done, "zainstalowano, ponowne uruchamianie");
+    ESP_LOGI(TAG, "FusionUpdate: installed, restarting");
+    vTaskDelay(pdMS_TO_TICKS(1500));
+    RestartHelper.triggerRestart();
+}
+
+// ---------------------------------------------------------------- json
+void FusionUpdateClass::toJson(JsonVariant root)
+{
+    std::lock_guard<std::mutex> l(_mutex);
+    root["version"] = FUSION_VERSION;
+    root["tag"] = String(_cfg.prefix) + FUSION_VERSION;
+    root["env"] = PIOENV;
+    root["asset"] = FUSION_ASSET_NAME;
+    root["built"] = __DATE__ " " __TIME__;
+    root["repo"] = _cfg.repo;
+    root["prefix"] = _cfg.prefix;
+    root["auto"] = _cfg.autoCheck;
+    root["state"] = stateName(_state);
+    root["message"] = _msg;
+    root["busy"] = (bool)_busy;
+    root["last_check"] = (uint32_t)_lastCheck;
+    root["available"] = _latest > FUSION_VERSION && !_binUrl.isEmpty();
+    root["done"] = _done;
+    root["total"] = _total;
+    if (_latest > 0) {
+        JsonObject r = root["latest"].to<JsonObject>();
+        r["version"] = _latest;
+        r["tag"] = _tag;
+        r["name"] = _name;
+        r["date"] = _date;
+        r["notes"] = _notes;
+        r["url"] = _pageUrl;
+        r["size"] = _binSize;
+        r["has_sha"] = !_shaUrl.isEmpty();
+    }
+}
