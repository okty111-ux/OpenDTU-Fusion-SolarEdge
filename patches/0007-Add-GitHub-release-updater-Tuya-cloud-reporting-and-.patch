+  $('st').innerHTML=`<span class="pill ${s[1]}">${s[0]}</span>`;$('stT').textContent=t.enabled?t.host+':8883':'';
+  const e=$('err');if(t.enabled&&t.error){e.style.display='';e.textContent=t.error;}else e.style.display='none';
+  let p={};try{p=JSON.parse(t.payload||'{}').data||{};}catch(x){}
+  const v=k=>p[k]?p[k].value:null,W=x=>x==null?'–':x.toLocaleString('pl-PL')+' W';
+  $('kv').innerHTML=[['Wysłane raporty',t.sent],['Potwierdzone',t.acked],['Ostatnia odpowiedź',t.last_code<0?'–':t.last_code+' · '+(CODES[t.last_code]||'błąd')],['Ostatnio przyjęte',t.last_ok>1600000000?new Date(t.last_ok*1000).toLocaleTimeString('pl-PL'):'–'],
+    ['pv_power',W(v('pv_power'))],['grid_power',W(v('grid_power'))],['energy_today',v('energy_today')==null?'–':v('energy_today').toLocaleString('pl-PL')+' Wh'],['energy_total',v('energy_total')==null?'–':v('energy_total').toLocaleString('pl-PL')+' kWh']]
+    .map(([a,b])=>`<div><span>${a}</span><b>${esc(b)}</b></div>`).join('');
+  if(!filled){$('en').checked=t.enabled;$('reg').value=t.region;$('did').value=t.device_id;$('iv').value=t.interval;$('secH').textContent=t.has_secret?'zapisany – zostaw puste, aby nie zmieniać':'wymagany';filled=true;}
+}
+async function load(){try{render(await get('/api/fusion/tuya'));}catch(e){}}
+async function save(){const o={enabled:$('en').checked,region:$('reg').value,device_id:$('did').value.trim(),interval:+$('iv').value||60};if($('sec').value)o.secret=$('sec').value.trim();
+  if(o.enabled&&(!o.device_id))return toast('Podaj Device ID',false);
+  try{await post('/api/fusion/tuya',o);$('sec').value='';filled=false;toast('Zapisano, łączę z Tuya…');setTimeout(load,1500);}catch(e){toast('Błąd: '+e.message,false);}}
+async function test(){try{await post('/api/fusion/tuya/test');toast('Raport w kolejce');setTimeout(load,2500);}catch(e){toast('Błąd: '+e.message,false);}}
+setInterval(()=>{$('now').textContent=new Date().toLocaleTimeString('pl-PL',{hour:'2-digit',minute:'2-digit'})},1000);
+load();setInterval(load,5000);
