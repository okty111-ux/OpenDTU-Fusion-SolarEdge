diff --git a/include/FusionTuya.h b/include/FusionTuya.h
new file mode 100644
index 0000000..3f3fcaf
--- /dev/null
+++ b/include/FusionTuya.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Sends production data to the Tuya cloud (TuyaLink MQTT, Tuya Developer
+ * Platform).  The device is created on the platform as a TuyaLink product
+ * with the properties listed in FusionTuya.cpp; deviceId + deviceSecret of
+ * the registered device are entered on /fusion/tuya.
+ */
+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <TaskSchedulerDeclarations.h>
+#include <mutex>
+
+struct FusionTuyaConfig {
+    bool enabled = false;
+    String region = "eu"; // eu, eu-w, us, us-e, cn, in
+    String deviceId;
+    String secret;
+    uint16_t interval = 60; // s
+};
+
+class FusionTuyaClass {
+public:
+    void init(Scheduler& scheduler);
+    FusionTuyaConfig getConfig();
+    bool setConfig(const FusionTuyaConfig& c, bool keepSecret);
+    void statusToJson(JsonVariant root);
+    void reportNow() { _forceReport = true; }
+
+    // called from the MQTT task
+    void onEvent(int32_t id, void* data);
+
+private:
+    void loop();
+    void connect();
+    void disconnect();
+    void report();
+    void load();
+    static String host(const String& region);
+
+    std::mutex _mutex;
+    FusionTuyaConfig _cfg;
+    void* _client = nullptr;
+    volatile bool _connected = false;
+    volatile bool _forceReport = false;
+    bool _restart = false;
+    uint32_t _lastTry = 0, _lastReport = 0, _retry = 5000;
+    uint32_t _sent = 0, _acked = 0;
+    int _lastCode = -1;
+    String _lastErr, _lastPayload;
+    time_t _lastOk = 0;
+    String _topicReport, _topicResp;
+    Task _loopTask;
+};
+
+extern FusionTuyaClass FusionTuya;
diff --git a/include/FusionUpdate.h b/include/FusionUpdate.h
new file mode 100644
index 0000000..fe92aeb
--- /dev/null
+++ b/include/FusionUpdate.h
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * "Aktualizacja z GitHuba" - firmware update straight from GitHub releases.
+ *
+ * Releases of the configured repository are tagged "<prefix><N>" (default
+ * "fusion-v<N>").  The device lists the releases through the GitHub API, picks
+ * the highest N, downloads asset "fusion-<pioenv>.bin", checks its SHA-256
+ * against SHA256SUMS.txt from the same release and writes it to the inactive
+ * OTA partition.  Only after a successful verification the boot partition is
+ * switched and the device restarts.
+ */
+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <TaskSchedulerDeclarations.h>
+#include <mutex>
+
+struct FusionUpdateConfig {
+    String repo;
+    String prefix;
+    bool autoCheck = true;
+};
+
+enum class FuState : uint8_t { Idle, Checking, UpToDate, Available, Downloading, Verifying, Done, Error };
+
+class FusionUpdateClass {
+public:
+    void init(Scheduler& scheduler);
+    void toJson(JsonVariant root);
+    FusionUpdateConfig getConfig();
+    bool setConfig(const FusionUpdateConfig& c);
+    bool requestCheck();   // async
+    bool requestInstall(); // async, requires a found release
+    bool updateAvailable();
+
+private:
+    void loop();
+    static void taskEntry(void* arg);
+    void doCheck();
+    void doInstall();
+    bool fetchSha(const String& url, String& sha);
+    void setState(FuState s, const String& msg = "");
+    void loadConfig();
+
+    std::mutex _mutex;
+    FusionUpdateConfig _cfg;
+    FuState _state = FuState::Idle;
+    String _msg;
+    // newest release found
+    int _latest = 0;
+    String _tag, _name, _date, _notes, _binUrl, _shaUrl, _pageUrl;
+    uint32_t _binSize = 0;
+    uint32_t _done = 0, _total = 0;
+    time_t _lastCheck = 0;
+    uint32_t _bootMs = 0, _lastCheckMs = 0;
+    bool _checkedOnce = false;
+    volatile bool _busy = false;
+    uint8_t _job = 0; // 1 = check, 2 = install
+    Task _loopTask;
+};
+
+extern FusionUpdateClass FusionUpdate;
diff --git a/include/FusionVersion.h b/include/FusionVersion.h
new file mode 100644
index 0000000..9c76fc8
--- /dev/null
+++ b/include/FusionVersion.h
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Fusion firmware version. Every GitHub release is tagged FUSION_TAG_PREFIX + FUSION_VERSION
+// (e.g. "fusion-v2") and the device compares this integer to the newest release.
+#pragma once
+
+#ifndef FUSION_VERSION
+#define FUSION_VERSION 2
+#endif
+#ifndef FUSION_TAG_PREFIX
+#define FUSION_TAG_PREFIX "fusion-v"
+#endif
+#ifndef FUSION_UPDATE_REPO
+#define FUSION_UPDATE_REPO "okty111-ux/OpenDTU-Fusion-SolarEdge"
+#endif
+#ifndef PIOENV
+#define PIOENV "opendtufusionv2"
+#endif
+// firmware asset name inside a release: fusion-<pio env>.bin
+#define FUSION_ASSET_NAME "fusion-" PIOENV ".bin"
